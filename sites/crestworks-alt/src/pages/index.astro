---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
const base = import.meta.env.BASE_URL ?? '';
---

<Layout title="Home" description="Boutique consulting specialized in new & future technologies. Crestworks — Tomorrowing Today.">
  <Nav />

  <!-- ── Hero ──────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-bg">
      <img src={`${base}/images/hero.jpeg`} alt="" aria-hidden="true" />
    </div>
    <div class="hero-overlay"></div>
    <div class="hero-content container">
      <h1 class="hero-headline">TOMORROWING TODAY.</h1>
      <p class="hero-sub">Boutique consulting specialized in new &amp; future technologies.</p>
      <a href="mailto:hello@crestworks.co" class="btn-primary">GET IN TOUCH</a>
    </div>
  </section>

  <!-- ── ABOUT ─────────────────────────────────────────────── -->
  <section class="section" id="about">
    <div class="container">
      <h2 class="section-heading">ABOUT</h2>
      <p class="section-body">
        Crestworks is a Boutique Consulting Company specialized in new &amp; future technologies
        based in Munich, Germany. We bridge the gap between initial ideas, prototype, and execution
        in the shortest possible time.
      </p>
    </div>
  </section>

  <!-- ── OUR MISSION IS: ───────────────────────────────────── -->
  <section class="section section-mission" id="mission">
    <div class="container">
      <div class="mission-inner">
        <img src={`${base}/images/mission-icon.png`} alt="" aria-hidden="true" class="mission-icon" />
        <div>
          <h2 class="section-heading">OUR MISSION IS:</h2>
          <p class="section-body">
            To deliver what has never been built before! <strong>#TomorrowingToday</strong>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── WE ARE SPECIALIZED IN: ───────────────────────────── -->
  <section class="section section-specialized" id="specialized">
    <div class="container">
      <h2 class="section-heading">WE ARE SPECIALIZED IN:</h2>
      <div class="spec-grid">
        <div class="spec-card">
          <h3 class="spec-title">Building the Future</h3>
          <p class="spec-body">
            Use-case exploration, feasibility assessment, and turning visionary ideas into actionable roadmaps.
          </p>
        </div>
        <div class="spec-card">
          <h3 class="spec-title">More than just Tech</h3>
          <p class="spec-body">
            We address the managerial, organizational, and strategic dimensions that determine whether innovations succeed.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── WHERE WE COME FROM: ──────────────────────────────── -->
  <section class="section section-origin">
    <div class="section-bg-img">
      <img src={`${base}/images/bg1.jpg`} alt="" aria-hidden="true" />
    </div>
    <div class="section-overlay"></div>
    <div class="container section-content-overlay">
      <h2 class="section-heading light">WHERE WE COME FROM:</h2>
      <p class="section-body light">
        From Labs to Assembly Lines. From Ground to Space. And everything in between.
      </p>
      <p class="section-industries">
        Aerospace. Defense. Life Sciences. Process Industries.
      </p>
      <a href="mailto:hello@crestworks.co" class="btn-ghost-light">FOR MORE INFORMATION</a>
    </div>
  </section>

  <!-- ── OUR OFFERING: ────────────────────────────────────── -->
  <section class="section section-offering">
    <div class="section-bg-img">
      <img src={`${base}/images/bg2.jpg`} alt="" aria-hidden="true" />
    </div>
    <div class="section-overlay"></div>
    <div class="container section-content-overlay">
      <h2 class="section-heading light">OUR OFFERING:</h2>
      <p class="offering-tagline">Innovation is born from: <em>Stardust + Sweat</em></p>
      <p class="section-body light">
        We convert vision into tangible assets. From concept to prototype, strategy to execution —
        we build what hasn't been built before.
      </p>
      <a href={`${base}/services`} class="btn-primary">VIEW SERVICES</a>
    </div>
  </section>

  <!-- ── HOW WE ROLL: ──────────────────────────────────────── -->
  <section class="section section-roll" id="how-we-roll">
    <div class="container">
      <h2 class="section-heading">HOW WE ROLL:</h2>
      <p class="section-body">
        We support startups and enterprises at every stage of the project lifecycle, combining
        optimism and practicality with rigorously executed action.
      </p>
    </div>
  </section>

  <!-- ── LET'S GO! ─────────────────────────────────────────── -->
  <section class="section-cta">
    <div class="container">
      <h2 class="cta-heading">LET'S GO!</h2>
      <p class="cta-body">The future can't wait. Let's build it together NOW!</p>
      <a href="mailto:hello@crestworks.co" class="btn-dark">GET IN TOUCH</a>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute; inset: 0;
    overflow: hidden;
  }
  .hero-bg img {
    width: 100%; height: 100%;
    object-fit: cover; object-position: center;
  }
  .hero-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(10,12,16,0.55) 0%,
      rgba(10,12,16,0.70) 60%,
      rgba(10,12,16,0.92) 100%
    );
  }
  .hero-content {
    position: relative; z-index: 1;
    padding-top: 8rem; padding-bottom: 6rem;
  }
  .hero-headline {
    font-family: var(--font-head);
    font-size: clamp(3rem, 8vw, 7rem);
    font-weight: 800; line-height: 1.0;
    letter-spacing: .02em;
    color: var(--text);
    margin-bottom: 1.5rem;
  }
  .hero-sub {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--text-muted);
    max-width: 52ch;
    margin-bottom: 2.5rem;
    line-height: 1.65;
  }

  /* ── Buttons ── */
  .btn-primary {
    display: inline-flex; align-items: center;
    padding: .9rem 2.25rem;
    background: var(--accent); color: #000;
    font-family: var(--font-head); font-size: .9375rem; font-weight: 700;
    letter-spacing: .06em; text-transform: uppercase;
    border-radius: var(--radius);
    transition: background .2s;
  }
  .btn-primary:hover { background: var(--accent-dark); }

  .btn-ghost-light {
    display: inline-flex; align-items: center;
    padding: .9rem 2.25rem;
    border: 2px solid rgba(240,242,250,0.6);
    color: var(--text);
    font-family: var(--font-head); font-size: .9375rem; font-weight: 700;
    letter-spacing: .06em; text-transform: uppercase;
    border-radius: var(--radius);
    transition: border-color .2s, color .2s;
  }
  .btn-ghost-light:hover { border-color: var(--accent); color: var(--accent); }

  .btn-dark {
    display: inline-flex; align-items: center;
    padding: .9rem 2.25rem;
    background: #0a0c10; color: #0a0c10;
    background: #000; color: #000;
    font-family: var(--font-head); font-size: .9375rem; font-weight: 700;
    letter-spacing: .06em; text-transform: uppercase;
    border-radius: var(--radius);
    transition: opacity .2s;
    border: 2px solid #000;
  }
  .btn-dark:hover { opacity: .75; }

  /* ── Sections ── */
  .section { padding: 6rem 0; }

  .section-heading {
    font-family: var(--font-head);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 800;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--text);
    margin-bottom: 1.5rem;
  }
  .section-heading.light { color: #fff; }

  .section-body {
    font-size: 1.125rem;
    color: var(--text-muted);
    max-width: 65ch;
    line-height: 1.75;
  }
  .section-body.light { color: rgba(240,242,250,0.85); }

  /* ── Mission ── */
  .section-mission { background: var(--bg-card); }
  .mission-inner {
    display: flex; align-items: flex-start; gap: 2.5rem;
  }
  .mission-icon { width: 64px; height: 64px; object-fit: contain; flex-shrink: 0; margin-top: .25rem; }

  /* ── Specialized ── */
  .section-specialized { background: var(--bg); }
  .spec-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem;
    margin-top: 2.5rem;
  }
  .spec-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius);
    padding: 2rem;
  }
  .spec-title {
    font-family: var(--font-head);
    font-size: 1.125rem; font-weight: 700;
    color: var(--accent); margin-bottom: .75rem;
    text-transform: uppercase; letter-spacing: .04em;
  }
  .spec-body { color: var(--text-muted); line-height: 1.75; }

  /* ── Sections with full-bleed bg image ── */
  .section-origin,
  .section-offering {
    position: relative;
    padding: 7rem 0;
    overflow: hidden;
  }
  .section-bg-img {
    position: absolute; inset: 0;
    overflow: hidden;
  }
  .section-bg-img img {
    width: 100%; height: 100%;
    object-fit: cover; object-position: center;
  }
  .section-overlay {
    position: absolute; inset: 0;
    background: rgba(10,12,16,0.72);
  }
  .section-content-overlay {
    position: relative; z-index: 1;
  }

  /* ── Origin extras ── */
  .section-industries {
    font-family: var(--font-head);
    font-size: 1rem; font-weight: 600;
    letter-spacing: .1em; text-transform: uppercase;
    color: var(--accent);
    margin-top: 1.25rem; margin-bottom: 2.5rem;
  }

  /* ── Offering extras ── */
  .offering-tagline {
    font-family: var(--font-head);
    font-size: 1.25rem; font-weight: 600;
    color: var(--accent);
    margin-bottom: 1.25rem;
  }
  .offering-tagline em { font-style: normal; }
  .section-offering .section-body { margin-bottom: 2.5rem; }

  /* ── How We Roll ── */
  .section-roll { background: var(--bg-card); }

  /* ── LET'S GO CTA ── */
  .section-cta {
    background: var(--accent);
    padding: 6rem 0;
    text-align: center;
  }
  .cta-heading {
    font-family: var(--font-head);
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 800;
    letter-spacing: .06em;
    color: #000;
    margin-bottom: 1rem;
  }
  .cta-body {
    font-size: 1.125rem;
    color: rgba(0,0,0,0.75);
    margin-bottom: 2.5rem;
    max-width: 52ch;
    margin-left: auto; margin-right: auto;
    line-height: 1.65;
  }

  @media (max-width: 640px) {
    .mission-inner { flex-direction: column; gap: 1.5rem; }
    .mission-icon { width: 48px; height: 48px; }
  }
</style>
