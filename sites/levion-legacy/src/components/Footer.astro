---
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
const siteName = 'Levion Materials';
---

<footer class="footer">
  <div class="container footer-inner">

    <!-- Brand + nav -->
    <div class="footer-brand">
      <a href={`${b}/`} aria-label="Levion Materials home">
        <img src={`${b}/images/logo-color.png`} alt="Levion Materials" class="footer-logo" />
      </a>
      <nav class="footer-nav" aria-label="Footer navigation">
        <a href={`${b}/imprint`}>Imprint</a>
        <a href={`${b}/contact`}>Contact</a>
        <a href={`${b}/privacy-policy`}>Privacy Policy</a>
      </nav>
    </div>

    <!-- Newsletter -->
    <div class="footer-newsletter">
      <p class="nl-heading">NEWSLETTER</p>
      <p class="nl-desc">Subscribe for the Levion newsletter.</p>
      <form class="nl-form" action="https://formspree.io/f/placeholder" method="POST">
        <label for="footer-nl-email" class="nl-field-label">E-Mail address</label>
        <input type="email" id="footer-nl-email" name="email" required />
        <button type="submit">Subscribe</button>
      </form>
    </div>

  </div>
</footer>

<style>
  .footer {
    background: var(--bg);
    border-top: 1px solid var(--border);
    padding: 3.5rem 0 2.5rem;
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  /* ── Brand ── */
  .footer-logo {
    display: block;
    height: 52px; width: auto;
    object-fit: contain;
    margin-bottom: 1.5rem;
  }
  .footer-nav { display: flex; flex-direction: column; gap: .5rem; }
  .footer-nav a {
    font-size: .8125rem; font-weight: 500;
    letter-spacing: .06em; text-transform: uppercase;
    color: var(--text-muted); transition: color .2s;
  }
  .footer-nav a:hover { color: var(--orange); }

  /* ── Newsletter ── */
  .nl-heading {
    font-family: var(--font-head); font-size: .8125rem; font-weight: 700;
    letter-spacing: .12em; text-transform: uppercase;
    color: var(--text); margin-bottom: .4rem;
  }
  .nl-desc { font-size: .9375rem; color: var(--text-muted); margin-bottom: 1.25rem; line-height: 1.5; }
  .nl-form { display: flex; flex-direction: column; gap: .4rem; max-width: 380px; }
  .nl-field-label { font-size: .8125rem; color: var(--text-muted); }
  .nl-form input {
    padding: .7rem 1rem;
    border: 1px solid var(--border); border-radius: 4px;
    background: var(--bg); color: var(--text);
    font-size: .9375rem; width: 100%;
    transition: border-color .2s;
  }
  .nl-form input:focus { outline: 2px solid var(--teal); border-color: var(--teal); }
  .nl-form button {
    align-self: flex-start;
    margin-top: .35rem;
    padding: .75rem 2.25rem;
    background: var(--teal); color: #fff;
    border: none; border-radius: 4px;
    font-family: var(--font-head); font-size: .9375rem; font-weight: 600;
    cursor: pointer; transition: opacity .2s;
  }
  .nl-form button:hover { opacity: .85; }

  @media (max-width: 640px) {
    .footer-inner { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
