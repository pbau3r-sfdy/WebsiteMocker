---
import TypeBadge from './TypeBadge.astro';

export interface Props {
  id:          string;
  title:       string;
  date:        Date;
  type:        'full-time' | 'part-time' | 'contract';
  department?: string;
  location:    string;
}

const { id, title, date, type, department, location } = Astro.props;
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const stamp = date.toLocaleDateString('en-GB', {
  day: '2-digit', month: 'short', year: 'numeric',
}).toUpperCase();
---

<a href={`${b}/jobs/${id}`} class="row">
  <div class="meta">
    <time class="mono date" datetime={date.toISOString().split('T')[0]}>{stamp}</time>
    <TypeBadge type={type} />
  </div>
  <div class="info">
    <h2>{title}</h2>
    <p class="dept-loc">{department && `${department} · `}{location}</p>
  </div>
</a>

<style>
  .row {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 24px;
    padding: 36px 0;
    border-bottom: 1px solid var(--border-subtle);
    text-decoration: none;
    color: inherit;
    transition: border-bottom-color 200ms cubic-bezier(.2,.6,.2,1);
  }
  .row:hover {
    border-bottom-color: var(--border-accent);
    background: rgba(255,255,255,.04);
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .mono {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: var(--ls-eyebrow, .34em);
  }
  .date { color: var(--accent); }

  .info h2 {
    font-family: var(--font-display);
    font-size: clamp(1.0625rem, 2vw, 1.5rem);
    font-weight: 700;
    line-height: 1.24;
    color: var(--text-primary);
    margin-bottom: 6px;
  }
  .dept-loc {
    font-size: clamp(1.0625rem, 2vw, 1.5rem);
    font-weight: 300;
    color: var(--text-soft);
    line-height: 1.55;
  }

  @media (max-width: 680px) {
    .row { grid-template-columns: 1fr; gap: 12px; }
  }
</style>
