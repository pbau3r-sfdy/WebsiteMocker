---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const services = [
  {
    title: 'Idea Assessment',
    body: 'Evaluating concept feasibility and planning. We help you stress-test your idea before investing time and resources.',
  },
  {
    title: 'Concept to Prototype',
    body: 'Converting initial ideas into actionable prototypes. We turn sketches and visions into tangible, testable artifacts.',
  },
  {
    title: 'User-Centric Design',
    body: 'Discovering user needs and defining key characteristics. Human-centered thinking at every stage of the process.',
  },
  {
    title: 'Strategic Roadmaps',
    body: 'Designing implementation paths for complex projects. Clear milestones, priorities, and decision frameworks.',
  },
  {
    title: 'Business Setup',
    body: 'Handling legal, financial, and technical establishment aspects. From entity formation to operational readiness.',
  },
  {
    title: 'Expert Support',
    body: 'Bridging knowledge gaps and providing solutions. Specialist expertise delivered exactly where and when you need it.',
  },
  {
    title: 'Hands-On Management',
    body: 'Leading projects toward successful completion. We roll up our sleeves and drive execution alongside your team.',
  },
];
---

<Layout title="Services" description="Crestworks consulting services — from idea assessment to hands-on project management.">
  <Nav />

  <main class="main">
    <!-- ── Header ── -->
    <section class="services-header">
      <div class="container">
        <h1 class="page-heading">OUR SERVICES</h1>
        <p class="page-tagline">Innovation is born from: <em>Stardust + Sweat</em></p>
      </div>
    </section>

    <!-- ── Services Grid ── -->
    <section class="services-grid-section">
      <div class="container">
        <div class="services-grid">
          {services.map((s, i) => (
            <div class="service-card">
              <span class="service-num">0{i + 1}</span>
              <h2 class="service-title">{s.title}</h2>
              <p class="service-body">{s.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── CTA ── -->
    <section class="services-cta">
      <div class="container">
        <p class="cta-text">Ready to start something new?</p>
        <a href="mailto:hello@crestworks.co" class="btn-primary">GET IN TOUCH</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .main { padding-top: 64px; }

  /* ── Header ── */
  .services-header {
    padding: 5rem 0 3rem;
    background: #ffffff;
    border-bottom: 1px solid var(--border);
  }
  .page-heading {
    font-family: 'Avenir Next', var(--font-head), system-ui, sans-serif;
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 800;
    letter-spacing: .06em;
    color: #0a0a0a;
    margin-bottom: .75rem;
  }
  .page-tagline {
    font-family: var(--font-head);
    font-size: 1.125rem; font-weight: 600;
    color: var(--accent);
  }
  .page-tagline em { font-style: normal; }

  /* ── Grid ── */
  .services-grid-section { padding: 4rem 0 5rem; background: #ffffff; }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .service-card {
    background: #ffffff;
    border: 1px solid var(--border);
    border-left: 4px solid transparent;
    border-radius: var(--radius);
    padding: 2rem;
    transition: border-left-color .2s;
  }
  .service-card:hover { border-left-color: var(--accent); }

  .service-num {
    display: block;
    font-family: var(--font-head);
    font-size: .75rem; font-weight: 700;
    letter-spacing: .12em; text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
  }
  .service-title {
    font-family: var(--font-head);
    font-size: 1.125rem; font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .04em;
    color: #0a0a0a;
    margin-bottom: .75rem;
  }
  .service-body {
    font-size: .9375rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  /* ── CTA ── */
  .services-cta {
    padding: 5rem 0;
    background: #0a0a0a;
    border-top: 1px solid #1a1a1a;
    text-align: center;
  }
  .cta-text {
    font-family: var(--font-head);
    font-size: 1.25rem; font-weight: 600;
    color: rgba(255,255,255,0.65);
    margin-bottom: 1.75rem;
  }
  .btn-primary {
    display: inline-flex; align-items: center;
    padding: .9rem 2.25rem;
    background: var(--accent); color: #0a0a0a;
    font-family: var(--font-head); font-size: .9375rem; font-weight: 700;
    letter-spacing: .06em; text-transform: uppercase;
    border-radius: var(--radius);
    transition: opacity .2s;
  }
  .btn-primary:hover { opacity: .85; }

  @media (max-width: 900px) {
    .services-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 600px) {
    .services-grid { grid-template-columns: 1fr; }
  }
</style>
