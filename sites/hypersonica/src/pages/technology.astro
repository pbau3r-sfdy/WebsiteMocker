---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const pillars = [
  { title: 'High-fidelity simulation software', body: 'Our simulation backbone enables an industry-leading development pace, high output quality and rapid optimisation across the design space.' },
  { title: 'Top-tier talent', body: 'We are building Europe\'s most expert hypersonics team, united by the mission to deliver high-end, cost-effective products at speed.' },
  { title: 'Built for scale and delivery', body: 'From day one, our platforms are engineered for manufacturability, modularity and integration. A unified digital thread links design, testing, verification and production.' },
];
---
<Layout title="Technology">
  <Nav theme="dark" />
  <div class="page-black">
    <PageHeader theme="dark" title="Technology" subtitle="We move from concept to flight in months, not years" />

    <!-- Iterating at speed -->
    <section class="section">
      <div class="container">
        <p class="eyebrow">Iterating at speed</p>
        <p class="body-lg">Our approach enables deliberate, measurable and repeatable performance gains whilst maintaining aerospace-grade quality and reliability.</p>
      </div>
      <!-- Vehicle visual -->
      <div class="vehicle-wrap">
        <img src="https://www.hypersonica.com/sequence/desktop/00000.webp" alt="Hypersonica vehicle" class="vehicle-img" />
        <div class="vehicle-labels">
          <span class="v-label" style="top:38%;left:8%">Range</span>
          <span class="v-label" style="top:52%;left:8%">Cost</span>
          <span class="v-label" style="top:66%;left:8%">Manoeuvrability</span>
        </div>
      </div>
    </section>

    <!-- Distinct domain -->
    <section class="section">
      <div class="container two-col">
        <div>
          <p class="eyebrow">Hypersonics: a distinct domain</p>
          <p class="body-md">At speeds beyond Mach 5, extreme aerodynamic heating renders conventional aerospace technologies obsolete. These regimes require state-of-the-art materials, control architectures and avionic components to ensure stable and manoeuvrable hypersonic flight.</p>
          <p class="body-md" style="margin-top:1rem;">Hypersonica was founded to address these challenges and establish the capability to rapidly design, test and field systems that perform reliably under such extreme conditions.</p>
        </div>
        <div>
          <img src="https://hs-website-images.s3.fr-par.scw.cloud/DSCF_6481_c4a11382b2.webp" alt="Hypersonica lab" class="section-img" />
        </div>
      </div>
    </section>

    <!-- Pillars -->
    <section class="section">
      <div class="container">
        <p class="eyebrow">Pillars of our approach</p>
        <div class="pillars-grid">
          {pillars.map(p => (
            <div class="pillar">
              <h3 class="pillar-title">{p.title}</h3>
              <p class="pillar-body">{p.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Closing -->
    <section class="section closing-section">
      <div class="container two-col">
        <div>
          <p class="closing-headline">Our technology is designed for production, not demonstration.</p>
          <p class="body-md" style="margin-top:1.5rem;">Learning compounds with each iteration, costs remain controlled and capability advances predictably — scaling into a reliable and cost-effective defence capability.</p>
          <a href={`${b}/careers`} class="btn-blue" style="margin-top:2rem; display:inline-block;">See all open positions →</a>
        </div>
        <div>
          <img src="https://hs-website-images.s3.fr-par.scw.cloud/DSCF_5919_2b5e0f2dba.webp" alt="Hypersonica production" class="section-img" />
        </div>
      </div>
    </section>

    <Footer theme="dark" />
  </div>
</Layout>
<style>
  .page-black { background: #000; color: var(--text); }
  .container { max-width: 1200px; margin: 0 auto; padding: 0 2rem; }
  .section { padding: 5rem 0; border-top: 1px solid rgba(229,229,229,0.1); }
  .eyebrow { font-size: .75rem; font-weight: 500; letter-spacing: .12em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 1.5rem; }
  .body-lg { font-size: 1.25rem; font-weight: 300; color: var(--text); max-width: 65ch; line-height: 1.5; }
  .body-md { font-size: 1rem; color: var(--text-muted); line-height: 1.75; max-width: 55ch; }
  .section-img { width: 100%; aspect-ratio: 4/3; object-fit: cover; }
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center; }
  @media (max-width: 900px) { .two-col { grid-template-columns: 1fr; gap: 2.5rem; } }

  .vehicle-wrap { position: relative; margin-top: 3rem; background: linear-gradient(to bottom, #000 0%, #0a0a2e 50%, #000 100%); overflow: hidden; }
  .vehicle-img { width: 70%; margin: 0 auto; display: block; max-height: 420px; object-fit: contain; }
  .vehicle-labels { position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; }
  .v-label { position: absolute; font-size: .6875rem; color: var(--text-muted); letter-spacing: .08em; text-transform: uppercase; }
  .v-label::before { content: '•'; margin-right: .4rem; color: var(--blue); }

  .pillars-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 0; border-top: 1px solid rgba(229,229,229,0.1); margin-top: 2rem; }
  .pillar { padding: 2.5rem 2rem 2.5rem 0; border-right: 1px solid rgba(229,229,229,0.1); }
  .pillar:last-child { border-right: none; padding-right: 0; padding-left: 2rem; }
  .pillar:nth-child(2) { padding-left: 2rem; }
  .pillar-title { font-size: .9375rem; font-weight: 500; color: var(--text); margin-bottom: .75rem; }
  .pillar-body { font-size: .875rem; color: var(--text-muted); line-height: 1.7; }
  @media (max-width: 768px) { .pillars-grid { grid-template-columns: 1fr; } .pillar { border-right: none !important; border-bottom: 1px solid rgba(229,229,229,0.1); padding: 2rem 0 !important; } }

  .closing-headline { font-size: clamp(1.25rem, 2.5vw, 1.875rem); font-weight: 300; color: var(--text); line-height: 1.3; }
  .btn-blue { display: inline-block; background: var(--blue); color: #fff; padding: .75rem 1.5rem; border-radius: var(--radius); font-size: .875rem; font-weight: 400; transition: opacity .2s; }
  .btn-blue:hover { opacity: .85; }
</style>
