---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PageHeader from '../components/PageHeader.astro';
---
<Layout title="Imprint & Privacy Policy">
  <Nav theme="dark" />
  <div class="page-dark">
    <PageHeader theme="dark" title="Imprint & Privacy Policy" />
    <section class="section">
      <div class="container">
        <h2>Hypersonica GmbH</h2>
        <p>Munich, Germany</p>
        <p style="margin-top:1rem;">Contact: <a href="mailto:contact@hypersonica.space">contact@hypersonica.space</a></p>
        <p style="margin-top:2rem; color:var(--text-muted); font-size:.875rem;">© 2026 Hypersonica GmbH. All rights reserved.</p>
      </div>
    </section>
    <Footer theme="dark" />
  </div>
</Layout>
<style>
  .page-dark { background: var(--dark); }
  .container { max-width: 760px; margin: 0 auto; padding: 0 2rem; }
  .section { padding: 3rem 0 8rem; }
  h2 { font-size: 1.25rem; font-weight: 500; color: var(--text); margin-bottom: .5rem; }
  p { font-size: 1rem; color: var(--text-muted); line-height: 1.7; }
  a { color: var(--text); text-decoration: underline; }
</style>
