---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout>
  <div class="shell">
    <div class="stars stars-a"></div>
    <div class="stars stars-b"></div>
    <div class="glow"></div>
    <div class="beam"></div>

    <main>
      <img src={`${b}/images/emblem.png`} alt="MOGWAI programme emblem" class="emblem" />

      <div class="wordmark">
        <h1>UNDER CONSTRUCTION</h1>
        <p class="standby">STANDING BY</p>
      </div>

      <a href="mailto:hive@mogwai-systems.com" class="mail">HIVE@MOGWAI-SYSTEMS.COM</a>
    </main>

    <Footer />
  </div>
</Layout>

<style define:vars={{ stars1: "radial-gradient(1.4px 1.4px at 12% 18%,rgba(255,255,255,.9),transparent),radial-gradient(1.1px 1.1px at 34% 8%,rgba(255,255,255,.7),transparent),radial-gradient(1.6px 1.6px at 61% 24%,rgba(255,255,255,.85),transparent),radial-gradient(1px 1px at 82% 12%,rgba(255,255,255,.6),transparent),radial-gradient(1.3px 1.3px at 7% 52%,rgba(255,255,255,.75),transparent),radial-gradient(1px 1px at 27% 68%,rgba(255,255,255,.55),transparent),radial-gradient(1.7px 1.7px at 48% 44%,rgba(255,255,255,.9),transparent),radial-gradient(1.1px 1.1px at 72% 61%,rgba(255,255,255,.65),transparent),radial-gradient(1.4px 1.4px at 91% 47%,rgba(255,255,255,.8),transparent),radial-gradient(1px 1px at 18% 88%,rgba(255,255,255,.6),transparent),radial-gradient(1.5px 1.5px at 56% 92%,rgba(255,255,255,.75),transparent),radial-gradient(1.2px 1.2px at 86% 82%,rgba(255,255,255,.7),transparent),radial-gradient(1px 1px at 40% 76%,rgba(255,255,255,.5),transparent),radial-gradient(1.1px 1.1px at 66% 34%,rgba(255,255,255,.6),transparent)", stars2: "radial-gradient(.9px .9px at 22% 30%,rgba(200,220,255,.5),transparent),radial-gradient(.8px .8px at 44% 14%,rgba(200,220,255,.4),transparent),radial-gradient(1px 1px at 78% 38%,rgba(200,220,255,.45),transparent),radial-gradient(.9px .9px at 15% 72%,rgba(200,220,255,.4),transparent),radial-gradient(.8px .8px at 63% 80%,rgba(200,220,255,.35),transparent),radial-gradient(1px 1px at 95% 66%,rgba(200,220,255,.4),transparent)" }}>
  .shell {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .stars { position: absolute; inset: -100px; }
  .stars-a { background-image: var(--stars1); animation: twinkle 6s ease-in-out infinite; }
  .stars-b { background-image: var(--stars2); animation: twinkle 9s ease-in-out infinite reverse; }

  .glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 90% at 50% 45%, rgba(4,50,255,0.10) 0%, rgba(0,0,0,0) 60%);
  }

  main {
    position: relative;
    z-index: 2;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(2.5rem, 6vh, 4.5rem);
    padding: clamp(5rem, 14vh, 9rem) clamp(1.5rem, 6vw, 5rem);
    text-align: center;
  }

  .emblem { width: clamp(220px, 26vw, 360px); height: auto; }

  .wordmark {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(1.5rem, 4vh, 2.5rem);
  }

  h1 {
    font-size: clamp(2.2rem, 7vw, 5.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .standby {
    font-family: var(--font-head);
    font-size: clamp(1.6rem, 4.5vw, 3.25rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--accent);
    padding-left: 0.28em;
  }

  .status { display: flex; align-items: center; gap: 0.7rem; }
  .dot {
    display: block;
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--accent);
    animation: blink 2.4s ease-in-out infinite;
  }
  .status-text {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    color: var(--text-muted);
  }

  .mail-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
  }

  .mail {
    display: inline-flex;
    align-items: center;
    background: var(--accent);
    color: #000;
    border-radius: var(--radius);
    padding: 0.9rem 1.8rem;
    font-family: var(--font-head);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    transition: filter 160ms cubic-bezier(.2,.6,.2,1);
  }
  .mail:hover { color: #000; filter: brightness(1.1); }

  .mail-secondary {
    background: transparent;
    color: var(--accent);
    border: 1px solid var(--accent);
  }
  .mail-secondary:hover { color: var(--accent); filter: brightness(1.15); }

  @keyframes blink { 0%, 45% { opacity: 1 } 55%, 100% { opacity: .15 } }
  @keyframes twinkle { 0%, 100% { opacity: .35 } 50% { opacity: .9 } }

  @media (prefers-reduced-motion: reduce) {
    .stars, .dot { animation: none; }
  }

  @media (max-width: 600px) {
    .mail { font-size: 0.6rem; letter-spacing: 0.1em; padding: 0.8rem 1.1rem; }
  }
</style>
