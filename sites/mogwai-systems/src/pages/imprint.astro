<style>
  .shell { position: relative; min-height: 100vh; display: flex; flex-direction: column; }

  main {
    flex: 1;
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding: 5rem 2rem 6rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  h1 { font-size: clamp(2rem, 5vw, 3rem); font-weight: 700; letter-spacing: -0.02em; }

  .content { display: flex; flex-direction: column; gap: 1rem; line-height: 1.75; }
  .content h2 {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--text);
    margin-top: 1.5rem;
  }
  .content p, .content li { color: var(--text-muted); font-size: 0.95rem; }
  .content ul { padding-left: 1.5rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .content strong { color: var(--text); font-weight: 700; }
  .content a { color: var(--accent); }
  .content a:hover { text-decoration: underline; }
</style>
