---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';

const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('news')).sort((a, z) => z.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="News" description="Announcements and programme updates from MOGWAI Systems.">
  <main>
    <header>
      <div class="wrap head">
        <div class="eyebrow">NEWSROOM</div>
        <h1>News <span class="green">&amp; announcements</span></h1>
      </div>
    </header>

    <div class="list">
      {posts.length === 0 ? (
        <p class="empty">No news yet.</p>
      ) : (
        posts.map(post => {
          const stamp = post.data.date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).toUpperCase();
          return (
            <a href={`${b}/news/${post.id}`} class="row">
              <div class="thumb">
                {post.data.image && <img src={`${b}${post.data.image}`} alt="" loading="lazy" />}
              </div>
              <div class="info">
                <time class="mono date" datetime={post.data.date.toISOString().split('T')[0]}>{stamp}</time>
                <h2>{post.data.title}</h2>
                <p>{post.data.summary}</p>
              </div>
            </a>
          );
        })
      )}
    </div>
  </main>

  <Footer />
</Layout>

<style>
  main { min-height: 100vh; }
  header { padding: 72px var(--gutter, clamp(1.5rem, 6vw, 5rem)) 48px; border-bottom: 1px solid var(--border-subtle, var(--border)); }
  .head { display: flex; flex-direction: column; gap: 26px; }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: .34em;
    color: var(--text-muted);
  }
  h1 { font-size: clamp(2.4rem, 6vw, 5rem); font-weight: 700; text-transform: uppercase; line-height: 1.02; }
  .green { color: var(--accent); }

  .list { max-width: 1000px; margin: 0 auto; padding: 24px var(--gutter, clamp(1.5rem, 6vw, 5rem)) 120px; }
  .row {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 36px;
    padding: 36px 0;
    border-bottom: 1px solid var(--border-subtle, var(--border));
    align-items: center;
    transition: background .15s cubic-bezier(.2,.6,.2,1);
  }
  .row:hover { background: rgba(255,255,255,.04); }
  .thumb { aspect-ratio: 16 / 10; overflow: hidden; background: rgba(255,255,255,.06); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; object-position: center 8%; }
  .info { display: flex; flex-direction: column; gap: 12px; }
  .date { color: var(--accent); }
  h2 { font-size: clamp(1.0625rem, 2vw, 1.5rem); font-weight: 700; line-height: 1.24; }
  .info p { font-size: .9375rem; font-weight: 300; line-height: 1.65; color: var(--text-muted); }
  .empty { color: var(--text-muted); font-size: 1.125rem; padding: 36px 0; }

  @media (max-width: 680px) { .row { grid-template-columns: 1fr; } }
</style>
