---
interface Props {
  title?: string;
  description?: string;
}

const { title = 'Parrot Capital', description } = Astro.props;
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} · Parrot Capital</title>
  {description && <meta name="description" content={description} />}
  <link rel="icon" href={`${b}/favicon.ico`} />
  <style is:global>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --bg-base:        #FCF4ED;
      --surface-1:      #F5ECE3;
      --surface-2:      #EDE0D4;
      --text-primary:   #1E0810;
      --text-secondary: rgba(30, 8, 16, 0.70);
      --text-soft:      rgba(30, 8, 16, 0.56);
      --text-muted:     rgba(30, 8, 16, 0.40);
      --border-subtle:  rgba(30, 8, 16, 0.14);
      --border-strong:  rgba(30, 8, 16, 0.24);
      --border-accent:  rgba(142, 21, 32, 0.40);
      --accent:         #8E1520;
      --font-display:   'Georgia', 'Times New Roman', serif;
      --font-body:      'Georgia', 'Times New Roman', serif;
      --font-mono:      ui-monospace, SFMono-Regular, monospace;
      --ls-eyebrow:     .34em;
      --gutter:         clamp(20px, 5vw, 72px);
      --measure:        1180px;
    }

    body {
      background: var(--bg-base);
      color: var(--text-primary);
      font-family: var(--font-body);
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    a:hover {
      color: var(--accent);
    }
  </style>
</head>
<body>
  <slot />
</body>
</html>
