---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import JobCard from '../../../../../_core/src/components/JobCard.astro';

const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const jobs = (await getCollection('jobs'))
  .filter(j => j.data.open !== false)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Careers" description="Open positions at Parrot Capital.">
  <main>
    <header>
      <div class="wrap head">
        <div class="eyebrow">CAREERS</div>
        <h1>Open positions</h1>
      </div>
    </header>

    <div class="list">
      {jobs.length === 0 ? (
        <p class="empty">No open positions right now.</p>
      ) : (
        jobs.map(job => (
          <JobCard
            id={job.id}
            title={job.data.title}
            date={job.data.date}
            type={job.data.type}
            department={job.data.department}
            location={job.data.location}
          />
        ))
      )}
    </div>
  </main>
</Layout>

<style>
  main { min-height: 100vh; }
  header { padding: 72px var(--gutter) 48px; border-bottom: 1px solid var(--border-subtle); }
  .head { display: flex; flex-direction: column; gap: 26px; }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: var(--ls-eyebrow, .34em);
    color: var(--text-muted);
  }
  h1 { font-size: clamp(2.4rem, 6vw, 5rem); font-weight: 700; text-transform: uppercase; line-height: 1.02; }

  .list { max-width: 1000px; margin: 0 auto; padding: 24px var(--gutter) 120px; }
  .empty { color: var(--text-muted); font-size: 1.125rem; padding: 36px 0; }
</style>
