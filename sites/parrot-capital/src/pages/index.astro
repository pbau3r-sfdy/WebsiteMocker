---
// Parrot Capital — holding page
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Parrot Capital</title>
  <meta name="robots" content="noindex, nofollow" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:      #F8EFE5;
      --crimson: #8E1520;
      --gold:    #A8831C;
      --text:    #1E0810;
      --muted:   #907060;
    }

    html, body {
      height: 100%;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Georgia', 'Times New Roman', serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100svh;
      padding: 2.5rem 2rem 5rem;
      text-align: center;
    }

    /* Subtle warm vignette */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background: radial-gradient(ellipse 70% 60% at 50% 40%, transparent 40%, rgba(140,80,40,0.06) 100%);
      pointer-events: none;
    }

    .logo-wrap {
      position: relative;
      margin-bottom: 2.25rem;
    }

    .logo-wrap img {
      width: clamp(200px, 45vw, 290px);
      height: auto;
      display: block;
    }

    /* Ornamental rule matching the logo's gold lines */
    .rule {
      display: flex;
      align-items: center;
      justify-content: center;
      width: clamp(180px, 55%, 340px);
      margin: 0 auto 2rem;
      gap: 0.6rem;
    }
    .rule::before,
    .rule::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--gold);
      opacity: 0.65;
    }
    .rule-diamond {
      width: 5px;
      height: 5px;
      background: var(--gold);
      transform: rotate(45deg);
      flex-shrink: 0;
    }

    .tagline {
      font-size: clamp(0.75rem, 2.2vw, 0.85rem);
      color: var(--muted);
      letter-spacing: 0.14em;
      text-transform: uppercase;
      font-family: system-ui, -apple-system, sans-serif;
      font-weight: 400;
    }

    footer {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 1.1rem 2rem;
      display: flex;
      justify-content: center;
      gap: 2rem;
      font-size: 0.68rem;
      color: var(--muted);
      letter-spacing: 0.07em;
      font-family: system-ui, -apple-system, sans-serif;
      border-top: 1px solid rgba(168,131,28,0.15);
    }

    footer a {
      color: var(--muted);
      text-decoration: none;
    }
    footer a:hover { color: var(--text); }
  </style>
</head>
<body>
  <div class="logo-wrap">
    <img src="./logo.png" alt="Parrot Capital" />
  </div>

  <div class="rule">
    <div class="rule-diamond"></div>
  </div>

  <p class="tagline">Under construction &mdash; more soon.</p>

  <footer>
    <span>&copy; 2026&nbsp;Parrot Capital UG</span>
    <a href="./imprint/">Impressum</a>
    <a href="./privacy/">Datenschutz</a>
  </footer>
</body>
</html>
