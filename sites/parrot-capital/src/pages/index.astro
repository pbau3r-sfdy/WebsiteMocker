---
// Parrot Capital — holding page
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Parrot Capital</title>
  <meta name="robots" content="noindex, nofollow" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg:      #07090F;
      --surface: #0E1220;
      --accent:  #3DB87A;
      --text:    #E8EAF0;
      --muted:   #5A6070;
      --border:  rgba(255,255,255,0.07);
    }

    html, body {
      height: 100%;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Georgia', 'Times New Roman', serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100svh;
      padding: 2rem;
      text-align: center;
    }

    /* subtle radial glow */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background: radial-gradient(ellipse 60% 50% at 50% 45%, rgba(61,184,122,0.06) 0%, transparent 70%);
      pointer-events: none;
    }

    .card {
      position: relative;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: clamp(2.5rem, 8vw, 5rem) clamp(2rem, 8vw, 5rem);
      max-width: 480px;
      width: 100%;
    }

    /* circle mark with triangle inside */
    .mark {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.5rem;
      height: 2.5rem;
      border: 1.5px solid var(--accent);
      border-radius: 50%;
      margin-bottom: 2rem;
    }
    .mark::after {
      content: '';
      display: block;
      width: 0;
      height: 0;
      margin-left: 2px; /* optical centre */
      border-left:  0.55rem solid transparent;
      border-right: 0.55rem solid transparent;
      border-bottom: 0.95rem solid var(--accent);
    }

    h1 {
      font-size: clamp(1.1rem, 3.5vw, 1.5rem);
      font-weight: 400;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--text);
      margin-bottom: 0;
    }

    .divider {
      width: 1.75rem;
      height: 1px;
      background: var(--accent);
      margin: 1.5rem auto;
      opacity: 0.55;
    }

    .tagline {
      font-size: clamp(0.82rem, 2.4vw, 0.92rem);
      color: var(--muted);
      letter-spacing: 0.05em;
      line-height: 1.7;
      font-family: system-ui, -apple-system, sans-serif;
    }

    footer {
      margin-top: 2.5rem;
      font-size: 0.72rem;
      color: var(--muted);
      letter-spacing: 0.06em;
      font-family: system-ui, -apple-system, sans-serif;
      opacity: 0.7;
    }
  </style>
</head>
<body>
  <div class="card">
    <div class="mark" aria-hidden="true"></div>
    <h1>Parrot Capital</h1>
    <div class="divider"></div>
    <p class="tagline">Under construction &mdash; more soon.</p>
  </div>

  <footer>&copy; 2026&nbsp;Parrot Capital UG</footer>
</body>
</html>
