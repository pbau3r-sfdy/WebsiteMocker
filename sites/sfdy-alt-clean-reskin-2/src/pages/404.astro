---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Page not found" description="The page you were looking for does not exist.">
  <Nav />

  <main class="nf">
    <h1>Page not found</h1>
    <p>The page you were looking for does not exist or has moved.</p>
    <p><a href={`${b}/`}>Back to the home page</a></p>
  </main>

  <Footer />

  <script is:inline define:vars={{ base: b }}>
    // Coarse on purpose (WR-01): only the first path segment after the base, so a
    // mistyped or guessed URL (ids, emails) never reaches Plausible as a full path.
    var p = location.pathname;
    if (base && p.indexOf(base) === 0) p = p.slice(base.length);
    var seg = p.split('/').filter(Boolean)[0] || '';
    window.plausible && window.plausible('404', { props: { path: '/' + seg.slice(0, 40) } });
  </script>
</Layout>

<style>
  .nf { max-width: 960px; margin: 0 auto; padding: 160px 24px 120px; }
  .nf h1 { font-size: clamp(32px, 5vw, 56px); font-weight: 300; margin: 0 0 20px; }
  .nf p { font-size: 16px; line-height: 1.7; font-weight: 300; color: rgba(255,255,255,.80); }
  .nf a { color: var(--accent, #00FB92); }
</style>
