---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Starflight Dynamics',
  description = 'High-mobility orbital systems and sovereign applications.',
} = Astro.props;

const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const fontFaceCSS = `
  @font-face{font-family:'Avenir LT';src:url('${b}/fonts/avenir-lt-light.woff2') format('woff2');font-weight:300;font-style:normal;font-display:swap;}
  @font-face{font-family:'Avenir LT';src:url('${b}/fonts/avenir-lt-heavy.woff2') format('woff2');font-weight:700;font-style:normal;font-display:swap;}
`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title === 'Starflight Dynamics' ? title : `${title} · Starflight Dynamics`}</title>
    <link rel="icon" type="image/png" href={`${b}/favicon.png`} />
    <style set:html={fontFaceCSS}></style>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg:          #07080f;
    --bg-card:     #0d0f1c;
    --bg-nav:      rgba(7, 8, 15, 0.85);
    --border:      #1a1f35;
    --text:        #e8ecff;
    --text-muted:  #6b7496;
    --accent:      #3dffa0;
    --accent-dim:  rgba(61, 255, 160, 0.12);
    --radius:      8px;
    --font-head:   'Avenir LT', 'Avenir Next', 'Avenir', sans-serif;
    --font-body:   'Avenir LT', 'Avenir Next', 'Avenir', sans-serif;
  }

  html { scroll-behavior: smooth; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a { color: inherit; text-decoration: none; }

  img { max-width: 100%; display: block; }

  h1, h2, h3, h4 {
    font-family: var(--font-head);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
</style>
