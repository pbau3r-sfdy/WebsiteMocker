---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Terms & Conditions" description="Terms and conditions for Starflight Dynamics GmbH.">
  <Nav />
  <main class="page-main">
    <h1>SFDY Terms &amp; Conditions</h1>
    <p class="lead">Coming soon.</p>
    <p>For questions, contact <a href="mailto:mission-control@starflight-dynamics.com">mission-control@starflight-dynamics.com</a></p>
  </main>
  <Footer />
</Layout>

<style>
  .page-main {
    max-width: 760px;
    margin: 0 auto;
    padding: 9rem 2rem 6rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  h1 { font-size: clamp(2rem, 5vw, 3rem); font-weight: 700; }
  .lead { font-size: 1.1rem; color: var(--text-muted); }
  p { color: var(--text-muted); font-size: 0.95rem; line-height: 1.7; }
  a { color: var(--accent); }
</style>
