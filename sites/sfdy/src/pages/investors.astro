---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Investors" description="Investor information for Starflight Dynamics.">
  <Nav />

  <!-- HERO: rocket launch photo -->
  <section class="investors-hero">
    <div class="hero-bg" style={`background-image: url('${b}/images/investors-bg.jpg')`}></div>
  </section>

  <!-- CONTENT -->
  <section class="investors-content">
    <p class="lead">
      For any in-depth information and our pitch deck,<br />
      please do not hesitate to reach out:
    </p>
    <a class="cta-email" href="mailto:invest.in@starflight-dynamics.com">
      invest.in@starflight-dynamics.com
    </a>
    <div class="thankyou">
      <p class="thankyou-title">Thank You.</p>
      <p class="thankyou-sub">Your SFDY team</p>
    </div>
  </section>

  <!-- NEWSLETTER -->
  <section class="newsletter-section">
    <div class="newsletter-left">
      <div class="section-label">#SFDY-UPDATES</div>
      <p class="newsletter-tagline">Stay in the loop.</p>
    </div>
    <div class="newsletter-right">
      <p class="newsletter-desc">For our Newsletter, please subscribe here:</p>
      <form class="newsletter-form" action="https://formspree.io/f/placeholder" method="POST">
        <input type="email" name="email" placeholder="your@email.com" required aria-label="Email address" />
        <button type="submit">SIGN UP</button>
      </form>
    </div>
  </section>

  <!-- EARTH FROM ORBIT -->
  <div class="earth-section" style={`background-image: url('${b}/images/earth-bg.jpg')`} aria-hidden="true"></div>

  <Footer />
</Layout>

<style>
  .investors-hero {
    position: relative;
    height: 55vh;
    min-height: 360px;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
  }
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,0.2);
  }

  .investors-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    padding: 5rem 2rem;
    background: var(--bg);
  }

  .lead {
    font-size: clamp(1rem, 2.5vw, 1.3rem);
    color: var(--text);
    line-height: 1.7;
  }

  .cta-email {
    font-family: var(--font-head);
    font-size: clamp(1rem, 2.5vw, 1.4rem);
    font-weight: 500;
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.2s;
  }
  .cta-email:hover { color: var(--accent); }

  .thankyou {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .thankyou-title {
    font-family: var(--font-head);
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--text);
  }
  .thankyou-sub {
    font-size: 1rem;
    color: var(--text-muted);
  }

  .newsletter-section {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 4rem;
    padding: 5rem clamp(2rem, 8vw, 8rem);
    background: #ffffff;
    border-top: 1px solid #e0e0e0;
  }

  .newsletter-left {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .section-label {
    font-family: var(--font-head);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #222;
  }

  .newsletter-tagline {
    font-family: var(--font-head);
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    font-weight: 700;
    color: #111;
    line-height: 1.15;
  }

  .newsletter-right {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .newsletter-desc {
    font-size: 0.95rem;
    color: #444;
    line-height: 1.6;
  }

  .newsletter-form {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .newsletter-form input {
    background: #fff;
    border: 1px solid #ccc;
    border-radius: var(--radius);
    color: #111;
    font-family: var(--font-body);
    font-size: 0.875rem;
    padding: 0.65rem 1rem;
    width: 220px;
    outline: none;
    transition: border-color 0.2s;
  }
  .newsletter-form input::placeholder { color: #999; }
  .newsletter-form input:focus { border-color: #384AD3; }
  .newsletter-form button {
    background: #384AD3;
    border: none;
    border-radius: var(--radius);
    color: #fff;
    cursor: pointer;
    font-family: var(--font-head);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    padding: 0.65rem 1.5rem;
    transition: opacity 0.2s;
  }
  .newsletter-form button:hover { opacity: 0.85; }

  @media (max-width: 700px) {
    .newsletter-section { flex-direction: column; gap: 2rem; }
  }

  .earth-section {
    width: 100%;
    height: 480px;
    background-size: cover;
    background-position: center top;
  }
</style>
