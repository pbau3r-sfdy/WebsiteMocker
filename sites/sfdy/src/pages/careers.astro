---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Careers" description="Join the SFDY crew and build the space industry of tomorrow.">
  <Nav />

  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg" style={`background-image: url('${b}/images/careers-hero.jpg')`}></div>
    <div class="hero-content">
      <h1>
        <span class="white">JOIN THE<br />SFDY </span><span class="green">CREW!</span>
      </h1>
    </div>
  </section>

  <!-- HI AT SFDY -->
  <section class="content-section hi-sfdy">
    <div class="accent-bar"></div>
    <div class="hi-body">
      <h2>HI AT <strong>SFDY</strong></h2>
      <p class="lead-bold">We're in the business of breaking barriers and exploring new frontiers in space.</p>
      <p>We're looking for people who are ready to challenge the norms and contribute to our journey of innovation and discovery.</p>
      <p class="green-cta">If you're passionate about space and want to make a real difference in an exciting industry, this is your opportunity!</p>
    </div>
  </section>

  <!-- MORE THAN A COMPANY -->
  <section class="more-section">
    <div class="more-inner">
      <h2>MORE THAN<br />A COMPANY</h2>
      <div class="more-body">
        <p><strong>STARFLIGHT DYNAMICS</strong> is a community of dreamers, thinkers and doers.<br />
        We are a team united by a common goal: to build the industries of the future in space.</p>
        <p>Whether it's testing materials for space, operating cutting-edge facilities in orbit or developing new technologies, every project is a step towards a more innovative and sustainable future.</p>
        <p class="green-cta">Join us and build the industry of tomorrow.</p>
      </div>
    </div>
    <div class="accent-bar"></div>
  </section>

  <!-- GET ON BOARD -->
  <section class="content-section onboard-section">
    <h2>GET <strong>ON BOARD:</strong></h2>
    <p>Please send your application to</p>
    <a href="mailto:join-the-crew@starflight-dynamics.com" class="cta-email">
      join-the-crew@starflight-dynamics.com
    </a>
    <p class="thankyou">Thank You.</p>
  </section>

  <!-- FROM MUNICH TO THE STARS -->
  <section class="munich-section">
    <div class="munich-header">
      <h2><strong>FROM MUNICH</strong> TO THE STARS</h2>
    </div>
    <div class="munich-photo" style={`background-image: url('${b}/images/munich.jpg')`}></div>
    <div class="munich-text">
      <p>We are based in Munich, a European hub for innovation and technology, in the heart of Space Valley. This strategic location gives us access to a rich ecosystem of engineering expertise, technology leaders, and cutting-edge research facilities.</p>
      <p>All of this unfolds against the idyllic backdrop of the Alps, enriching our work with unparalleled inspiration and serenity.</p>
    </div>
  </section>

  <!-- OPEN POSITIONS -->
  <section class="content-section positions-section">
    <h2>OPEN POSITIONS</h2>
    <p>A complete list of our current vacancies<br />will be available here soon.</p>
    <p class="green-cta"><strong>Proactive Applications</strong><br />are always welcome and encouraged.</p>
    <a href="mailto:join-the-crew@starflight-dynamics.com" class="cta-email">
      join-the-crew@starflight-dynamics.com →
    </a>
  </section>

  <!-- EARTH FROM ORBIT -->
  <div class="earth-section" style={`background-image: url('${b}/images/earth-bg.jpg')`} aria-hidden="true"></div>

  <Footer />
</Layout>

<style>
  /* HERO */
  .hero {
    position: relative;
    height: 60vh;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center top;
  }
  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 2rem;
  }

  .hero-content h1 {
    font-size: clamp(2.5rem, 8vw, 6.5rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .white { color: #ffffff; }
  .green { color: var(--accent); }

  /* SHARED CONTENT SECTION */
  .content-section {
    max-width: 900px;
    margin: 0 auto;
    padding: 5rem 2rem;
  }

  .content-section h2 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: 0.04em;
    margin-bottom: 2rem;
  }

  .content-section p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .lead-bold {
    font-weight: 600;
    color: var(--text) !important;
    font-size: 1.05rem !important;
  }

  .green-cta {
    color: var(--accent) !important;
  }

  /* HI AT SFDY */
  .hi-sfdy {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 2.5rem;
    max-width: 100%;
    padding-left: clamp(2rem, 8vw, 8rem);
    padding-right: clamp(2rem, 8vw, 8rem);
  }

  .accent-bar {
    width: 4px;
    min-height: 200px;
    background: linear-gradient(to bottom, var(--accent), #384AD3);
    border-radius: 2px;
    flex-shrink: 0;
    margin-top: 0.5rem;
  }

  .hi-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 700px;
  }

  .hi-body h2 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 400;
    letter-spacing: 0.04em;
    margin-bottom: 1rem;
  }
  .hi-body h2 strong { font-weight: 700; }

  /* MORE THAN A COMPANY */
  .more-section {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 2.5rem;
    background: var(--bg-card);
    padding: 5rem clamp(2rem, 8vw, 8rem);
  }

  .more-inner {
    flex: 1;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .more-inner h2 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .more-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* GET ON BOARD */
  .onboard-section {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .cta-email {
    font-family: var(--font-head);
    font-size: clamp(0.9rem, 2vw, 1.2rem);
    font-weight: 500;
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.2s;
  }
  .cta-email:hover { color: var(--accent); }

  .thankyou {
    font-family: var(--font-head);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text) !important;
  }

  /* MUNICH */
  .munich-section {
    background: var(--bg);
    border-top: 1px solid var(--border);
  }

  .munich-header {
    padding: 4rem clamp(2rem, 8vw, 8rem) 2rem;
  }

  .munich-header h2 {
    font-size: clamp(1.8rem, 4vw, 3rem);
    font-weight: 400;
    letter-spacing: 0.04em;
  }
  .munich-header h2 strong { font-weight: 700; }

  .munich-photo {
    width: 100%;
    height: 400px;
    background-size: cover;
    background-position: center 30%;
  }

  .munich-text {
    padding: 3rem clamp(2rem, 8vw, 8rem);
    max-width: 760px;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .munich-text p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-muted);
  }

  /* OPEN POSITIONS */
  .positions-section {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    border-top: 1px solid var(--border);
  }

  /* EARTH */
  .earth-section {
    width: 100%;
    height: 480px;
    background-size: cover;
    background-position: center top;
  }

  @media (max-width: 600px) {
    .hi-sfdy { flex-direction: column; }
    .accent-bar { min-height: 4px; width: 60px; }
  }
</style>
