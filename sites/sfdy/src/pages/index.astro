---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
  title="Home"
  description="Starflight Dynamics develops high-mobility orbital propulsion systems that bring productive industries to space."
>
  <Nav />

  <!-- ── Hero ──────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-content container">
      <p class="hero-eyebrow">New Space Propulsion</p>
      <h1 class="hero-headline">Orbital propulsion for the next generation of space missions</h1>
      <p class="hero-sub">Starflight Dynamics develops high-mobility orbital propulsion systems that bring productive industries to space.</p>
      <div class="hero-actions">
        <a href="mailto:mission-control@starflight-dynamics.com" class="btn-primary">Reach Out</a>
        <a href={`${b}/news`} class="btn-ghost">Latest News</a>
      </div>
    </div>
  </section>

  <!-- ── Newsletter ────────────────────────────────────────── -->
  <section class="newsletter-section">
    <div class="container newsletter-inner">
      <div class="newsletter-left">
        <p class="newsletter-eyebrow">#SFDY-UPDATES</p>
        <h2 class="newsletter-heading">Stay in the loop.</h2>
        <p class="newsletter-sub">Subscribe to our newsletter for mission updates, company news, and insights from the frontier.</p>
      </div>
      <div class="newsletter-right">
        <form class="newsletter-form" action="https://formspree.io/f/placeholder" method="POST">
          <input type="email" name="email" placeholder="your@email.com" required />
          <button type="submit">SIGN UP</button>
        </form>
      </div>
    </div>
  </section>

  <!-- ── Ecosystem Partners ────────────────────────────────── -->
  <section class="partners-section">
    <div class="container">
      <p class="partners-heading">ECOSYSTEM PARTNERS</p>
      <div class="partners-row">
        <img src={`${b}/images/partners/bavairia.png`} alt="bavAIRia" class="partner-logo" />
        <img src={`${b}/images/partners/bdli.png`}     alt="BDLI"     class="partner-logo" />
        <img src={`${b}/images/partners/newspace.png`} alt="BDI NewSpace" class="partner-logo" />
      </div>
    </div>
  </section>

  <!-- ── Earth Section ─────────────────────────────────────── -->
  <section class="earth-section">
    <div class="earth-overlay"></div>
    <div class="earth-content">
      <p class="earth-tagline">SEE YOU UP THERE!</p>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute; inset: 0;
    background-image: url('/images/hero-bg.jpg');
    background-size: cover;
    background-position: center;
  }
  .hero-bg::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(to bottom, rgba(7,8,15,0.55) 0%, rgba(7,8,15,0.85) 70%, var(--bg) 100%);
  }
  .hero-content {
    position: relative; z-index: 1;
    padding-top: 8rem; padding-bottom: 6rem;
  }
  .hero-eyebrow {
    font-family: var(--font-head);
    font-size: .75rem; font-weight: 600;
    letter-spacing: .16em; text-transform: uppercase;
    color: var(--accent); margin-bottom: 1.25rem;
  }
  .hero-headline {
    font-family: var(--font-head);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800; line-height: 1.05;
    letter-spacing: -.03em;
    color: var(--text);
    max-width: 16ch;
    margin-bottom: 1.5rem;
    text-wrap: balance;
  }
  .hero-sub {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--text-muted);
    max-width: 52ch;
    margin-bottom: 2.5rem;
    line-height: 1.65;
  }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }

  /* ── Buttons ── */
  .btn-primary {
    display: inline-flex; align-items: center;
    padding: .875rem 2rem;
    background: var(--accent); color: #000;
    font-family: var(--font-head); font-size: .9375rem; font-weight: 700;
    border-radius: var(--radius);
    transition: opacity .2s;
  }
  .btn-primary:hover { opacity: .85; }
  .btn-ghost {
    display: inline-flex; align-items: center;
    padding: .875rem 2rem;
    border: 1px solid var(--border);
    color: var(--text-muted);
    font-family: var(--font-head); font-size: .9375rem; font-weight: 600;
    border-radius: var(--radius);
    transition: color .2s, border-color .2s;
  }
  .btn-ghost:hover { color: var(--text); border-color: var(--text-muted); }

  /* ── Newsletter ── */
  .newsletter-section {
    background: #ffffff;
    padding: 5rem 0;
  }
  .newsletter-inner {
    display: flex;
    gap: 4rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .newsletter-left { flex: 1; min-width: 260px; }
  .newsletter-right { flex: 1; min-width: 260px; }
  .newsletter-eyebrow {
    font-family: var(--font-head);
    font-size: .75rem; font-weight: 700;
    letter-spacing: .12em; text-transform: uppercase;
    color: #384AD3; margin-bottom: .75rem;
  }
  .newsletter-heading {
    font-family: var(--font-head);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 800; color: #0a0a0a;
    margin-bottom: .75rem; line-height: 1.1;
  }
  .newsletter-sub {
    font-size: 1.0625rem; color: #555;
    line-height: 1.7;
  }
  .newsletter-form { display: flex; gap: .75rem; flex-wrap: wrap; }
  .newsletter-form input {
    flex: 1; min-width: 200px;
    padding: .8125rem 1.25rem;
    border: 1px solid #ccc; border-radius: var(--radius);
    font-size: 1rem; color: #0a0a0a;
    outline: none;
  }
  .newsletter-form input:focus { border-color: #384AD3; }
  .newsletter-form button {
    padding: .8125rem 1.75rem;
    background: #384AD3; color: #fff;
    border: none; border-radius: var(--radius);
    font-family: var(--font-head); font-size: .9375rem; font-weight: 700;
    letter-spacing: .04em; cursor: pointer;
    transition: opacity .2s;
    white-space: nowrap;
  }
  .newsletter-form button:hover { opacity: .85; }

  /* ── Partners ── */
  .partners-section {
    padding: 5rem 0;
    text-align: center;
  }
  .partners-heading {
    font-family: var(--font-head);
    font-size: .75rem; font-weight: 700;
    letter-spacing: .18em; text-transform: uppercase;
    color: var(--text-muted); margin-bottom: 3rem;
  }
  .partners-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4rem;
    flex-wrap: wrap;
  }
  .partner-logo {
    height: 48px; width: auto;
    filter: brightness(0) invert(1);
    opacity: .7;
    transition: opacity .2s;
  }
  .partner-logo:hover { opacity: 1; }

  /* ── Earth Section ── */
  .earth-section {
    position: relative;
    min-height: 480px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background-image: url('/images/earth-bg.jpg');
    background-size: cover;
    background-position: center;
  }
  .earth-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to bottom, rgba(7,8,15,0.4), rgba(7,8,15,0.6));
  }
  .earth-content {
    position: relative; z-index: 1;
    text-align: center;
  }
  .earth-tagline {
    font-family: var(--font-head);
    font-size: clamp(2rem, 6vw, 4.5rem);
    font-weight: 800;
    letter-spacing: .08em;
    color: var(--text);
    text-shadow: 0 2px 24px rgba(0,0,0,.5);
  }
</style>
