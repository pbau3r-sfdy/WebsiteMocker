---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Imprint" description="Legal notice (Impressum) for Starflight Dynamics GmbH.">
  <Nav />
  <main class="main">
    <div class="container">
      <h1>Imprint</h1>
      <p class="subtitle">Legal notice pursuant to § 5 TMG</p>

      <section>
        <h2>Service provider</h2>
        <p>
          Starflight Dynamics GmbH<br />
          Tal 44<br />
          80331 Munich, Germany
        </p>
      </section>

      <section>
        <h2>Legal representative</h2>
        <p>
          Dr. Philipp Bauer<br />
          Co-Founder &amp; CEO
        </p>
      </section>

      <section>
        <h2>Contact</h2>
        <p>
          E-Mail: <a href="mailto:mission-control@starflight-dynamics.com">mission-control@starflight-dynamics.com</a>
        </p>
      </section>

      <section>
        <h2>Register entry</h2>
        <p>
          Register court: Amtsgericht München<br />
          Registration number: HRB282254
        </p>
      </section>

      <section>
        <h2>VAT identification number</h2>
        <p>DE360871568</p>
      </section>

      <section>
        <h2>Responsible for content (§ 55 para. 2 RStV)</h2>
        <p>
          Dr. Philipp Bauer<br />
          Tal 44, 80331 Munich, Germany
        </p>
      </section>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .main { padding-top: 8rem; padding-bottom: 6rem; min-height: 80vh; }
  .container { max-width: 720px; margin: 0 auto; }
  h1 {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700; margin-bottom: .5rem;
  }
  .subtitle { color: var(--text-muted); margin-bottom: 3rem; }
  section { margin-bottom: 2.5rem; }
  h2 {
    font-size: 1.125rem; font-weight: 600; color: var(--accent);
    margin-bottom: .75rem; padding-bottom: .5rem;
    border-bottom: 1px solid var(--border);
  }
  p { color: var(--text-muted); line-height: 1.75; margin-bottom: .75rem; }
  a { color: var(--accent); }
  a:hover { opacity: .75; }
</style>
