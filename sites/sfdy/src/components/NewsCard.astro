---
import type { CollectionEntry } from 'astro:content';
import { stamp, cardTitle } from '../data/news';
interface Props { post: CollectionEntry<'news'>; }
const { post } = Astro.props;
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<a href={`${b}/news/${post.id}`} class="card">
  <span class="thumb">{post.data.image && <img src={`${b}${post.data.image}`} alt="" loading="lazy" />}</span>
  <span class="body">
    <span class="kick mono"><span class="date">{stamp(post.data.date)}</span>{post.data.kicker && <span class="k">{post.data.kicker}</span>}</span>
    <span class="title">{cardTitle(post)}</span>
  </span>
</a>

<style>
  .card {
    display: flex; flex-direction: column; overflow: hidden;
    background: var(--surface-1); border: 1px solid var(--border-subtle); color: #fff;
    transition: transform .2s var(--ease), border-color .2s, box-shadow .2s;
  }
  .card:hover { transform: translateY(-2px); border-color: var(--border-accent); box-shadow: 0 0 24px rgba(0,251,146,.12); color: #fff; }
  .thumb { display: block; aspect-ratio: 16 / 9; overflow: hidden; background: var(--surface-2); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .body { display: flex; flex-direction: column; gap: 10px; padding: 20px 22px 24px; flex: 1; }
  .kick { display: flex; gap: 12px; }
  .date { color: var(--text-muted); }
  .k { color: var(--accent); }
  .title { font-family: var(--font-display); font-size: 17px; font-weight: 700; line-height: 1.3; text-transform: uppercase; letter-spacing: .02em; text-wrap: pretty; }
</style>
