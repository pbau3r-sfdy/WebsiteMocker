---
/** Open point that must be resolved before launch. Renders in high-visibility yellow;
    the layout counts every marker and shows a jump-to pill. `id` refers to one or more
    entries in src/data/open-points.ts (listed on /open-points); `block` for a full-width note. */
import { pointById } from '../data/open-points';
interface Props { id: string | string[]; block?: boolean; }
const { id, block = false } = Astro.props;
const ids = Array.isArray(id) ? id : [id];
const titles = ids.map(i => pointById(i).title).join(' · ');
const Tag = block ? 'div' : 'mark';
---
<Tag id={`tbd-${ids[0]}`} class:list={['tbd', { block }]} data-points={ids.join(' ')} title={`To be resolved: ${titles}`}><slot /></Tag>
