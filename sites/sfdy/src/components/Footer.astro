---
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer-inner">
      <!-- Brand -->
      <div class="footer-brand">
        <a href="/" class="footer-logo-link">
          <img src="/images/logo-white.png" alt="Starflight Dynamics" class="footer-logo" />
        </a>
        <p class="footer-tagline">Orbital propulsion for the next generation of space missions.</p>
      </div>

      <!-- Nav -->
      <nav class="footer-nav" aria-label="Footer navigation">
        <a href="/">Home</a>
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/imprint">Imprint</a>
      </nav>

      <!-- Socials -->
      <div class="footer-socials">
        <a href="https://www.linkedin.com/company/starflight-dynamics/" target="_blank" rel="noopener" aria-label="LinkedIn">
          <!-- LinkedIn icon -->
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
        <a href="https://www.instagram.com/starflight_dynamics/" target="_blank" rel="noopener" aria-label="Instagram">
          <!-- Instagram icon -->
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
          </svg>
        </a>
        <a href="https://twitter.com/SFDY_Space" target="_blank" rel="noopener" aria-label="X (Twitter)">
          <!-- X icon -->
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.747l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
        <a href="https://www.facebook.com/profile.php?id=100092226416926" target="_blank" rel="noopener" aria-label="Facebook">
          <!-- Facebook icon -->
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a>
        <a href="mailto:mission-control@starflight-dynamics.com" aria-label="Email">
          <!-- Email icon -->
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
        </a>
      </div>
    </div>

    <div class="footer-copy">
      &copy; {year} Starflight Dynamics GmbH. All rights reserved.
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 3.5rem 0 2rem;
    margin-top: 0;
  }
  .footer-inner {
    display: flex; align-items: flex-start; gap: 3rem;
    flex-wrap: wrap; margin-bottom: 2.5rem;
  }
  .footer-brand { flex: 1; min-width: 200px; }
  .footer-logo-link { display: inline-block; }
  .footer-logo { height: 28px; width: auto; margin-bottom: .75rem; }
  .footer-tagline { font-size: .875rem; color: var(--text-muted); line-height: 1.6; max-width: 28ch; }

  .footer-nav {
    display: flex; gap: 1.5rem; flex-wrap: wrap;
    align-items: center; padding-top: .25rem;
  }
  .footer-nav a {
    font-size: .875rem; color: var(--text-muted);
    transition: color .2s; white-space: nowrap;
  }
  .footer-nav a:hover { color: var(--text); }

  .footer-socials { display: flex; gap: .875rem; align-items: center; padding-top: .25rem; }
  .footer-socials a {
    color: var(--text-muted);
    transition: color .2s;
    display: flex; align-items: center;
  }
  .footer-socials a:hover { color: var(--accent); }

  .footer-copy {
    font-size: .8125rem; color: var(--text-muted);
    border-top: 1px solid var(--border); padding-top: 1.5rem;
  }
</style>
