---
/** Mailchimp signup card (dark, green top rule). */
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const action = 'https://starflight-dynamics.us17.list-manage.com/subscribe/post?u=fdebab77920a5ad885afd229c&id=88bca13b57&f_id=0027c2e1f0';
// Website signups land in the public tier only: tag "SFDY - L3 - Community" (never L1 shareholders or L2 investors).
const tagId = '989';
const honeypot = 'b_fdebab77920a5ad885afd229c_88bca13b57'; // bot trap: must stay empty and hidden
---

<section class="band">
  <div class="card">
    <div class="copy">
      <div class="eyebrow accent">SFDY updates</div>
      <h2>Stay in the loop</h2>
      <p>Programme milestones, contract awards and company announcements.</p>
    </div>
    <form action={action} method="post" target="_blank">
      <input type="hidden" name="tags" value={tagId} />
      <div style="position:absolute;left:-5000px" aria-hidden="true"><input type="text" name={honeypot} tabindex="-1" value="" /></div>
      <label for="mce-EMAIL">Email address</label>
      <div class="row">
        <input id="mce-EMAIL" type="email" name="EMAIL" required placeholder="name@organisation.com" />
        <button type="submit">Sign up</button>
      </div>
      <p class="fine">Double opt-in. You can unsubscribe at any time. See <a href={`${b}/privacy-policy`}>Privacy</a>.</p>
    </form>
  </div>
</section>

<style>
  .band { padding: 48px var(--gutter) 72px; }
  .card {
    max-width: var(--measure); margin: 0 auto;
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px 64px;
    padding: 28px 32px;
    background: var(--surface-1);
    border: 1px solid var(--border-subtle); border-top: 3px solid var(--accent);
  }
  .copy { flex: 1 1 380px; }
  .eyebrow { font-size: 12px; font-weight: 700; }
  .eyebrow.accent { color: var(--accent); }
  h2 { margin-top: 16px; font-size: clamp(28px, 4vw, 40px); font-weight: 700; line-height: 1.05; text-transform: uppercase; }
  .copy p { margin-top: 14px; max-width: 480px; font-size: 16px; line-height: 1.65; font-weight: 300; color: var(--text-secondary); }
  form { flex: 1 1 400px; display: flex; flex-direction: column; gap: 8px; }
  label { font-size: 10px; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; color: var(--text-muted); }
  .row { display: flex; flex-wrap: wrap; gap: 8px; }
  input {
    flex: 1 1 220px; min-width: 0; padding: 13px 14px;
    background: #000; color: #fff; border: 1px solid var(--border-strong); border-radius: 0;
    font-family: var(--font-body); font-size: 15px; font-weight: 300; outline: none;
  }
  input:focus { border-color: var(--accent); }
  button {
    flex: none; padding: 13px 22px; cursor: pointer;
    background: var(--accent); color: #000; border: 1px solid var(--accent); border-radius: 0;
    font-family: var(--font-display); font-size: 12px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase;
    transition: background .2s var(--ease), border-color .2s var(--ease);
  }
  button:hover { background: #fff; border-color: #fff; }
  .fine a { color: var(--text-secondary); text-decoration: underline; }
  .fine { margin-top: 4px; font-size: 13px; line-height: 1.5; color: var(--text-muted); }
  @media (max-width: 560px) { .card { padding: 24px 20px; } }
</style>
