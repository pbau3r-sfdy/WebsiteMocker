---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Orbint',
  description = 'Space-based signal intelligence. We detect, identify, and localize signal emitters around the globe.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title === 'Orbint' ? title : `${title} · Orbint`}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600;700&family=Inter:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg:          #121110;
    --bg-card:     #1c1a18;
    --bg-card2:    #252220;
    --bg-nav:      rgba(18, 17, 16, 0.98);
    --border:      #302c28;
    --text:        #e6e4e2;
    --text-muted:  #9e9690;
    --text-dim:    #5e5650;
    --accent:      #f2641c;
    --accent-dark: #c94e0e;
    --accent-dim:  rgba(242, 100, 28, 0.12);
    --radius:      8px;
    --font-head:   'IBM Plex Sans', sans-serif;
    --font-body:   'Inter', sans-serif;
  }

  html { scroll-behavior: smooth; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a { color: inherit; text-decoration: none; }

  img { max-width: 100%; display: block; }

  h1, h2, h3, h4 {
    font-family: var(--font-head);
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
</style>
