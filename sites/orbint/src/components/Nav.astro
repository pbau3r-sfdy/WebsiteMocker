---
const navLinks = [
  { label: 'Mission', href: '/#mission' },
  { label: 'Careers', href: '/#careers' },
  { label: 'News', href: '/news' },
  { label: 'Contact', href: '/#contact' },
];
---

<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo" aria-label="Orbint home">
      <img src="/images/logo-white.png" alt="Orbint" height="32" />
    </a>
    <ul class="nav-links">
      {navLinks.map(link => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
    <button class="nav-toggle" aria-label="Open menu" id="nav-toggle">
      <span></span><span></span><span></span>
    </button>
  </div>
  <ul class="nav-mobile" id="nav-mobile">
    {navLinks.map(link => (
      <li><a href={link.href}>{link.label}</a></li>
    ))}
  </ul>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle');
  const mobile = document.getElementById('nav-mobile');
  toggle?.addEventListener('click', () => mobile?.classList.toggle('open'));
</script>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--bg-nav);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-logo img {
    height: 32px;
    width: auto;
    object-fit: contain;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 2.5rem;
  }

  .nav-links a {
    font-family: var(--font-head);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: var(--accent);
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }

  .nav-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text);
    border-radius: 2px;
    transition: opacity 0.2s;
  }

  .nav-mobile {
    display: none;
    list-style: none;
    flex-direction: column;
    padding: 1rem 2rem 1.5rem;
    gap: 1rem;
    border-top: 1px solid var(--border);
  }

  .nav-mobile.open {
    display: flex;
  }

  .nav-mobile a {
    font-family: var(--font-head);
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-muted);
    transition: color 0.2s;
  }

  .nav-mobile a:hover {
    color: var(--text);
  }

  @media (max-width: 640px) {
    .nav-links { display: none; }
    .nav-toggle { display: flex; }
  }
</style>
