---
const year = new Date().getFullYear();
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="footer">
  <div class="footer-inner">
    <a href={`${b}/`} class="footer-logo" aria-label="Orbint home">
      <img src={`${b}/images/logo-white.png`} alt="Orbint" height="28" />
    </a>
    <nav class="footer-nav" aria-label="Legal">
      <a href={`${b}/impressum`}>Impressum</a>
      <a href={`${b}/privacy`}>Privacy Policy</a>
    </nav>
    <p class="footer-copy">© {year} Orbint GmbH</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding: 2rem 0;
    margin-top: 4rem;
  }

  .footer-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .footer-logo img {
    height: 28px;
    width: auto;
    object-fit: contain;
    opacity: 0.7;
    transition: opacity 0.2s;
  }

  .footer-logo:hover img {
    opacity: 1;
  }

  .footer-nav {
    display: flex;
    gap: 1.5rem;
    margin-left: auto;
  }

  .footer-nav a {
    font-size: 0.8125rem;
    color: var(--text-muted);
    transition: color 0.2s;
  }

  .footer-nav a:hover {
    color: var(--text);
  }

  .footer-copy {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  @media (max-width: 600px) {
    .footer-inner { flex-direction: column; align-items: flex-start; gap: 1rem; }
    .footer-nav { margin-left: 0; }
  }
</style>
