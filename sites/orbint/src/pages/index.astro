---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import NewsCard from '../components/NewsCard.astro';
import { getCollection } from 'astro:content';

const allNews = await getCollection('news');
const latestNews = allNews
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 6);

const b = import.meta.env.BASE_URL.replace(/\/$/, '');

const partners = [
  { name: 'University of the Bundeswehr Munich', logo: `${b}/images/partners/unibw.png` },
  { name: 'MCSC', logo: `${b}/images/partners/mcsc.png` },
  { name: 'dtec.bw', logo: `${b}/images/partners/dtec.png` },
  { name: 'Rohde & Schwarz', logo: `${b}/images/partners/rs.png` },
  { name: 'ESA BIC', logo: `${b}/images/partners/esa.png` },
  { name: 'Palladion', logo: `${b}/images/partners/palladion.png` },
  { name: 'BDI NewSpace', logo: `${b}/images/partners/bdi.png` },
];
---

<Layout title="Orbint" description="Space-based signal intelligence. We detect, identify, and localize signal emitters around the globe.">
  <Nav />

  <!-- ── HERO ── -->
  <section class="hero" id="top">
    <div class="hero-bg" style={`background-image: url('${b}/images/poster_dark.jpg')`}></div>
    <div class="container hero-content">
      <p class="hero-label">Space-Based Signal Intelligence</p>
      <h1 class="hero-headline">
        We detect, identify,<br />
        and localize signal emitters<br />
        around the globe.
      </h1>
      <a href="#mission" class="btn-primary">Explore our technology →</a>
    </div>
    <div class="hero-scroll-hint" aria-hidden="true">
      <span>↓</span>
    </div>
  </section>

  <!-- ── MISSION / TECHNOLOGY ── -->
  <section class="section" id="mission">
    <div class="container">
      <p class="section-label">Technology</p>
      <h2 class="section-title">Three core applications</h2>
      <p class="section-sub">
        Orbint's distributed satellite network delivers sub-kilometer signal geolocation
        in near real-time — enabling capabilities previously impossible from space.
      </p>
      <div class="tech-grid">
        <div class="tech-card">
          <div class="tech-icon">⚡</div>
          <h3>Electromagnetic Order of Battle</h3>
          <p>
            Real-time mapping of radar systems and jamming equipment in restricted areas.
            Multi-satellite signal processing achieves sub-kilometer precision while
            identifying modulation patterns across the full electromagnetic spectrum.
          </p>
        </div>
        <div class="tech-card">
          <div class="tech-icon">🛳</div>
          <h3>Maritime Surveillance</h3>
          <p>
            Track vessels with disabled AIS transponders by analyzing radar and
            communication signatures. Fused tracking data resolves positions to
            sub-kilometer accuracy — even for ships actively evading detection.
          </p>
        </div>
        <div class="tech-card">
          <div class="tech-icon">📡</div>
          <h3>Crisis Early Warning</h3>
          <p>
            Detect behavioral changes in emitters — frequency shifts, pulse rhythm
            modifications — during satellite passes. Operators receive alerts before
            ground-level changes become apparent through any other means.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── PARTNERS ── -->
  <section class="section partners-section">
    <div class="container">
      <p class="section-label">Partners & Backers</p>
      <div class="partners-grid">
        {partners.map(p => (
          <div class="partner-logo">
            <img src={p.logo} alt={p.name} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── CAREERS ── -->
  <section class="section" id="careers">
    <div class="container careers-layout">
      <div class="careers-text">
        <p class="section-label">Careers</p>
        <h2 class="section-title">Work on what matters</h2>
        <p>
          We are a compact team of researchers and engineers building capabilities
          that strengthen European technological sovereignty. Every person carries
          significant individual responsibility — there are no passengers.
        </p>
        <p>
          We look for technical depth above all else. If you want to work on
          hard problems in signal intelligence, satellite systems, and real-time
          data processing, we want to hear from you.
        </p>
        <a href="mailto:info@orbint.de" class="btn-outline">Send unsolicited application</a>
      </div>
      <div class="careers-values">
        <div class="value-item">
          <span class="value-num">01</span>
          <h4>Technical depth</h4>
          <p>We do hard engineering. Understanding the physics and mathematics of what you build is non-negotiable.</p>
        </div>
        <div class="value-item">
          <span class="value-num">02</span>
          <h4>European sovereignty</h4>
          <p>We are building capabilities that matter for Europe's security and strategic independence.</p>
        </div>
        <div class="value-item">
          <span class="value-num">03</span>
          <h4>Real responsibility</h4>
          <p>Small team, large scope. You own your domain end-to-end, from research to deployment.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── NEWS ── -->
  <section class="section" id="news">
    <div class="container">
      <p class="section-label">Latest</p>
      <div class="news-header">
        <h2 class="section-title">News</h2>
        <a href={`${b}/news`} class="news-all-link">All news →</a>
      </div>
      <div class="news-grid">
        {latestNews.map(post => (
          <NewsCard
            title={post.data.title}
            date={post.data.date}
            summary={post.data.summary}
            slug={post.slug}
            image={post.data.image}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ── CONTACT ── -->
  <section class="section" id="contact">
    <div class="container contact-layout">
      <div class="contact-info">
        <p class="section-label">Get in touch</p>
        <h2 class="section-title">Contact us</h2>
        <p class="contact-address">
          Orbint GmbH<br />
          Lilienthalstraße 9<br />
          85579 Neubiberg, Germany
        </p>
        <a href="mailto:info@orbint.de" class="contact-email">info@orbint.de</a>
      </div>
      <form class="contact-form" action="https://formspree.io/f/placeholder" method="POST">
        <div class="form-row">
          <div class="form-group">
            <label for="fname">First name</label>
            <input id="fname" name="fname" type="text" required placeholder="Alexander" />
          </div>
          <div class="form-group">
            <label for="lname">Last name</label>
            <input id="lname" name="lname" type="text" required placeholder="Eckert" />
          </div>
        </div>
        <div class="form-group">
          <label for="email">Work email</label>
          <input id="email" name="email" type="email" required placeholder="you@organization.com" />
        </div>
        <div class="form-group">
          <label for="org">Organization</label>
          <input id="org" name="organization" type="text" placeholder="Your organization" />
        </div>
        <div class="form-group">
          <label for="inquiry">Inquiry type</label>
          <select id="inquiry" name="inquiry">
            <option value="">Select one…</option>
            <option>Partnership</option>
            <option>Investment</option>
            <option>Government / Defense</option>
            <option>Press & Media</option>
            <option>Career</option>
            <option>Other</option>
          </select>
        </div>
        <div class="form-group">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" required placeholder="Tell us about your interest…"></textarea>
        </div>
        <button type="submit" class="btn-primary">Send message →</button>
      </form>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  /* ── layout utils ── */
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section {
    padding: 6rem 0;
  }

  .section-label {
    font-family: var(--font-head);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    color: var(--text);
    margin-bottom: 1.25rem;
  }

  .section-sub {
    font-size: 1.0625rem;
    color: var(--text-muted);
    max-width: 620px;
    margin-bottom: 3rem;
    line-height: 1.7;
  }

  /* ── buttons ── */
  .btn-primary {
    display: inline-block;
    background: var(--accent);
    color: #fff;
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.9375rem;
    padding: 0.75rem 1.75rem;
    border-radius: var(--radius);
    border: none;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.2s;
  }

  .btn-primary:hover {
    background: var(--accent-dark);
    transform: translateY(-1px);
  }

  .btn-outline {
    display: inline-block;
    color: var(--accent);
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 0.9375rem;
    padding: 0.7rem 1.75rem;
    border-radius: var(--radius);
    border: 1px solid var(--accent);
    transition: background 0.2s, color 0.2s;
    margin-top: 1rem;
  }

  .btn-outline:hover {
    background: var(--accent-dim);
    color: var(--text);
  }

  /* ── hero ── */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    
    background-size: cover;
    background-position: center 30%;
  }

  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--bg) 70%, transparent) 75%,
      var(--bg) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding-top: 6rem;
    padding-bottom: 4rem;
  }

  .hero-label {
    font-family: var(--font-head);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.5rem;
  }

  .hero-headline {
    font-size: clamp(2.25rem, 5.5vw, 4.25rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 2.5rem;
    max-width: 820px;
  }

  .hero-scroll-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    color: var(--text-muted);
    font-size: 1.25rem;
    animation: bounce 2s infinite;
  }

  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(8px); }
  }

  /* ── tech grid ── */
  .tech-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .tech-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 2rem;
    transition: border-color 0.2s;
  }

  .tech-card:hover {
    border-color: var(--accent);
  }

  .tech-icon {
    font-size: 1.75rem;
    margin-bottom: 1rem;
  }

  .tech-card h3 {
    font-size: 1.0625rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    color: var(--text);
  }

  .tech-card p {
    font-size: 0.9375rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  @media (max-width: 900px) {
    .tech-grid { grid-template-columns: 1fr; }
  }

  /* ── partners ── */
  .partners-section {
    padding: 4rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .partners-grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2.5rem 3.5rem;
    margin-top: 2rem;
  }

  .partner-logo img {
    height: 36px;
    width: auto;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.55;
    transition: opacity 0.2s;
  }

  .partner-logo:hover img {
    opacity: 0.9;
  }

  /* ── careers ── */
  .careers-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  .careers-text p {
    color: var(--text-muted);
    margin-bottom: 1rem;
    line-height: 1.7;
  }

  .careers-values {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .value-item {
    border-left: 2px solid var(--accent);
    padding-left: 1.25rem;
  }

  .value-num {
    font-family: var(--font-head);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--accent);
    display: block;
    margin-bottom: 0.25rem;
  }

  .value-item h4 {
    font-size: 0.9375rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--text);
  }

  .value-item p {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  @media (max-width: 800px) {
    .careers-layout { grid-template-columns: 1fr; gap: 3rem; }
  }

  /* ── news ── */
  .news-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 2.5rem;
  }

  .news-header .section-title { margin-bottom: 0; }

  .news-all-link {
    font-family: var(--font-head);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent);
    transition: color 0.2s;
  }

  .news-all-link:hover { color: var(--text); }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .news-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 580px) {
    .news-grid { grid-template-columns: 1fr; }
  }

  /* ── contact ── */
  .contact-layout {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 5rem;
    align-items: start;
  }

  .contact-address {
    color: var(--text-muted);
    line-height: 1.8;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .contact-email {
    color: var(--accent);
    font-family: var(--font-head);
    font-size: 0.9375rem;
    transition: color 0.2s;
  }

  .contact-email:hover { color: var(--text); }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-family: var(--font-head);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    padding: 0.65rem 0.875rem;
    outline: none;
    transition: border-color 0.2s;
    resize: vertical;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: var(--text-muted);
    opacity: 0.6;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: var(--accent);
  }

  .form-group select option {
    background: var(--bg-card);
  }

  @media (max-width: 800px) {
    .contact-layout { grid-template-columns: 1fr; gap: 3rem; }
    .form-row { grid-template-columns: 1fr; }
  }
</style>
