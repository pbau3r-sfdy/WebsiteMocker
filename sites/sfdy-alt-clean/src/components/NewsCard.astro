---
interface Props { title: string; date: Date; slug: string; image?: string; }
const { title, date, slug, image } = Astro.props;
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const stamp = date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).toUpperCase();
---

<a href={`${b}/news/${slug}`} class="card">
  <div class="thumb">
    {image
      ? <img src={`${b}${image}`} alt="" loading="lazy" />
      : <div class="placeholder"></div>}
  </div>
  <div class="body">
    <span class="mono date">{stamp}</span>
    <h3>{title}</h3>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface-1);
    border: 1px solid var(--border-subtle);
    overflow: hidden;
    transition: border-color .2s cubic-bezier(.2,.6,.2,1), transform .2s cubic-bezier(.2,.6,.2,1);
  }
  .card:hover { border-color: var(--border-accent); transform: translateY(-2px); }

  .thumb { aspect-ratio: 16 / 10; overflow: hidden; background: var(--surface-2); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; object-position: center 8%; }
  .placeholder { width: 100%; height: 100%; background: var(--surface-2); }

  .body { display: flex; flex-direction: column; gap: 6px; padding: 14px 16px 16px; flex: 1; }
  .date { color: var(--accent); }
  h3 { font-size: .9375rem; font-weight: 700; line-height: 1.3; color: var(--text-primary); }
</style>
