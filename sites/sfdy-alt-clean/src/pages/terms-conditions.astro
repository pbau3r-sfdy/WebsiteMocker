---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Terms & Conditions" description="Terms and conditions — Starflight Dynamics GmbH.">
  <Nav />

  <main>
    <div class="doc">
      <div class="eyebrow">LEGAL</div>
      <h1>Terms &amp; conditions</h1>
      <p>
        The terms of use are to be supplied by Starflight Dynamics. This page is wired and styled;
        drop the final wording into this file before the site goes live.
      </p>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  main { min-height: 100vh; padding: 72px var(--gutter) 120px; }
  .doc { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 20px; }
  h1 { font-size: clamp(2rem, 4.4vw, 3.25rem); font-weight: 700; text-transform: uppercase; line-height: 1.06; margin-bottom: 6px; }
  p { font-size: 1rem; font-weight: 300; line-height: 1.75; color: var(--text-secondary); }
</style>
