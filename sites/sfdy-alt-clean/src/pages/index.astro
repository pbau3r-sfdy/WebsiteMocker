---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Beam from '../components/Beam.astro';
import NewsCard from '../components/NewsCard.astro';
import Newsletter from '../components/Newsletter.astro';
import Footer from '../components/Footer.astro';

const b = import.meta.env.BASE_URL.replace(/\/$/, '');

const posts = (await getCollection('news'))
  .sort((a, z) => z.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 9);
---

<Layout description="Technologies for the High Frontier. Site currently under construction.">
  <Nav />

  <section class="hero">
    <img src={`${b}/images/hero-earth-night.jpg`} alt="" class="hero-bg" />
    <div class="scrim"></div>
    <Beam />
    <div class="wrap hero-content">
      <div class="eyebrow">STARFLIGHT DYNAMICS</div>
      <h1>
        <span>Currently under</span>
        <span class="green">construction</span>
      </h1>
      <p class="descriptor">Technologies for the High Frontier</p>
      <div class="meta mono">
        <span>Munich · Germany</span>
        <span>Full site in preparation</span>
        <a href="mailto:mission-control@starflight-dynamics.com">mission-control@starflight-dynamics.com</a>
      </div>
    </div>
  </section>

  <section class="news">
    <div class="wrap">
      <div class="head">
        <div class="eyebrow">LATEST NEWS</div>
        <a href={`${b}/news`} class="all">ALL NEWS →</a>
      </div>
      <div class="grid">
        {posts.map(post => (
          <NewsCard
            title={post.data.short ?? post.data.title}
            date={post.data.date}
            id={post.id}
            image={post.data.image}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="partners">
    <div class="wrap row">
      <div class="eyebrow nowrap">ECOSYSTEM PARTNERS</div>
      <div class="logos">
        <img src={`${b}/images/partners/bavairia.png`} alt="bavAIRia" class="lg" />
        <img src={`${b}/images/partners/bdli-trim.png`} alt="BDLI" class="bdli" />
        <img src={`${b}/images/partners/newspace.png`} alt="NewSpace BDI Initiative" class="lg" />
      </div>
    </div>
  </section>

  <Newsletter variant="white" />

  <Footer />
</Layout>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - 76px);
    padding: 64px 0;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--bg-base);
  }
  .hero-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: right 30%; }
  .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0,0,0,.88) 0%, rgba(0,0,0,.7) 42%, rgba(0,0,0,.25) 78%, rgba(0,0,0,0) 100%);
  }
  .hero-content {
    position: relative;
    z-index: 1;
    width: 100%;
    padding: 0 var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 34px;
  }
  h1 {
    font-size: clamp(2.6rem, 7.4vw, 6.5rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -.01em;
    text-transform: uppercase;
  }
  h1 span { display: block; }
  h1 .green { color: var(--accent); }
  .descriptor {
    max-width: 46ch;
    font-size: clamp(1.05rem, 1.7vw, 1.5rem);
    font-weight: 300;
    color: var(--text-secondary);
  }
  .meta { display: flex; flex-wrap: wrap; gap: 14px 40px; align-items: center; color: var(--text-muted); }
  .meta a { color: var(--accent); }

  .news { padding: 32px var(--gutter) 36px; border-top: 1px solid var(--border-subtle); }
  .head { display: flex; align-items: baseline; justify-content: space-between; gap: 24px; margin-bottom: 18px; }
  .all { font-size: 11px; font-weight: 600; letter-spacing: .22em; color: var(--accent); }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  @media (max-width: 860px) { .grid { grid-template-columns: 1fr; } }

  .partners { padding: 26px var(--gutter); border-top: 1px solid var(--border-subtle); }
  .row { display: flex; flex-wrap: nowrap; align-items: center; justify-content: space-between; gap: 56px; }
  .nowrap { white-space: nowrap; flex-shrink: 0; }
  .logos { display: flex; flex-wrap: nowrap; gap: 24px; align-items: center; justify-content: flex-end; margin-left: auto; padding-left: 64px; flex-shrink: 0; }
  .logos .lg { height: 56px; width: 150px; object-fit: contain; opacity: .85; filter: brightness(0) invert(1); }
  .logos .bdli { height: 19px; width: auto; object-fit: contain; opacity: .85; filter: brightness(0) invert(1); }
  @media (max-width: 900px) {
    .row { flex-wrap: wrap; gap: 24px; }
    .logos { flex-wrap: wrap; padding-left: 0; }
  }
</style>
