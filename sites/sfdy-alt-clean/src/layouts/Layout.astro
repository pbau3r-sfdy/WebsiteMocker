---
interface Props { title?: string; description?: string; }
const {
  title = 'Starflight Dynamics',
  description = 'Technologies for the High Frontier.',
} = Astro.props;

const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const fontFaceCSS = `
  @font-face{font-family:'Avenir Next';src:url('${b}/fonts/avenir-lt-light.woff2') format('woff2');font-weight:300;font-style:normal;font-display:swap;}
  @font-face{font-family:'Avenir Next';src:url('${b}/fonts/avenir-lt-heavy.woff2') format('woff2');font-weight:700;font-style:normal;font-display:swap;}
`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title === 'Starflight Dynamics' ? title : `${title} · Starflight Dynamics`}</title>
    <link rel="icon" type="image/png" href={`${b}/favicon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&display=swap" />
    <style set:html={fontFaceCSS}></style>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  /* SFDY design-system tokens */
  :root {
    --sfdy-blue:    #0432FF;
    --sfdy-cyan:    #00FDFF;
    --sfdy-green:   #00FB92;
    --sfdy-magenta: #FF008A;

    --bg-base:      #000000;
    --surface-1:    #06070A;
    --surface-2:    #101319;

    --text-primary:   #FFFFFF;
    --text-secondary: rgba(255,255,255,.70);
    --text-soft:      rgba(255,255,255,.56);
    --text-muted:     rgba(255,255,255,.40);

    --border-subtle: rgba(255,255,255,.14);
    --border-strong: rgba(255,255,255,.24);
    --border-accent: rgba(0,251,146,.40);

    --accent: var(--sfdy-green);
    --beam: linear-gradient(180deg, var(--sfdy-blue) 0%, var(--sfdy-cyan) 33%, var(--sfdy-green) 65%, var(--sfdy-green) 100%);

    --font-display: 'Avenir Next', 'Mulish', system-ui, sans-serif;
    --font-body:    'Avenir Next', 'Mulish', system-ui, sans-serif;
    --font-mono:    'IBM Plex Mono', ui-monospace, Menlo, monospace;

    --ls-eyebrow: .34em;
    --gutter: clamp(20px, 5vw, 72px);
    --measure: 1180px;
  }

  html { scroll-behavior: smooth; }

  body {
    background: var(--bg-base);
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 16px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }

  a { color: inherit; text-decoration: none; }
  a:hover { color: var(--accent); }
  img { max-width: 100%; display: block; }

  h1, h2, h3 { font-family: var(--font-display); line-height: 1.1; }

  .eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .mono {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .wrap { max-width: var(--measure); margin: 0 auto; }
</style>
