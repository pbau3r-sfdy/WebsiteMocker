---
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer-inner">
    <a href={`${b}/`} class="footer-logo" aria-label="Levion Materials home">
      <img src={`${b}/images/logo-white.png`} alt="Levion Materials" height="26" />
    </a>
    <nav class="footer-nav" aria-label="Legal">
      <a href={`${b}/imprint`}>Impressum</a>
      <a href={`${b}/privacy-policy`}>Privacy Policy</a>
    </nav>
    <p class="footer-copy">© {year} Levion Materials GmbH</p>
  </div>
</footer>
<style>
  .footer { border-top:1px solid var(--border); padding:2rem 0; margin-top:4rem; }
  .footer-inner { max-width:1200px; margin:0 auto; padding:0 2rem; display:flex; align-items:center; gap:2rem; flex-wrap:wrap; }
  .footer-logo img { height:26px; width:auto; object-fit:contain; opacity:.7; transition:opacity .2s; }
  .footer-logo:hover img { opacity:1; }
  .footer-nav { display:flex; gap:1.5rem; margin-left:auto; }
  .footer-nav a { font-size:.8125rem; color:var(--text-muted); transition:color .2s; }
  .footer-nav a:hover { color:var(--text); }
  .footer-copy { font-size:.8125rem; color:var(--text-muted); }
  @media (max-width:600px) { .footer-inner { flex-direction:column; align-items:flex-start; gap:1rem; } .footer-nav { margin-left:0; } }
</style>
