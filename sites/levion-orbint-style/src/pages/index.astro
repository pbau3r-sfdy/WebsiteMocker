---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import NewsCard from '../components/NewsCard.astro';
import { getCollection } from 'astro:content';

const allNews = await getCollection('news');
const latestNews = allNews.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);
const b = import.meta.env.BASE_URL.replace(/\/$/, '');

const useCases = [
  { icon: '⚡', title: 'High Power Electronics',       desc: 'Ultra-pure crystals for next-generation power semiconductors — fewer defects, higher breakdown voltage.' },
  { icon: '🔭', title: 'Optics & Lasers',              desc: 'Defect-free optical crystals enabling more powerful, more precise laser systems across research and industry.' },
  { icon: '📡', title: 'Sensors',                      desc: 'High-purity sensor crystals with superior sensitivity, enabling breakthroughs in detection and measurement.' },
  { icon: '☢',  title: 'Radiation Detectors',          desc: 'Space-grown scintillator crystals for medical imaging, nuclear detection, and scientific instrumentation.' },
  { icon: '⚙',  title: 'Energy & Quantum Technologies', desc: 'Advanced materials for quantum computing and next-generation energy conversion systems.' },
];

const partners = [
  { name: 'ESA',               logo: `${b}/images/partners/partner-esa.png` },
  { name: 'DLR',               logo: `${b}/images/partners/partner-dlr.png` },
  { name: 'BSGN',              logo: `${b}/images/partners/partner-bsgn.jpg` },
  { name: 'Startup Lithuania', logo: `${b}/images/partners/partner-startup-lithuania.png` },
];
---

<Layout title="Levion Materials" description="Crystal growth in orbital microgravity — producing materials with properties impossible to achieve on Earth.">
  <Nav />

  <!-- ── HERO ── -->
  <section class="hero" id="top">
    <div class="hero-bg" style={`background-image: url('${b}/images/hero-crystal.jpg')`}></div>
    <div class="container hero-content">
      <p class="hero-label">Orbital Manufacturing · Advanced Materials</p>
      <h1 class="hero-headline">
        We grow crystals<br />
        the way only space<br />
        makes possible.
      </h1>
      <a href="#mission" class="btn-primary">Explore our technology →</a>
    </div>
    <div class="hero-scroll-hint" aria-hidden="true"><span>↓</span></div>
  </section>

  <!-- ── VISION ── -->
  <section class="section section-teal" id="vision">
    <div class="container">
      <p class="section-label-light">The Vision</p>
      <h2 class="section-title-light">Materials Beyond Gravity</h2>
      <p class="section-sub-light">
        Growing perfect crystals requires an environment Earth cannot provide. Levion Materials is
        dedicated to crystal growth in true microgravity — achievable only in space. The result:
        materials with properties that redefine what technology can do.
      </p>
    </div>
  </section>

  <!-- ── MISSION / USE CASES ── -->
  <section class="section" id="mission">
    <div class="container">
      <p class="section-label">Technology</p>
      <h2 class="section-title">Five core applications</h2>
      <p class="section-sub">
        Many modern technologies rely on crystals. Performance depends on perfection.
        Space-grown crystals deliver what Earth-based processes cannot.
      </p>
      <div class="tech-grid">
        {useCases.map(uc => (
          <div class="tech-card">
            <div class="tech-icon">{uc.icon}</div>
            <h3>{uc.title}</h3>
            <p>{uc.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── THE PROBLEM ── -->
  <section class="section problem-section" id="problem">
    <div class="container careers-layout">
      <div class="careers-text">
        <p class="section-label">The Problem</p>
        <h2 class="section-title">Gravity is the bottleneck</h2>
        <p>On Earth, gravity constantly acts on molten materials during crystal growth — introducing defects that cannot be avoided no matter how sophisticated the equipment.</p>
        <ul class="value-list">
          <li><span class="value-num">—</span><span>Uneven composition during solidification</span></li>
          <li><span class="value-num">—</span><span>Internal mechanical stress</span></li>
          <li><span class="value-num">—</span><span>Crystallographic defects from convective forces</span></li>
          <li><span class="value-num">—</span><span>Inability to reach macroscopically level atomic alignment</span></li>
        </ul>
        <p class="italic-note">Even in the best laboratories, gravity cannot be switched off.</p>
      </div>
      <div class="careers-values">
        <div class="value-item">
          <span class="value-num">01</span>
          <h4>Stable composition</h4>
          <p>Without gravity-driven convection, material distribution during crystal growth is uniform from edge to core.</p>
        </div>
        <div class="value-item">
          <span class="value-num">02</span>
          <h4>Fewer structural defects</h4>
          <p>The absence of buoyancy forces means fewer dislocations, inclusions, and stress-induced cracks.</p>
        </div>
        <div class="value-item">
          <span class="value-num">03</span>
          <h4>More uniform growth</h4>
          <p>Crystals form predictably and symmetrically — enabling geometries and purities impossible on Earth.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── GROOVE TRACTION ── -->
  <section class="section section-teal" id="groove">
    <div class="container careers-layout">
      <div class="careers-text">
        <p class="section-label-light">Traction</p>
        <h2 class="section-title-light">GROOVE</h2>
        <p class="groove-sub">Growth Parameter Observation &amp; Validation Experiment</p>
        <p class="section-sub-light" style="margin-top:1rem;">
          Levion's first in-space materials mission, developed within the ESA Business in Space Growth
          Network (BSGN) Advanced Materials and In-orbit Manufacturing Industry Accelerator.
          Flight hardware in preparation. Microgravity crystal growth proven.
        </p>
        <a href={`${b}/news`} class="btn-outline-light" style="margin-top:1.5rem; display:inline-block;">Read the news →</a>
      </div>
      <div class="groove-visual">
        <img src={`${b}/images/groove-mission.jpg`} alt="GROOVE mission orbital setup" class="groove-img" />
      </div>
    </div>
  </section>

  <!-- ── PARTNERS ── -->
  <section class="section partners-section">
    <div class="container">
      <p class="section-label">Partners &amp; Supporters</p>
      <div class="partners-grid">
        {partners.map(p => (
          <div class="partner-logo">
            <img src={p.logo} alt={p.name} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── NEWS ── -->
  <section class="section" id="news">
    <div class="container">
      <p class="section-label">Latest</p>
      <div class="news-header">
        <h2 class="section-title">News</h2>
        <a href={`${b}/news`} class="news-all-link">All news →</a>
      </div>
      <div class="news-grid">
        {latestNews.map(post => (
          <NewsCard title={post.data.title} date={post.data.date} summary={post.data.summary} slug={post.slug} image={post.data.image} />
        ))}
      </div>
    </div>
  </section>

  <!-- ── CONTACT ── -->
  <section class="section" id="contact">
    <div class="container contact-layout">
      <div class="contact-info">
        <p class="section-label">Get in touch</p>
        <h2 class="section-title">Contact us</h2>
        <p class="contact-address">Levion Materials GmbH<br />Vilnius, Lithuania</p>
        <a href="mailto:info@levion-materials.com" class="contact-email">info@levion-materials.com</a>
      </div>
      <form class="contact-form" action="https://formspree.io/f/placeholder" method="POST">
        <div class="form-row">
          <div class="form-group"><label for="fname">First name</label><input id="fname" name="fname" type="text" required placeholder="Philipp" /></div>
          <div class="form-group"><label for="lname">Last name</label><input id="lname" name="lname" type="text" required placeholder="Bauer" /></div>
        </div>
        <div class="form-group"><label for="email">Work email</label><input id="email" name="email" type="email" required placeholder="you@organization.com" /></div>
        <div class="form-group"><label for="org">Organization</label><input id="org" name="organization" type="text" placeholder="Your organization" /></div>
        <div class="form-group">
          <label for="inquiry">Inquiry type</label>
          <select id="inquiry" name="inquiry">
            <option value="">Select one…</option>
            <option>Partnership</option><option>Investment</option>
            <option>Research Collaboration</option><option>Press &amp; Media</option>
            <option>Career</option><option>Other</option>
          </select>
        </div>
        <div class="form-group"><label for="message">Message</label><textarea id="message" name="message" rows="5" required placeholder="Tell us about your interest…"></textarea></div>
        <button type="submit" class="btn-primary">Send message →</button>
      </form>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .container { max-width:1200px; margin:0 auto; padding:0 2rem; }
  .section { padding:6rem 0; }

  .section-label { font-family:var(--font-head); font-size:.75rem; font-weight:600; letter-spacing:.12em; text-transform:uppercase; color:var(--accent); margin-bottom:.75rem; }
  .section-label-light { font-family:var(--font-head); font-size:.75rem; font-weight:600; letter-spacing:.12em; text-transform:uppercase; color:rgba(255,255,255,.6); margin-bottom:.75rem; }
  .section-title { font-size:clamp(1.75rem,3vw,2.5rem); font-weight:700; color:var(--text); margin-bottom:1.25rem; }
  .section-title-light { font-size:clamp(1.75rem,3vw,2.5rem); font-weight:700; color:#fff; margin-bottom:1.25rem; }
  .section-sub { font-size:1.0625rem; color:var(--text-muted); max-width:620px; margin-bottom:3rem; line-height:1.7; }
  .section-sub-light { font-size:1.0625rem; color:rgba(255,255,255,.8); max-width:620px; line-height:1.7; }

  .btn-primary { display:inline-block; background:var(--accent); color:#fff; font-family:var(--font-head); font-weight:600; font-size:.9375rem; padding:.75rem 1.75rem; border-radius:var(--radius); border:none; cursor:pointer; transition:background .2s,transform .2s; }
  .btn-primary:hover { background:var(--accent-dark); transform:translateY(-1px); }
  .btn-outline-light { color:#fff; font-family:var(--font-head); font-weight:600; font-size:.9375rem; padding:.7rem 1.75rem; border-radius:var(--radius); border:1px solid rgba(255,255,255,.5); transition:border-color .2s; }
  .btn-outline-light:hover { border-color:#fff; }

  /* Hero */
  .hero { position:relative; min-height:100vh; display:flex; align-items:center; overflow:hidden; }
  .hero-bg { position:absolute; inset:0; background-size:cover; background-position:center 30%; }
  .hero-bg::after { content:''; position:absolute; inset:0; background:linear-gradient(to bottom, rgba(15,14,13,.6) 40%, var(--bg) 100%); }
  .hero-content { position:relative; z-index:1; padding-top:6rem; padding-bottom:4rem; }
  .hero-label { font-family:var(--font-head); font-size:.75rem; font-weight:600; letter-spacing:.12em; text-transform:uppercase; color:var(--accent); margin-bottom:1.5rem; }
  .hero-headline { font-size:clamp(2.25rem,5.5vw,4.25rem); font-weight:700; line-height:1.1; letter-spacing:-.03em; color:var(--text); margin-bottom:2.5rem; max-width:700px; }
  .hero-scroll-hint { position:absolute; bottom:2rem; left:50%; transform:translateX(-50%); color:var(--text-muted); font-size:1.25rem; animation:bounce 2s infinite; }
  @keyframes bounce { 0%,100% { transform:translateX(-50%) translateY(0); } 50% { transform:translateX(-50%) translateY(8px); } }

  /* Teal section (Vision + Groove) */
  .section-teal { background:var(--teal); }

  /* Tech grid */
  .tech-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; }
  @media (max-width:900px) { .tech-grid { grid-template-columns:1fr; } }
  .tech-card { background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius); padding:2rem; transition:border-color .2s; }
  .tech-card:hover { border-color:var(--accent); }
  .tech-icon { font-size:1.75rem; margin-bottom:1rem; }
  .tech-card h3 { font-size:1.0625rem; font-weight:600; margin-bottom:.75rem; color:var(--text); }
  .tech-card p { font-size:.9375rem; color:var(--text-muted); line-height:1.7; }

  /* Problem + Groove two-col layout (reuse careers pattern) */
  .careers-layout { display:grid; grid-template-columns:1fr 1fr; gap:5rem; align-items:start; }
  @media (max-width:800px) { .careers-layout { grid-template-columns:1fr; gap:3rem; } }
  .careers-text p { color:var(--text-muted); margin-bottom:1rem; line-height:1.7; }
  .value-list { list-style:none; display:flex; flex-direction:column; gap:.85rem; margin:1.25rem 0; }
  .value-list li { display:flex; gap:.75rem; font-size:1rem; color:var(--text-muted); }
  .italic-note { font-style:italic; font-size:.9375rem; color:var(--text-dim); }
  .careers-values { display:flex; flex-direction:column; gap:2rem; }
  .value-item { border-left:2px solid var(--accent); padding-left:1.25rem; }
  .value-num { font-family:var(--font-head); font-size:.75rem; font-weight:700; letter-spacing:.08em; color:var(--accent); display:block; margin-bottom:.25rem; }
  .value-item h4 { font-size:.9375rem; font-weight:600; margin-bottom:.5rem; color:var(--text); }
  .value-item p { font-size:.875rem; color:var(--text-muted); line-height:1.6; }

  /* Groove */
  .groove-sub { font-family:var(--font-head); font-size:1rem; color:rgba(255,255,255,.65); font-weight:500; }
  .groove-img { width:100%; border-radius:var(--radius); object-fit:cover; aspect-ratio:4/3; }

  /* Partners */
  .partners-section { padding:4rem 0; border-top:1px solid var(--border); border-bottom:1px solid var(--border); }
  .partners-grid { display:flex; flex-wrap:wrap; align-items:center; gap:2.5rem 3.5rem; margin-top:2rem; }
  .partner-logo img { height:36px; width:auto; object-fit:contain; filter:brightness(0) invert(1); opacity:.5; transition:opacity .2s; }
  .partner-logo:hover img { opacity:.9; }

  /* News */
  .news-header { display:flex; align-items:baseline; justify-content:space-between; margin-bottom:2.5rem; }
  .news-header .section-title { margin-bottom:0; }
  .news-all-link { font-family:var(--font-head); font-size:.875rem; font-weight:500; color:var(--accent); transition:color .2s; }
  .news-all-link:hover { color:var(--text); }
  .news-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1.5rem; }
  @media (max-width:900px) { .news-grid { grid-template-columns:repeat(2,1fr); } }
  @media (max-width:580px) { .news-grid { grid-template-columns:1fr; } }

  /* Contact */
  .contact-layout { display:grid; grid-template-columns:1fr 1.6fr; gap:5rem; align-items:start; }
  @media (max-width:800px) { .contact-layout { grid-template-columns:1fr; gap:3rem; } }
  .contact-address { color:var(--text-muted); line-height:1.8; margin-top:1.5rem; margin-bottom:.75rem; }
  .contact-email { color:var(--accent); font-family:var(--font-head); font-size:.9375rem; transition:color .2s; }
  .contact-email:hover { color:var(--text); }
  .contact-form { display:flex; flex-direction:column; gap:1.25rem; }
  .form-row { display:grid; grid-template-columns:1fr 1fr; gap:1.25rem; }
  @media (max-width:800px) { .form-row { grid-template-columns:1fr; } }
  .form-group { display:flex; flex-direction:column; gap:.4rem; }
  .form-group label { font-family:var(--font-head); font-size:.8125rem; font-weight:500; color:var(--text-muted); letter-spacing:.02em; }
  .form-group input, .form-group select, .form-group textarea { background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius); color:var(--text); font-family:var(--font-body); font-size:.9375rem; padding:.65rem .875rem; outline:none; transition:border-color .2s; resize:vertical; }
  .form-group input::placeholder, .form-group textarea::placeholder { color:var(--text-muted); opacity:.6; }
  .form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color:var(--accent); }
  .form-group select option { background:var(--bg-card); }
</style>
