---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const members = [
  { name: 'Dr. Philipp Bauer',    role: 'Founder & CEO',            photo: `${b}/images/team/team-philipp.png` },
  { name: 'Dr. Tina Sorgenfrei', role: 'Chief Material Scientist',  photo: `${b}/images/team/team-tina.png` },
  { name: 'Jonas Radtke',         role: 'VP Operations',             photo: `${b}/images/team/team-jonas.png` },
  { name: 'Dmitrii Tarabashchuk', role: 'System Analysis Engineer',  photo: `${b}/images/team/team-dmitrii.png` },
  { name: 'Charlotte Frey',       role: 'Team Assistant & HR',       photo: `${b}/images/team/team-charlotte.png` },
  { name: 'Peppa Pig',            role: 'Chief Snorting Officer',    photo: `${b}/images/team/team-peppa.png` },
];
---
<Layout title="Team" description="Meet the Levion Materials team — experts in space manufacturing, crystal growth, and orbital systems.">
  <Nav />
  <main class="main">
    <div class="container">
      <header class="page-header">
        <p class="section-label">Our People</p>
        <h1 class="page-title">The Team</h1>
        <p class="page-sub">A compact team of scientists and engineers building the future of orbital manufacturing.</p>
      </header>
      <div class="team-grid">
        {members.map(m => (
          <article class="member-card">
            <div class="member-photo-wrap">
              <img src={m.photo} alt={m.name} class="member-photo" />
            </div>
            <h2 class="member-name">{m.name}</h2>
            <p class="member-role">{m.role}</p>
          </article>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>
<style>
  .container { max-width:1200px; margin:0 auto; padding:0 2rem; }
  .main { padding-top:7rem; padding-bottom:6rem; min-height:80vh; }
  .page-header { margin-bottom:4rem; }
  .section-label { font-family:var(--font-head); font-size:.75rem; font-weight:600; letter-spacing:.12em; text-transform:uppercase; color:var(--accent); margin-bottom:.75rem; }
  .page-title { font-size:clamp(2rem,4vw,3rem); font-weight:700; color:var(--text); margin-bottom:.75rem; }
  .page-sub { font-size:1.0625rem; color:var(--text-muted); max-width:52ch; line-height:1.7; }
  .team-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:2.5rem; }
  @media (max-width:900px) { .team-grid { grid-template-columns:repeat(2,1fr); } }
  @media (max-width:520px) { .team-grid { grid-template-columns:1fr; } }
  .member-card { display:flex; flex-direction:column; align-items:center; text-align:center; }
  .member-photo-wrap { width:clamp(140px,18vw,180px); aspect-ratio:1/1; border-radius:50%; overflow:hidden; background:var(--bg-card); border:1px solid var(--border); margin-bottom:1.25rem; transition:border-color .2s; }
  .member-card:hover .member-photo-wrap { border-color:var(--accent); }
  .member-photo { width:100%; height:100%; object-fit:cover; object-position:center top; }
  .member-name { font-family:var(--font-head); font-size:1rem; font-weight:600; color:var(--text); margin-bottom:.25rem; }
  .member-role { font-size:.875rem; color:var(--accent); }
</style>
