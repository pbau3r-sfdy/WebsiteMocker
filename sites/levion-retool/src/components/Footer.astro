---
import { SOCIALS, SITE, COMPANY, NEWSLETTER_ACTION } from '../data/site';
const live = !NEWSLETTER_ACTION.startsWith('REPLACE');
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<footer class="footer">
  <div class="inner">
    <div class="brand">
      <a href={`${b}/`}><img src={`${b}/images/logo-footer.png`} alt="Levion Materials" width="173" height="97" /></a>
      <nav aria-label="Footer">
        <a href={`${b}/imprint`}>IMPRINT</a>
        <a href={`${b}/contact`}>CONTACT</a>
        <a href={`${b}/privacy-policy`}>PRIVACY POLICY</a>
      </nav>
      <nav aria-label="Social media" class="social">
        {SOCIALS.map(sn => <a href={sn.href} target="_blank" rel="me noopener">{sn.label.toUpperCase()}</a>)}
      </nav>
    </div>
    <form class="news" action={live ? NEWSLETTER_ACTION : '#'} method="post" target={live ? '_blank' : undefined} onsubmit={live ? undefined : 'return false'}>
      <h2>NEWSLETTER</h2>
      <p>Subscribe for the Levion newsletter.</p>
      <label for="nl-email">E-Mail address <span aria-hidden="true">*</span></label>
      <input id="nl-email" type="email" name="EMAIL" required autocomplete="email" />
      <button type="submit">Subscribe</button>
    </form>
  </div>
  <p class="legal wrap">© {new Date().getFullYear()} {COMPANY.name} · {SITE.division}</p>
</footer>

<style>
  .footer { background: #fff; padding: 56px 0 72px; }
  .inner { max-width: 1000px; margin: 0 auto; padding: 0 24px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .brand nav { display: flex; flex-direction: column; margin-top: 18px; gap: 4px; }
  .brand nav a { text-decoration: none; letter-spacing: .08em; font-size: 14px; }
  .brand nav a:hover { color: var(--orange); }
  .brand .social { margin-top: 14px; }
  .legal { margin: 48px auto 0; font-size: 12px; letter-spacing: .04em; color: var(--text-soft); }
  .news h2 { font-family: var(--font-head); font-size: 16px; letter-spacing: .16em; font-weight: 700; }
  .news p { margin: 14px 0 22px; letter-spacing: .03em; }
  .news label { display: block; font-size: 14px; margin-bottom: 8px; }
  .news input { width: 100%; max-width: 405px; height: 40px; border: 1px solid #000; border-radius: 6px; padding: 0 12px; font: inherit; }
  .news button { display: block; margin-top: 18px; background: #000; color: #fff; border: 0; border-radius: 6px; width: 240px; height: 40px; font: inherit; cursor: pointer; }
  .news button:hover { background: var(--teal); }
  @media (max-width: 720px) { .inner { grid-template-columns: 1fr; } }
</style>
