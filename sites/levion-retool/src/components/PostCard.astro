---
import type { CollectionEntry } from 'astro:content';
interface Props { post: CollectionEntry<'news'>; compact?: boolean; }
const { post, compact = false } = Astro.props;
const d = post.data;
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const dateLabel = d.date.toLocaleDateString('de-DE', { day: 'numeric', month: 'short', timeZone: 'UTC' }).replace(/\.$/, '.');
---
<article class:list={['card', { compact }]}>
  <a href={`${b}/post/${post.id}`} class="media"><img src={`${b}/images/${d.thumb}`} alt={d.title} width="292" height="219" /></a>
  <div class="body">
    <div class="meta">
      <img src={`${b}/images/author-avatar.png`} alt="" width="28" height="28" />
      <div><div>Levion Materials</div><div class="sub">{dateLabel} · {d.readTime}</div></div>
    </div>
    <h3><a href={`${b}/post/${post.id}`}>{d.title}</a></h3>
    {!compact && <p class="excerpt">{d.excerpt}</p>}
    <div class="foot"><span class="like" aria-label={`${d.likes} likes`}>{d.likes > 0 && <span class="n">{d.likes}</span>}<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 20.5s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.6a4.3 4.3 0 0 1 7.5 2.7c0 5.600-7.500 10.200-7.500 10.200z" fill="none" stroke="#e0425b" stroke-width="1.6" stroke-linejoin="round"/></svg></span></div>
  </div>
</article>

<style>
  .card { border: 1px solid #d6d6d6; background: #fff; width: 100%; max-width: 292px; display: flex; flex-direction: column; }
  .media img { width: 100%; height: auto; aspect-ratio: 292 / 219; object-fit: cover; }
  .body { padding: 20px 24px 16px; display: flex; flex-direction: column; flex: 1; }
  .meta { display: flex; gap: 10px; align-items: center; font-size: 12px; line-height: 1.35; }
  .meta img { border-radius: 50%; width: 28px; height: 28px; }
  .sub { color: #555; }
  h3 { font-size: 21px; line-height: 1.3; margin: 14px 0 12px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  h3 a { text-decoration: none; }
  .excerpt { font-size: 14px; line-height: 1.7; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; margin-bottom: 20px; }
  .foot { margin-top: auto; border-top: 1px solid #ccc; padding-top: 14px; display: flex; justify-content: flex-end; }
  .like { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; }
  .compact h3 { font-size: 16px; -webkit-line-clamp: 2; margin: 0 0 10px; }
  .compact .meta { display: none; }
  .compact .body { padding-top: 16px; }
</style>
