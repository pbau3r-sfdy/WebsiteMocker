---
interface Props { active?: 'home' | 'team' | 'news' | 'careers' | 'contact' | ''; }
const { active = '' } = Astro.props;
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  { key: 'home',    label: 'HOME',    href: `${b}/` },
  { key: 'team',    label: 'TEAM',    href: `${b}/team` },
  { key: 'news',    label: 'NEWS',    href: `${b}/news` },
  { key: 'careers', label: 'CAREERS', href: `${b}/careers` },
  { key: 'contact', label: 'CONTACT', href: `${b}/contact` },
];
---
<header class="nav">
  <div class="inner">
    <a href={`${b}/`} class="logo" aria-label="Levion Materials"><img src={`${b}/images/logo-nav.png`} alt="Levion" width="97" height="53" /></a>
    <nav aria-label="Main">
      {links.map(l => <a href={l.href} class:list={['link', { active: l.key === active }]} aria-current={l.key === active ? 'page' : undefined}>{l.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .nav { background: #fff; position: relative; z-index: 10; }
  .inner { max-width: 1000px; margin: 0 auto; padding: 14px 24px 0; display: flex; justify-content: space-between; align-items: center; min-height: 92px; }
  nav { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
  .link { font-family: var(--font-ui); font-size: 14px; letter-spacing: .06em; color: var(--link); text-decoration: none; padding: 8px 13px 6px; border-top: 1px solid transparent; }
  .link:hover { color: var(--orange); }
  .link.active { color: var(--orange); border-top-color: var(--orange); }
  @media (max-width: 640px) { .inner { flex-direction: column; align-items: flex-start; gap: 4px; padding-bottom: 8px; } nav { justify-content: flex-start; } .link { padding: 6px 10px 4px 0; } }
</style>
