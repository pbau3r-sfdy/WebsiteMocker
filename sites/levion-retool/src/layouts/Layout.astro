---
import { SITE, COMPANY, SOCIALS, assertLaunchReady } from '../data/site';

interface Props { title: string; description?: string; ogImage?: string; }
const { title, description = 'Levion Materials grows crystals in orbital microgravity. Advanced materials made in space.', ogImage = 'images/hero-crystal.png' } = Astro.props;
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
assertLaunchReady(b);
const site = (Astro.site ?? new URL(SITE.url)).origin;
const canonical = new URL(Astro.url.pathname, site).href;
const image = `${site}${b}/${ogImage}`;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.name, url: SITE.url },
  {
    '@context': 'https://schema.org', '@type': 'Organization', name: SITE.name, url: SITE.url,
    description: SITE.division,
    parentOrganization: { '@type': 'Organization', name: COMPANY.name, url: 'https://www.starflight-dynamics.com' },
    logo: `${site}${b}/images/logo.png`,
    sameAs: SOCIALS.map(s => s.href),
    address: { '@type': 'PostalAddress', streetAddress: COMPANY.street, postalCode: COMPANY.postcode, addressLocality: COMPANY.city, addressCountry: 'DE' },
  },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{title} | {SITE.name}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/png" href={`${b}/favicon.png`} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={`${title} | ${SITE.name}`} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={image} />
  <meta name="twitter:card" content="summary_large_image" />
  <style set:html={`
    @font-face { font-family: 'Utendo'; src: url('${b}/fonts/utendo-bold.woff2') format('woff2'); font-weight: 700; font-display: swap; }
    @font-face { font-family: 'Sarabun'; src: url('${b}/fonts/sarabun.woff2') format('woff2'); font-weight: 300 400; font-display: swap; }
  `}></style>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <slot name="head" />
</head>
<body>
  <slot />
</body>
</html>

<style is:global>
  :root {
    /* Levion brand */
    --orange: #d96502;
    --rust:   #b74101;
    --teal:   #043c53;
    --link:   #055f84;
    --ink:    #000;
    --paper:  #fff;
    --grey:   #d3d7db;
    --wrap:   980px;
    --font-body: 'Sarabun', 'Helvetica Neue', Arial, sans-serif;
    --font-head: 'Utendo', 'Helvetica Neue', Arial, sans-serif;
    --font-ui:   'Helvetica Neue', Helvetica, Arial, sans-serif;   /* nav and job titles use Arial/Helvetica on the original */

    /* Tokens the SFDY job template reads, mapped to Levion's light theme. */
    --accent:         var(--rust);      /* AA-contrast text accent on light backgrounds */
    --on-accent:      #fff;
    --bg-base:        #fff;
    --surface-1:      #f4f6f8;
    --text-primary:   #000;
    --text-secondary: rgba(0,0,0,.78);
    --text-soft:      rgba(0,0,0,.62);
    --text-muted:     rgba(0,0,0,.52);
    --ink-90:         rgba(0,0,0,.88);
    --ink-08:         rgba(0,0,0,.09);
    --border-subtle:  rgba(0,0,0,.14);
    --border-strong:  rgba(0,0,0,.30);
    --beam:           linear-gradient(180deg, var(--teal) 0%, var(--link) 40%, var(--orange) 100%);
    --font-display:   var(--font-head);
    --font-mono:      ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    --gutter:         clamp(20px, 5vw, 72px);
    --ls-eyebrow:     .34em;
    --sfdy-magenta:   #c4004f;
    --ease:           cubic-bezier(.2,.6,.2,1);
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--font-body); font-weight: 300; font-size: 16px; line-height: 1.6; -webkit-font-smoothing: antialiased; }
  img { max-width: 100%; display: block; }
  a { color: inherit; text-decoration: none; }
  h1, h2, h3, h4 { font-family: var(--font-head); font-weight: 700; line-height: 1.15; margin: 0; }
  p { margin: 0 0 1em; }
  ul, ol { margin: 0; padding: 0; }
  dl, dd { margin: 0; }
  .wrap { max-width: var(--wrap); margin: 0 auto; padding: 0 24px; }
  .label { font-family: var(--font-head); font-weight: 700; font-size: 11px; letter-spacing: .22em; text-transform: uppercase; color: var(--link); margin: 0 0 14px; }
  .sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  :focus-visible { outline: 2px solid var(--orange); outline-offset: 2px; }
</style>
