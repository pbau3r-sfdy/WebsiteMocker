---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Prose from '../../components/Prose.astro';
import PostCard from '../../components/PostCard.astro';

export async function getStaticPaths() {
  const posts = await getCollection('news');
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const d = post.data;
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
await render(post);
const html = (post.rendered?.html ?? '').replaceAll('%BASE%', b);
const dateLabel = d.date.toLocaleDateString('de-DE', { day: 'numeric', month: 'short', timeZone: 'UTC' });
const others = (await getCollection('news')).filter(p => p.id !== post.id);
const share = [
  { n: 'Facebook', d: 'M14 8V6.5c0-.7.2-1 1.100-1H17V2h-2.800C11.200 2 10 3.700 10 6v2H8v3.500h2V22h4v-10.500h2.700L17 8h-3z' },
  { n: 'X',        d: 'M3 3l7.500 10L3 21h2l6.400-6.900L16.500 21H21l-7.800-10.400L20 3h-2l-5.900 6.400L7.600 3H3zm3 1.400h1.300l10.700 15.200h-1.300L6 4.400z' },
  { n: 'LinkedIn', d: 'M4 9h3.500v11H4V9zm1.700-5.500a2 2 0 1 1 0 4 2 2 0 0 1 0-4zM10 9h3.300v1.600c.5-.9 1.700-1.900 3.500-1.900 3.600 0 4.200 2.400 4.200 5.400V20h-3.500v-5.200c0-1.300 0-2.900-1.800-2.900s-2.100 1.400-2.100 2.800V20H10V9z' },
  { n: 'Link',     d: 'M10.600 13.400a1 1 0 0 1 0-1.400l3.400-3.400a3 3 0 1 1 4.200 4.200l-1.700 1.700-1.400-1.400 1.700-1.700a1 1 0 0 0-1.400-1.400L12 13.400a1 1 0 0 1-1.400 0zM13.400 10.600a1 1 0 0 1 0 1.400L10 15.400a3 3 0 1 1-4.200-4.200l1.700-1.700 1.400 1.400-1.700 1.700a1 1 0 0 0 1.400 1.400L12 11a1 1 0 0 1 1.400 0z' },
];
---
<Layout title={d.title} description={d.excerpt.slice(0, 160)}>
  <Nav active="news" />
  <main class="wrap">
    <p class="crumb"><a href={`${b}/news`}>All Posts</a></p>
    <article class="post">
      <div class="inner">
        <div class="meta">
          <img src={`${b}/images/author-avatar.png`} alt="" width="26" height="26" />
          <span>Levion Materials · {dateLabel} · {d.readTime}</span>
        </div>
        <h1>{d.title}</h1>
        {d.updated && <p class="updated">{d.updated}</p>}
        <Prose><Fragment set:html={html} /></Prose>
        <div class="share">
          <ul>{share.map(s => <li><a href="#" aria-label={`Share on ${s.n}`}><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d={s.d} fill="currentColor" /></svg></a></li>)}</ul>
        </div>
        <div class="likes">{d.likes > 0 && <span>{d.likes}</span>}<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 20.5s-7.500-4.600-7.500-10.200A4.300 4.300 0 0 1 12 7.600a4.300 4.300 0 0 1 7.500 2.700c0 5.600-7.500 10.200-7.500 10.200z" fill="none" stroke="#e0425b" stroke-width="1.600" stroke-linejoin="round"/></svg></div>
      </div>
    </article>
    {others.length > 0 && (
      <section class="recent">
        <div class="head"><h2>Aktuelle Beiträge</h2><a href={`${b}/news`}>Alle ansehen</a></div>
        <div class="grid">{others.map(p => <PostCard post={p} compact />)}</div>
      </section>
    )}
  </main>
  <Footer />
</Layout>

<style>
  main { max-width: 1000px; padding-top: 60px; padding-bottom: 70px; }
  .crumb { font-size: 12px; margin: 0 0 32px; }
  .crumb a { text-decoration: none; }
  .post { border: 1px solid #d6d6d6; padding: 56px 0 28px; }
  .inner { max-width: 640px; margin: 0 auto; padding: 0 24px; }
  .meta { display: flex; align-items: center; gap: 10px; font-size: 12px; margin-bottom: 18px; }
  .meta img { border-radius: 50%; }
  h1 { font-size: clamp(26px, 3.4vw, 36px); line-height: 1.25; margin-bottom: 18px; }
  .updated { font-size: 11px; margin-bottom: 36px; }
  .inner :global(.prose p), .inner :global(.prose li) { font-size: 14px; line-height: 1.75; max-width: none; }
  .inner :global(.prose p) { margin-bottom: 1.1em; }
  .inner :global(.prose img) { width: 100%; height: auto; margin: 8px 0 32px; }
  .inner :global(.prose h3) { font-size: 16px; margin: 28px 0 8px; }
  .share { border-top: 1px solid #ccc; border-bottom: 1px solid #ccc; margin-top: 44px; padding: 14px 0; }
  .share ul { list-style: none; display: flex; gap: 22px; margin: 0; padding: 0; }
  .share a { color: #000; }
  .likes { display: flex; justify-content: flex-end; align-items: center; gap: 6px; font-size: 12px; padding-top: 18px; }
  .recent { margin-top: 36px; }
  .head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 14px; }
  .head h2 { font-size: 14px; font-family: var(--font-body); font-weight: 400; }
  .head a { font-size: 11px; text-decoration: none; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 210px)); gap: 24px; }
</style>
