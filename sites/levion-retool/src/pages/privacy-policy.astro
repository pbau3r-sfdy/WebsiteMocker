---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { COMPANY, EMAIL, SOCIALS } from '../data/site';

const addr = `Levion Materials c/o ${COMPANY.name}, ${COMPANY.street}, ${COMPANY.postcode} ${COMPANY.city}, ${COMPANY.country}`;
const SECTIONS: [string, string[]][] = [
  ['Controller', [`${addr}, ${EMAIL.general}. Levion Materials is the Special Materials division of ${COMPANY.name}.`]],
  ['Hosting and server logs', ['This website is hosted on GitHub Pages, a service of GitHub, Inc., San Francisco, USA. When you visit it, GitHub logs your IP address for security purposes, together with technical data such as the page requested and your browser type. GitHub is certified under the EU–US Data Privacy Framework. We have no access to these logs beyond what GitHub provides; see GitHub’s privacy statement for retention. Legal basis: Art. 6 (1)(f) GDPR (legitimate interest in a secure, reliable website).']],
  ['Cookies and fonts', ['This website sets no cookies. All fonts are hosted on our own server; your browser does not connect to third-party font services.']],
  ['Contact form and email', ['If you write to us, we process your name, email address and message to answer you. The contact form is transmitted through Web3Forms, acting as our processor. Legal basis: Art. 6 (1)(b) GDPR where your message concerns a contract, otherwise Art. 6 (1)(f) GDPR. We delete the data when your request is settled, unless retention periods apply.']],
  ['Newsletter', ['If you subscribe, we process your email address to send Levion Materials news and announcements. We use Mailchimp (The Rocket Science Group LLC, Atlanta, USA), certified under the EU–US Data Privacy Framework. Subscription uses double opt-in; we record the time of sign-up and confirmation as proof. Legal basis: Art. 6 (1)(a) GDPR. You can withdraw consent at any time through the unsubscribe link in every newsletter.']],
  ['Applications', ['If you apply, we process the data you send (CV, cover letter, contact details) to assess your application. Legal basis: Art. 6 (1)(b) GDPR. If we do not hire you, we delete your data six months after the decision, unless you agree to a longer retention for future positions.']],
  ['Social media', [`We link to our profiles on ${SOCIALS.map(s => s.label).join(' and ')}. These are plain links: no data reaches these platforms until you click them.`]],
  ['Your rights', [`You have the right to access (Art. 15 GDPR), rectification (Art. 16), erasure (Art. 17), restriction of processing (Art. 18), data portability (Art. 20) and objection (Art. 21). You can withdraw consent at any time with effect for the future (Art. 7 (3)). Write to ${EMAIL.general}.`, 'You may also complain to a supervisory authority. For Starflight Dynamics GmbH this is the Bayerisches Landesamt für Datenschutzaufsicht (BayLDA), Ansbach.']],
  ['Automated decisions', ['We make no decisions based solely on automated processing, including profiling.']],
  ['Changes', ['We update this policy when the website or the law changes. Version: 26 October 2026.']],
];
const sections = SECTIONS.map(([title, paras], i) => ({ id: `s${i + 1}`, n: String(i + 1).padStart(2, '0'), title, paras }));
---
<Layout title="Privacy Policy" description="How Levion Materials, a division of Starflight Dynamics GmbH, processes personal data.">
  <Nav />
  <main class="wrap">
    <p class="label">Legal</p>
    <h1>Privacy Policy</h1>
    <div class="cols">
      <nav aria-label="Contents" class="toc">
        <div class="k">Contents</div>
        {sections.map(s => <a href={`#${s.id}`}><span class="n">{s.n}</span><span>{s.title}</span></a>)}
      </nav>
      <article>
        {sections.map(s => (
          <section id={s.id}>
            <h2><span class="n">{s.n}</span>{s.title}</h2>
            {s.paras.map(t => <p>{t}</p>)}
          </section>
        ))}
      </article>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  main { max-width: 1100px; padding-top: 64px; padding-bottom: 96px; }
  h1 { font-size: clamp(34px, 5vw, 52px); text-transform: uppercase; margin-bottom: 40px; }
  .cols { display: flex; flex-wrap: wrap; gap: 48px 64px; align-items: flex-start; border-top: 1px solid var(--border-strong); padding-top: 48px; }
  .toc { flex: 1 0 220px; max-width: 260px; position: sticky; top: 24px; display: flex; flex-direction: column; }
  .k { padding-bottom: 10px; font-family: var(--font-head); font-size: 10px; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; color: var(--text-muted); }
  .toc a { display: grid; grid-template-columns: 28px minmax(0, 1fr); padding: 7px 0; border-top: 1px solid var(--ink-08); font-size: 14px; text-decoration: none; color: var(--text-secondary); }
  .toc a:hover { color: var(--accent); }
  .n { font-family: var(--font-mono); font-size: 12px; font-weight: 400; color: var(--accent); }
  article { flex: 999 1 520px; min-width: 0; max-width: 760px; display: flex; flex-direction: column; gap: 44px; }
  section { display: flex; flex-direction: column; gap: 12px; scroll-margin-top: 24px; }
  h2 { display: flex; gap: 14px; align-items: baseline; font-size: 20px; line-height: 1.25; text-transform: uppercase; }
  h2 .n { font-size: 13px; }
  p { margin: 0; font-size: 16px; line-height: 1.75; color: var(--text-secondary); text-wrap: pretty; }
  @media (max-width: 819px) { .toc { position: static; max-width: 100%; } }
</style>
