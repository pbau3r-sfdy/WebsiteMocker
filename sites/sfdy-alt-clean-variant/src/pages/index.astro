---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Beam from '../components/Beam.astro';
import NewsCard from '../components/NewsCard.astro';
import Newsletter from '../components/Newsletter.astro';
import Footer from '../components/Footer.astro';

const b = import.meta.env.BASE_URL.replace(/\/$/, '');

const posts = (await getCollection('news'))
  .sort((a, z) => z.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Layout description="Technologies for the High Frontier. Site currently under construction.">
  <Nav overlay />

  <section class="hero" style={`background-image:url('${b}/images/hero-orbital-dawn-europe.jpg')`}>
    <Beam />
    <div class="hero-inner">
      <div class="wrap">
        <div class="eyebrow accent">Starflight Dynamics</div>
        <h1><span>Technologies for the</span><span class="green">High Frontier</span></h1>
        <p class="status"><span class="sq" aria-hidden="true"></span>Site under construction</p>
      </div>
      <dl class="wrap facts">
        <div class="facts-row">
          <div><dt>Location</dt><dd>Munich · Germany</dd></div>
          <div><dt>Status</dt><dd>Full site in preparation</dd></div>
          <div><dt>Contact</dt><dd><a href="mailto:mission-control@starflight-dynamics.com">mission-control@starflight-dynamics.com</a></dd></div>
        </div>
      </dl>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="head">
        <div class="eyebrow">Latest news</div>
        <a href={`${b}/news`} class="all mono">All news →</a>
      </div>
      <div class="grid">
        {posts.map(post => (
          <NewsCard
            title={post.data.short ?? post.data.title}
            date={post.data.date}
            id={post.id}
            image={post.data.image}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap partners">
      <div class="eyebrow">Ecosystem partners</div>
      <div class="logos">
        <img src={`${b}/images/partners/bavairia.png`} alt="bavAIRia" class="l-bav" />
        <img src={`${b}/images/partners/bdli-trim.png`} alt="BDLI" class="l-bdli" />
        <img src={`${b}/images/partners/newspace.png`} alt="NewSpace BDI Initiative" class="l-ns" />
      </div>
    </div>
  </section>

  <Newsletter />

  <Footer />
</Layout>

<style>
  .eyebrow { font-size: 12px; font-weight: 700; color: var(--text-secondary); }
  .eyebrow.accent { color: var(--accent); }

  .hero {
    position: relative;
    min-height: clamp(640px, 100vh, 980px);
    display: flex;
    background-color: #000;
    background-position: 62% 30%;
    background-size: cover;
    background-repeat: no-repeat;
  }
  .hero-inner {
    position: relative; flex: 1; min-width: 0;
    display: flex; flex-direction: column; justify-content: flex-start; gap: 40px;
    padding: calc(76px + clamp(28px, 5vh, 56px)) var(--gutter) 40px;
  }
  .hero .wrap { width: 100%; }
  h1 {
    margin-top: 20px;
    font-size: clamp(40px, 6.4vw, 88px); font-weight: 700; line-height: .96;
    letter-spacing: .005em; text-transform: uppercase;
  }
  h1 span { display: block; }
  .green { color: var(--accent); }
  .status {
    margin-top: 28px;
    display: inline-flex; align-items: center; gap: 12px;
    padding: 8px 14px; border: 1px solid var(--border-strong); background: rgba(0,0,0,.4);
    font-size: 11px; font-weight: 700; letter-spacing: .3em; text-transform: uppercase; color: rgba(255,255,255,.80);
  }
  .sq { width: 6px; height: 6px; background: var(--accent); }
  .facts { display: flex; }
  .facts-row { min-width: 0; display: flex; flex-wrap: wrap; gap: 0 56px; border-top: 1px solid var(--border-strong); }
  .facts-row > div { padding-top: 16px; }
  dt { font-size: 10px; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; color: var(--text-soft); }
  dd { margin-top: 6px; font-size: 15px; font-weight: 300; white-space: nowrap; }
  dd a { color: #fff; }
  dd a:hover { color: var(--accent); }

  .block { padding: 80px var(--gutter) 0; }
  .head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding-bottom: 20px; }
  .all { color: var(--accent); white-space: nowrap; letter-spacing: .14em; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; }

  .partners {
    display: flex; flex-wrap: wrap; align-items: center; gap: 32px 64px;
    padding: 36px 0;
    border-top: 1px solid var(--border-subtle); border-bottom: 1px solid var(--border-subtle);
  }
  .partners .eyebrow { flex: none; }
  .logos { flex: 1 1 480px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 32px 48px; }
  .logos img { width: auto; filter: brightness(0) invert(1); opacity: .85; }
  .l-bav { height: 44px; }
  .l-bdli { height: 30px; }
  .l-ns { height: 52px; }

  @media (max-width: 640px) {
    dd { white-space: normal; word-break: break-word; }
    .status { letter-spacing: .16em; }
    .logos { justify-content: flex-start; }
  }
  @media (max-width: 380px) { h1 { font-size: 32px; } }
</style>
