---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Beam from '../components/Beam.astro';
---

<Layout title="Imprint" description="Imprint — Starflight Dynamics GmbH.">
  <Nav />

  <main>
    <header class="hero">
      <Beam thickness={7} />
      <div class="wrap">
        <div class="eyebrow accent">Legal</div>
        <h1>Imprint</h1>
        <p class="lede">Information according to § 5 TMG</p>
      </div>
    </header>

    <section class="body">
      <div class="wrap">
        <dl class="rows">
          <div><dt>Company</dt><dd>Starflight Dynamics GmbH<br />Tal 44<br />D-80331 Munich, Germany</dd></div>
          <div><dt>Register</dt><dd>Amtsgericht München, HRB 282254</dd></div>
          <div><dt>Represented by</dt><dd>Dr. Philipp Bauer, Founder &amp; CEO</dd></div>
          <div><dt>VAT ID</dt><dd>DE360871568</dd></div>
          <div><dt>Contact</dt><dd><a href="mailto:mission-control@starflight-dynamics.com">mission-control@starflight-dynamics.com</a><br />
          Press: <a href="mailto:press@starflight-dynamics.com">press@starflight-dynamics.com</a></dd></div>
          <div><dt>Supervisory authority</dt><dd>Amtsgericht München (District Court Munich)<br />We are not willing or obliged to participate in dispute resolution proceedings before a consumer arbitration board.</dd></div>
          <div><dt>§ 55 Abs. 2 RStV</dt><dd>Responsible for content: Dr. Philipp Bauer<br /><a href="mailto:mission-control@starflight-dynamics.com">mission-control@starflight-dynamics.com</a></dd></div>
          <div><dt>Image copyright</dt><dd>Starflight Dynamics GmbH / Unsplash.com</dd></div>
          <div><dt>Social media</dt><dd>This imprint also applies to the following profiles:<br />
          <a href="https://www.linkedin.com/company/starflight-dynamics/" target="_blank" rel="noreferrer">LinkedIn</a> ·
          <a href="https://x.com/sfdy_space" target="_blank" rel="noreferrer">X</a> ·
          <a href="https://www.instagram.com/starflight_dynamics/" target="_blank" rel="noreferrer">Instagram</a> ·
          <a href="https://www.facebook.com/profile.php?id=100092226416926" target="_blank" rel="noreferrer">Facebook</a></dd></div>
        </dl>

        <div class="disclaimer">
          <div class="d-label">Disclaimer</div>
          <div class="d-text">
            <p>The contents of our pages were created with due care. While we endeavour to keep the information up to date and correct, we assume no liability and make no warranties of any kind, express or implied, about the completeness, accuracy, reliability, suitability or availability with respect to the website or the information, products, services, or related graphics contained on the website for any purpose, as well as for third-party content and linked pages included on our website.</p>
        <p>As a service provider, we are responsible for our own content in accordance with § 7 (1) TMG. According to §§ 8 to 10 TMG, we are not obliged to monitor transmitted or stored third-party information or to research circumstances that indicate illegal activity.</p>
        <p>Every effort is made to keep the website up and running smoothly. However, Starflight Dynamics takes no responsibility for, and will not be liable for, the website being temporarily unavailable due to technical issues beyond our control.</p>
        <p>Our web pages and their contents are subject to German copyright law and may only be reproduced with the prior consent of Starflight Dynamics or of the owner of the respective rights.</p>
        <p class="copy">© Starflight Dynamics GmbH</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .eyebrow { font-size: 12px; font-weight: 700; }
  .eyebrow.accent { color: var(--accent); }
  .hero { position: relative; padding: 104px var(--gutter) 64px; }
  h1 { margin-top: 20px; font-size: clamp(40px, 7vw, 88px); font-weight: 700; line-height: .98; letter-spacing: .005em; text-transform: uppercase; }
  .lede { margin-top: 28px; font-size: 19px; line-height: 1.65; font-weight: 300; color: var(--text-secondary); }

  .body { padding: 0 var(--gutter) 96px; }
  .rows { max-width: 960px; border-top: 1px solid var(--border-strong); }
  .rows > div { display: flex; flex-wrap: wrap; gap: 8px 32px; padding: 20px 0; border-bottom: 1px solid var(--border-subtle); }
  dt { flex: 0 0 220px; padding-top: 5px; font-size: 10px; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; color: var(--text-muted); }
  dd { flex: 1 1 420px; font-size: 16px; line-height: 1.7; font-weight: 300; color: rgba(255,255,255,.85); }
  dd a, .d-text a { color: var(--accent); }

  .disclaimer { margin-top: 72px; max-width: 960px; display: flex; flex-wrap: wrap; gap: 16px 32px; }
  .d-label { flex: 0 0 220px; font-size: 12px; font-weight: 700; letter-spacing: .34em; text-transform: uppercase; color: var(--text-secondary); }
  .d-text { flex: 1 1 420px; display: flex; flex-direction: column; gap: 16px; font-size: 15px; line-height: 1.75; font-weight: 300; color: var(--text-secondary); }
  .d-text p { text-wrap: pretty; }
  .d-text .copy { font-family: var(--font-mono); font-size: 12px; letter-spacing: .06em; color: var(--text-muted); }

  @media (max-width: 560px) { .hero { padding-top: 72px; padding-bottom: 48px; } }
</style>
