---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Beam from '../components/Beam.astro';
import Footer from '../components/Footer.astro';
import { SITES } from '../data/sites';

const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const munich = SITES.munich;

// The Lithuanian entity stays unnamed here (as in the Impressum); it is named
// only on Vilnius positions.
const sites = [
  {
    kicker: '01 · Headquarters', country: 'DE', city: 'Munich', img: 'site-munich.jpg',
    text: 'The headquarters houses systems engineering, orbital and platform technologies, and the propulsion test campaigns of the ReaGAn programme. It is the company’s interface to the Bundeswehr, BAAINBw and the German space ecosystem.',
    foot: `${munich.employer} · ${munich.street} · D-${munich.postcode} ${munich.city}`,
  },
  {
    kicker: '02 · Advanced concepts', country: 'LT', city: 'Vilnius', img: 'site-vilnius.jpg',
    text: 'Established in 2025 through the Startup Lithuania Accelerator, the Vilnius site develops tools, advanced concepts and advanced materials, and prepares operations. It works alongside the sister brand Levion Materials and connects SFDY to the Baltic defence and investor community.',
    foot: 'Lithuanian entity · Vilnius, Lithuania',
  },
];
---

<Layout title="About" description="Starflight Dynamics develops sovereign orbital defence vehicles and their propulsion, from Munich and Vilnius.">
  <Nav active="about" />

  <header class="hero">
    <Beam thickness={7} />
    <div class="wrap hero-grid">
      <div class="hero-title">
        <div class="eyebrow accent">About</div>
        <h1>Sovereign <span class="green">in orbit</span></h1>
      </div>
      <p class="lede">
        Starflight Dynamics is a Munich-based space company developing sovereign orbital defence vehicles
        and the propulsion systems that drive them. Europe depends on space for communication, navigation
        and observation, yet it does not operate the vehicles needed to protect those assets in orbit.
        SFDY builds that capability: manoeuvrable platforms, reactive green propulsion and the materials
        behind them, developed in Germany and Lithuania for European government and defence customers.
      </p>
    </div>
  </header>

  <section class="sites" aria-labelledby="sites">
    <div class="wrap">
      <div class="sec-head">
        <div class="eyebrow" id="sites">Our sites</div>
        <span class="num">{String(sites.length).padStart(2, '0')}</span>
      </div>

      {sites.map((s, i) => (
        <div class:list={['site', { flip: i % 2 === 1 }]}>
          <div class="photo">
            <img src={`${b}/images/${s.img}`} alt={`${s.city} at night`} loading="lazy" />
          </div>
          <div class="copy">
            <div class="kicker"><span class="green">{s.kicker}</span><span>{s.country}</span></div>
            <h2>{s.city}</h2>
            <p>{s.text}</p>
            <div class="foot">{s.foot}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="close">
    <div class="wrap card">
      <div class="card-copy">
        <div class="eyebrow accent">Technologies for the High Frontier</div>
        <h2>Europe’s first line of defence is in space. Join us and <span class="green">build the fleet</span></h2>
      </div>
      <div class="actions">
        <a href={`${b}/jobs`} class="btn solid">Open positions</a>
        <a href={`${b}/contact`} class="btn">Get in touch</a>
      </div>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .eyebrow { font-size: 12px; font-weight: 700; color: var(--text-secondary); }
  .eyebrow.accent { color: var(--accent); }
  .green { color: var(--accent); }

  .hero { position: relative; padding: 104px var(--gutter) 80px; }
  .hero-grid { display: flex; flex-wrap: wrap; gap: 40px 64px; align-items: flex-end; }
  .hero-title { flex: 1 1 520px; min-width: 0; }
  h1 {
    margin-top: 20px;
    font-size: clamp(40px, 7vw, 88px); font-weight: 700; line-height: .98;
    letter-spacing: .005em; text-transform: uppercase; text-wrap: balance;
  }
  .lede { flex: 1 1 440px; max-width: 620px; font-size: 19px; line-height: 1.7; font-weight: 300; color: rgba(255,255,255,.80); text-wrap: pretty; }

  .sites { padding: 0 var(--gutter) 96px; }
  .sec-head {
    display: flex; justify-content: space-between; align-items: baseline; gap: 16px;
    padding-bottom: 12px; border-bottom: 1px solid var(--border-strong);
  }
  .num { font-family: var(--font-mono); font-size: 12px; letter-spacing: .06em; color: var(--text-muted); }
  .site {
    display: flex; flex-wrap: wrap; gap: 32px 64px; align-items: center;
    padding: 48px 0; border-bottom: 1px solid var(--border-subtle);
  }
  .site.flip { flex-direction: row-reverse; }
  .photo {
    flex: 1 1 460px; min-width: 0; aspect-ratio: 3 / 2;
    border: 1px solid var(--border-subtle); background: var(--surface-1); overflow: hidden;
  }
  .photo img { width: 100%; height: 100%; object-fit: cover; }
  .copy { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .kicker {
    display: flex; flex-wrap: wrap; gap: 8px 16px;
    font-family: var(--font-mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--text-muted);
  }
  .copy h2 { font-size: clamp(28px, 4vw, 44px); font-weight: 700; line-height: 1; text-transform: uppercase; }
  .copy p { font-size: 16px; line-height: 1.75; font-weight: 300; color: rgba(255,255,255,.75); text-wrap: pretty; }
  .foot { padding-top: 14px; border-top: 1px solid var(--border-subtle); font-size: 14px; line-height: 1.6; font-weight: 300; color: var(--text-soft); }

  .close { padding: 0 var(--gutter) 96px; }
  .card {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 32px 64px;
    padding: 40px; background: var(--surface-1);
    border: 1px solid var(--border-subtle); border-top: 3px solid var(--accent);
  }
  .card-copy { flex: 1 1 420px; min-width: 0; }
  .card h2 {
    margin-top: 16px;
    font-size: clamp(28px, 4vw, 44px); font-weight: 700; line-height: 1.02; text-transform: uppercase; text-wrap: balance;
  }
  .actions { flex: 0 1 auto; display: flex; flex-wrap: wrap; gap: 12px; }
  .btn {
    display: inline-block; padding: 13px 22px; white-space: nowrap;
    border: 1px solid var(--accent); color: var(--accent);
    font-family: var(--font-display); font-size: 12px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase;
    transition: background .2s var(--ease), color .2s var(--ease), border-color .2s var(--ease);
  }
  .btn:hover { background: var(--accent); color: #000; }
  .btn.solid { background: var(--accent); color: #000; }
  .btn.solid:hover { background: #fff; border-color: #fff; }

  @media (max-width: 560px) {
    .hero { padding-top: 72px; padding-bottom: 56px; }
    .card { padding: 28px 20px; }
  }
</style>
