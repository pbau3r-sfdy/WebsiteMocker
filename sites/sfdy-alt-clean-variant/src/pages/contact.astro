---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Beam from '../components/Beam.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact" description="Contact Starflight Dynamics GmbH, Munich.">
  <Nav active="contact" />

  <main>
    <header class="hero">
      <Beam thickness={7} />
      <div class="wrap">
        <div class="eyebrow accent">Contact</div>
        <h1>Get in <span class="green">touch</span></h1>
      </div>
    </header>

    <section class="body">
      <div class="wrap grid">
        <dl class="details">
          <div>
            <dt>General enquiries</dt>
            <dd><a href="mailto:mission-control@starflight-dynamics.com" class="mail">mission-control@starflight-dynamics.com</a></dd>
          </div>
          <div>
            <dt>Registered office</dt>
            <dd class="addr">Starflight Dynamics GmbH<br />Tal 44<br />D-80331 Munich, Germany</dd>
          </div>
          <div>
            <dt>Follow</dt>
            <dd class="socials">
              <a href="https://www.linkedin.com/company/starflight-dynamics/" target="_blank" rel="noreferrer" aria-label="LinkedIn"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg></a>
              <a href="https://x.com/sfdy_space" target="_blank" rel="noreferrer" aria-label="X"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
              <a href="https://www.instagram.com/starflight_dynamics/" target="_blank" rel="noreferrer" aria-label="Instagram"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg></a>
              <a href="https://www.facebook.com/profile.php?id=100092226416926" target="_blank" rel="noreferrer" aria-label="Facebook"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg></a>
            </dd>
          </div>
        </dl>

        <form class="form" action="https://api.web3forms.com/submit" method="POST">
          <input type="hidden" name="access_key" value="9989c0a0-65ba-45e5-aebf-c070acaaf430" />
          <input type="hidden" name="subject" value="New contact message — Starflight Dynamics" />
          <div class="row">
            <label><span>Name</span><input type="text" name="name" required /></label>
            <label><span>Email</span><input type="email" name="email" required /></label>
          </div>
          <label><span>Message</span><textarea name="message" rows="7" required></textarea></label>
          <div><button type="submit">Send message</button></div>
        </form>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .eyebrow { font-size: 12px; font-weight: 700; }
  .eyebrow.accent { color: var(--accent); }
  .green { color: var(--accent); }

  .hero { position: relative; padding: 104px var(--gutter) 72px; }
  h1 { margin-top: 20px; font-size: clamp(40px, 7vw, 88px); font-weight: 700; line-height: .98; letter-spacing: .005em; text-transform: uppercase; }

  .body { padding: 0 var(--gutter) 112px; }
  .grid { display: flex; flex-wrap: wrap; gap: 48px 64px; align-items: flex-start; }
  .details { flex: 1 1 340px; border-top: 1px solid var(--border-strong); }
  .details > div { padding: 22px 0; border-bottom: 1px solid var(--border-subtle); }
  dt { font-size: 10px; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; color: var(--text-muted); }
  dd { margin-top: 8px; }
  .mail { font-size: 19px; font-weight: 300; color: var(--accent); word-break: break-word; }
  .addr { font-size: 17px; line-height: 1.6; font-weight: 300; color: rgba(255,255,255,.80); }
  .socials { margin-top: 12px; display: flex; gap: 8px; }
  .socials a {
    width: 44px; height: 44px; display: flex; align-items: center; justify-content: center;
    border: 1px solid var(--border-strong); color: rgba(255,255,255,.80);
    transition: border-color .2s var(--ease), color .2s var(--ease);
  }
  .socials a:hover { border-color: var(--accent); color: var(--accent); }

  .form {
    flex: 1 1 460px; display: flex; flex-direction: column; gap: 20px; padding: 32px;
    background: var(--surface-1); border: 1px solid var(--border-subtle); border-top: 3px solid var(--accent);
  }
  .row { display: flex; flex-wrap: wrap; gap: 20px; }
  .row label { flex: 1 1 200px; }
  label { display: flex; flex-direction: column; gap: 8px; }
  label span { font-size: 10px; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; color: var(--text-soft); }
  input, textarea {
    padding: 13px 14px; background: #000; color: #fff;
    border: 1px solid var(--border-strong); border-radius: 0;
    font-family: var(--font-body); font-size: 15px; font-weight: 300; line-height: 1.6; outline: none;
  }
  textarea { resize: vertical; }
  input:focus, textarea:focus { border-color: var(--accent); }
  button {
    padding: 13px 22px; cursor: pointer;
    background: var(--accent); color: #000; border: 1px solid var(--accent); border-radius: 0;
    font-family: var(--font-display); font-size: 12px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase;
    transition: background .2s var(--ease), border-color .2s var(--ease);
  }
  button:hover { background: #fff; border-color: #fff; }

  @media (max-width: 560px) {
    .hero { padding-top: 72px; padding-bottom: 48px; }
    .form { padding: 24px 20px; }
  }
</style>
