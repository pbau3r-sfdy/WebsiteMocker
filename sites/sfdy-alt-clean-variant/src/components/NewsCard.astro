---
interface Props { title: string; date: Date; id: string; image?: string; }
const { title, date, id, image } = Astro.props;
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const stamp = date.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }).toUpperCase();
---

<a href={`${b}/news/${id}`} class="card">
  <div class="thumb">
    {image
      ? <img src={`${b}${image}`} alt="" loading="lazy" />
      : <div class="placeholder"></div>}
  </div>
  <div class="body">
    <span class="mono date">{stamp}</span>
    <h3>{title}</h3>
  </div>
</a>

<style>
  .card {
    display: flex; flex-direction: column; overflow: hidden;
    background: var(--surface-1); border: 1px solid var(--border-subtle); color: #fff;
    transition: transform .2s var(--ease), border-color .2s, box-shadow .2s;
  }
  .card:hover { transform: translateY(-2px); border-color: var(--border-accent); box-shadow: 0 0 24px rgba(0,251,146,.12); color: #fff; }
  .thumb { aspect-ratio: 16 / 9; overflow: hidden; background: var(--surface-2); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; object-position: center 20%; }
  .placeholder { width: 100%; height: 100%; background: var(--surface-2); }
  .body { display: flex; flex-direction: column; gap: 10px; padding: 20px 24px 24px; flex: 1; }
  .date { color: var(--text-muted); }
  h3 { font-size: 18px; font-weight: 700; line-height: 1.3; text-transform: uppercase; letter-spacing: .02em; text-wrap: pretty; }
</style>
