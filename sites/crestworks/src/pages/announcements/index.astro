---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import AnnouncementCard from '../../../../../_core/src/components/AnnouncementCard.astro';

const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const announcements = (await getCollection('announcements'))
  .sort((x, y) => y.data.date.valueOf() - x.data.date.valueOf());
---

<Layout title="Announcements" description="Announcements from Crestworks.">
  <Nav />
  <main class="main">
    <div class="container">
      <header class="page-header">
        <h1>Announcements</h1>
        <p>Company updates and notices from Crestworks.</p>
      </header>
      {announcements.length === 0 ? (
        <p class="empty">No announcements yet.</p>
      ) : (
        <div class="list">
          {announcements.map(item => (
            <AnnouncementCard
              id={item.id}
              title={item.data.title}
              date={item.data.date}
              summary={item.data.summary}
              tags={item.data.tags}
            />
          ))}
        </div>
      )}
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .main { padding-top: 6rem; padding-bottom: 6rem; min-height: 70vh; }
  .page-header {
    margin-bottom: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  .page-header h1 {
    font-family: var(--font-head);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    margin-bottom: .5rem;
  }
  .page-header p { font-size: 1.125rem; color: var(--text-muted); }
  .list { max-width: 1000px; }
  .empty { color: var(--text-muted); }
</style>
