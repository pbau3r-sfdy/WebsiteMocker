---
export interface Props {
  title:       string;
  description?: string;
}

const {
  title,
  description = 'Crestworks Consulting GmbH — an independent consulting practice in Munich.',
} = Astro.props;

const b = import.meta.env.BASE_URL.replace(/\/$/, '');

const fontFaces = `
@font-face{font-family:'Avenir Next';src:url('${b}/assets/fonts/AvenirNext-UltraLight.woff2') format('woff2'),url('${b}/assets/fonts/AvenirNext-UltraLight.otf') format('opentype');font-weight:100;font-style:normal;font-display:swap}
@font-face{font-family:'Avenir Next';src:url('${b}/assets/fonts/AvenirNext-Regular.woff2') format('woff2'),url('${b}/assets/fonts/AvenirNext-Regular.otf') format('opentype');font-weight:400;font-style:normal;font-display:swap}
@font-face{font-family:'Avenir Next';src:url('${b}/assets/fonts/AvenirNext-Bold.woff2') format('woff2'),url('${b}/assets/fonts/AvenirNext-Bold.otf') format('opentype');font-weight:700;font-style:normal;font-display:swap}
`;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title} · Crestworks Consulting GmbH</title>

  <link rel="icon" type="image/svg+xml"            href={`${b}/assets/logo/crestworks-mark.svg`} />
  <link rel="icon" type="image/png" sizes="32x32"  href={`${b}/assets/favicon/favicon-32.png`} />
  <link rel="icon" type="image/png" sizes="16x16"  href={`${b}/assets/favicon/favicon-16.png`} />
  <link rel="apple-touch-icon" sizes="180x180"     href={`${b}/assets/favicon/favicon-180.png`} />

  <!-- Font-faces baked in via template so paths honour BASE_URL -->
  <style set:html={fontFaces} />

  <style is:global>
    :root {
      --cw-black:   #000000;
      --cw-white:   #ffffff;
      --cw-magenta: #ff2f92;
      --cw-yellow:  #fffb00;
      --cw-grey-600:#595959;
      --cw-grey-500:#7f7f7f;
      --cw-grey-400:#a6a6a6;
      --cw-grey-300:#cccccc;

      /* Map shared _core component tokens onto the Crestworks palette. */
      --accent:         var(--cw-magenta);
      --accent-dim:     rgba(255,47,146,.12);
      --border-accent:  var(--cw-magenta);
      --border-subtle:  var(--cw-grey-300);
      --border-strong:  var(--cw-grey-400);
      --text-primary:   var(--cw-black);
      --text-secondary: var(--cw-grey-600);
      --text-muted:     var(--cw-grey-500);
      --text-soft:      var(--cw-grey-400);
      --surface-1:      var(--cw-white);
      --surface-2:      #fafafa;
      --bg-base:        var(--cw-white);
      --font-display:   'Avenir Next', 'Avenir', sans-serif;
      --font-head:      'Avenir Next', 'Avenir', sans-serif;
      --font-mono:      ui-monospace, SFMono-Regular, Menlo, monospace;
      --gutter:         clamp(20px, 5vw, 64px);
      --radius:         4px;
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; }
    body {
      background: var(--cw-white);
      color: var(--cw-black);
      font-family: 'Avenir Next', 'Avenir', sans-serif;
      font-size: 16px;
      line-height: 1.55;
      -webkit-font-smoothing: antialiased;
    }
    a { color: var(--cw-black); text-decoration: none; }
    a:hover { color: var(--cw-magenta); }
    img { display: block; max-width: 100%; }
    ::selection { background: rgba(255,251,0,.55); color: var(--cw-black); }
  </style>
</head>
<body>
  <slot />
</body>
</html>
