---
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="footer">
  <div class="footer-top container">
    <span class="footer-wordmark">TnT Ventures</span>
    <span class="footer-tagline">Independent angel investments · Munich</span>
    <nav class="footer-legal" aria-label="Legal">
      <a href={`${b}/imprint`}>Impressum</a>
      <a href={`${b}/privacy-policy`}>Datenschutz</a>
    </nav>
  </div>
  <div class="footer-bottom container">
    <span>© 2026 TnT Beteiligungs GmbH</span>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg);
    border-top: 1px solid var(--border);
    padding: 2.5rem 0 1.5rem;
  }
  .footer-top {
    display: flex; align-items: center; gap: 2rem;
    flex-wrap: wrap;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1rem;
  }
  .footer-wordmark {
    font-family: var(--font-head);
    font-size: .9375rem; font-weight: 700;
    color: var(--text);
  }
  .footer-tagline {
    font-size: .8125rem;
    color: var(--text-muted);
    flex: 1;
  }
  .footer-legal {
    display: flex; gap: 1.5rem;
  }
  .footer-legal a {
    font-size: .8125rem; color: var(--text-muted);
    transition: color .15s;
  }
  .footer-legal a:hover { color: var(--text); }
  .footer-bottom {
    font-size: .75rem; color: var(--text-light);
  }

  @media (max-width: 640px) {
    .footer-top { flex-direction: column; align-items: flex-start; gap: 1rem; }
    .footer-tagline { flex: none; }
  }
</style>
