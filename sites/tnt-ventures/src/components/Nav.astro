---
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<nav class="nav" id="top">
  <div class="nav-inner container">
    <a href={`${b}/`} class="nav-wordmark">TnT Ventures</a>

    <ul class="nav-links">
      <li><a href="#focus">Focus</a></li>
      <li><a href="#portfolio">Portfolio</a></li>
      <li><a href="#about">About</a></li>
    </ul>

    <a href="mailto:rk@tnt-ventures.de" class="nav-cta">Start a conversation</a>

    <button class="nav-toggle" aria-label="Open menu" id="nav-toggle">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="nav-mobile" id="nav-mobile">
    <ul>
      <li><a href="#focus">Focus</a></li>
      <li><a href="#portfolio">Portfolio</a></li>
      <li><a href="#about">About</a></li>
      <li><a href="mailto:rk@tnt-ventures.de" class="mobile-cta">Start a conversation</a></li>
    </ul>
  </div>
</nav>

<script>
  const toggle = document.getElementById('nav-toggle');
  const mobile = document.getElementById('nav-mobile');
  toggle?.addEventListener('click', () => mobile?.classList.toggle('open'));
  mobile?.querySelectorAll('a').forEach(a =>
    a.addEventListener('click', () => mobile?.classList.remove('open'))
  );
</script>

<style>
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    background: rgba(244,240,232,0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    height: 60px;
    display: flex; align-items: center; gap: 3rem;
    max-width: 1280px; margin: 0 auto; padding: 0 3rem;
  }
  .nav-wordmark {
    font-family: var(--font-head);
    font-size: 1rem; font-weight: 700;
    color: var(--text); letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .nav-links {
    display: flex; list-style: none; gap: 2.5rem;
    flex: 1;
  }
  .nav-links a {
    font-family: var(--font-head);
    font-size: .875rem; color: var(--text-muted);
    transition: color .15s;
  }
  .nav-links a:hover { color: var(--text); }

  .nav-cta {
    margin-left: auto;
    font-family: var(--font-head);
    font-size: .875rem;
    color: var(--accent);
    white-space: nowrap;
    transition: opacity .15s;
  }
  .nav-cta:hover { opacity: .75; }

  .nav-toggle {
    display: none; flex-direction: column; gap: 5px;
    background: none; border: none; cursor: pointer;
    margin-left: auto;
  }
  .nav-toggle span {
    display: block; width: 22px; height: 1.5px;
    background: var(--text);
  }

  /* Mobile */
  .nav-mobile {
    display: none;
    background: var(--bg);
    border-top: 1px solid var(--border);
    padding: 1.5rem 3rem;
  }
  .nav-mobile.open { display: block; }
  .nav-mobile ul { list-style: none; display: flex; flex-direction: column; gap: 1.25rem; }
  .nav-mobile a {
    font-family: var(--font-head); font-size: 1.125rem;
    color: var(--text-muted); transition: color .15s;
  }
  .nav-mobile a:hover { color: var(--text); }
  .nav-mobile .mobile-cta { color: var(--accent); }

  @media (max-width: 768px) {
    .nav-links, .nav-cta { display: none; }
    .nav-toggle { display: flex; }
  }
</style>
