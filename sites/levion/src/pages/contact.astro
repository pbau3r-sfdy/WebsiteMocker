---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact" description="Get in touch with Levion Materials.">
  <Nav />

  <main class="main">
    <div class="container">
      <header class="page-header">
        <p class="section-label">GET IN TOUCH</p>
        <h1 class="page-title">Contact</h1>
        <p class="page-sub">We'd love to hear from you.</p>
      </header>

      <div class="contact-layout">

        <!-- Contact Info -->
        <aside class="contact-info">
          <div class="info-block">
            <h2 class="info-heading">Email</h2>
            <a href="mailto:lab@levion-materials.com" class="info-link">lab@levion-materials.com</a>
          </div>
          <div class="info-block">
            <h2 class="info-heading">Address</h2>
            <address class="info-address">
              Levion Materials<br />
              c/o Starflight Dynamics UAB<br />
              Gyneju str. 4-333<br />
              01110 Vilnius, Lithuania
            </address>
          </div>
          <div class="info-block">
            <h2 class="info-heading">Follow Us</h2>
            <div class="social-links">
              <a href="https://www.linkedin.com/company/levion-materials/" target="_blank" rel="noopener" class="social-link">LinkedIn</a>
              <a href="https://www.instagram.com/levion_materials/" target="_blank" rel="noopener" class="social-link">Instagram</a>
            </div>
          </div>
        </aside>

        <!-- Contact Form -->
        <div class="contact-form-wrap">
          <form class="contact-form" action="https://formspree.io/f/placeholder" method="POST">
            <div class="form-row">
              <div class="form-group">
                <label for="first-name">First Name</label>
                <input type="text" id="first-name" name="first_name" placeholder="Jane" required />
              </div>
              <div class="form-group">
                <label for="last-name">Last Name</label>
                <input type="text" id="last-name" name="last_name" placeholder="Smith" required />
              </div>
            </div>
            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" placeholder="jane@company.com" required />
            </div>
            <div class="form-group">
              <label for="message">Message</label>
              <textarea id="message" name="message" rows="6" placeholder="Tell us about your project or inquiry..." required></textarea>
            </div>
            <button type="submit" class="btn-submit">Send</button>
          </form>
        </div>

      </div>
    </div>
  </main>

  <!-- Newsletter -->
  <section class="newsletter-section">
    <div class="container">
      <h2>Subscribe for the Levion newsletter</h2>
      <p>Follow our progress from lab to orbit. No spam — only what matters.</p>
      <form class="newsletter-form" action="https://formspree.io/f/placeholder" method="POST">
        <input type="email" name="email" placeholder="your@email.com" required />
        <button type="submit">Sign Up</button>
      </form>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .main { padding-top: 7rem; padding-bottom: 6rem; min-height: 70vh; }
  .page-header { margin-bottom: 3.5rem; }
  .section-label {
    font-family: var(--font-head);
    font-size: .6875rem; font-weight: 600;
    letter-spacing: .18em; text-transform: uppercase;
    color: var(--orange); margin-bottom: .75rem;
  }
  .page-title {
    font-family: var(--font-head);
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    font-weight: 700; line-height: 1.1;
    margin-bottom: .5rem;
  }
  .page-sub { font-size: 1.125rem; color: var(--text-muted); }

  /* ── Layout ── */
  .contact-layout {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
    align-items: start;
  }

  /* ── Info sidebar ── */
  .contact-info { display: flex; flex-direction: column; gap: 2rem; }
  .info-block {}
  .info-heading {
    font-family: var(--font-head); font-size: .75rem; font-weight: 600;
    letter-spacing: .12em; text-transform: uppercase;
    color: var(--text-muted); margin-bottom: .5rem;
  }
  .info-link {
    color: var(--orange); font-size: .9375rem;
    transition: opacity .2s;
  }
  .info-link:hover { opacity: .75; }
  .info-address {
    font-style: normal; font-size: .9375rem;
    color: var(--text-muted); line-height: 1.8;
  }
  .social-links { display: flex; flex-direction: column; gap: .5rem; }
  .social-link {
    font-size: .9375rem; color: var(--text-muted);
    transition: color .2s;
  }
  .social-link:hover { color: var(--orange); }

  /* ── Form ── */
  .contact-form {
    display: flex; flex-direction: column; gap: 1.25rem;
  }
  .form-row {
    display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;
  }
  .form-group { display: flex; flex-direction: column; gap: .4rem; }
  .form-group label {
    font-family: var(--font-head); font-size: .8125rem; font-weight: 500;
    color: var(--text-muted); letter-spacing: .02em;
  }
  .form-group input,
  .form-group textarea {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--text);
    font-family: var(--font-body); font-size: .9375rem;
    padding: .75rem 1rem;
    transition: border-color .2s;
    resize: vertical;
    width: 100%;
  }
  .form-group input::placeholder,
  .form-group textarea::placeholder { color: var(--text-muted); }
  .form-group input:focus,
  .form-group textarea:focus {
    outline: 2px solid var(--orange);
    border-color: var(--orange);
  }
  .btn-submit {
    align-self: flex-start;
    padding: .85rem 2.5rem;
    background: var(--teal); color: #fff;
    font-family: var(--font-head); font-size: .9375rem; font-weight: 700;
    border: none; border-radius: 4px;
    cursor: pointer; transition: opacity .2s;
  }
  .btn-submit:hover { opacity: .85; }

  /* ── Newsletter ── */
  .newsletter-section {
    background: var(--bg-alt);
    border-top: 1px solid var(--border);
    padding: 4rem 0; text-align: center;
  }
  .newsletter-section h2 {
    font-family: var(--font-head);
    font-size: 1rem; font-weight: 700;
    letter-spacing: .14em; text-transform: uppercase;
    color: var(--text-muted); margin-bottom: .75rem;
  }
  .newsletter-section p { font-size: 1rem; color: var(--text-muted); margin-bottom: 1.75rem; }
  .newsletter-form { display: flex; justify-content: center; gap: .75rem; flex-wrap: wrap; }
  .newsletter-form input {
    padding: .75rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    font-size: .9375rem; width: 260px;
    background: var(--bg); color: var(--text);
  }
  .newsletter-form input:focus { outline: 2px solid var(--orange); border-color: var(--orange); }
  .newsletter-form button {
    padding: .75rem 1.75rem;
    background: var(--teal); color: #fff;
    border: none; border-radius: 4px;
    font-family: var(--font-head); font-size: .9375rem; font-weight: 700;
    cursor: pointer; transition: opacity .2s;
  }
  .newsletter-form button:hover { opacity: .85; }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .contact-layout { grid-template-columns: 1fr; gap: 3rem; }
    .form-row { grid-template-columns: 1fr; }
  }
</style>
