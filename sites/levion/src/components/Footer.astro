---
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
const siteName = 'Levion Materials';
---

<footer class="footer">
  <div class="container">
    <div class="footer-inner">
      <div class="footer-brand">
        <a href={`${b}/`} aria-label="Levion Materials home">
          <img src={`${b}/images/logo-color.png`} alt="Levion Materials" class="footer-logo" />
        </a>
        <p class="footer-tagline">Crystal growth in orbital microgravity.</p>
      </div>
      <nav class="footer-nav" aria-label="Footer">
        <a href={`${b}/imprint`}>Imprint</a>
        <a href={`${b}/contact`}>Contact</a>
        <a href={`${b}/privacy-policy`}>Privacy Policy</a>
      </nav>
      <div class="footer-socials">
        <a href="https://www.linkedin.com/company/levion-materials/" target="_blank" rel="noopener" aria-label="LinkedIn">in</a>
        <a href="https://www.instagram.com/levion_materials/" target="_blank" rel="noopener" aria-label="Instagram">ig</a>
      </div>
    </div>
    <div class="footer-copy">
      &copy; {year} {siteName}. All rights reserved.
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-alt);
    border-top: 1px solid var(--border);
    padding: 3rem 0 2rem;
  }
  .footer-inner {
    display: flex; align-items: flex-start; gap: 3rem;
    flex-wrap: wrap; margin-bottom: 2rem;
  }
  .footer-brand { flex: 1; min-width: 160px; }
  .footer-logo { height: 24px; width: auto; object-fit: contain; }
  .footer-tagline { font-size: .875rem; color: var(--text-muted); margin-top: .5rem; }
  .footer-nav {
    display: flex; gap: 1.5rem; flex-wrap: wrap;
    align-items: center;
  }
  .footer-nav a {
    font-size: .8125rem; font-weight: 500;
    letter-spacing: .04em; text-transform: uppercase;
    color: var(--text-muted); transition: color .2s;
  }
  .footer-nav a:hover { color: var(--orange); }
  .footer-socials { display: flex; gap: 1rem; }
  .footer-socials a {
    font-size: .8125rem; font-weight: 700; color: var(--text-muted);
    transition: color .2s; text-transform: uppercase; letter-spacing: .04em;
  }
  .footer-socials a:hover { color: var(--orange); }
  .footer-copy { font-size: .8125rem; color: var(--text-muted); }
</style>
