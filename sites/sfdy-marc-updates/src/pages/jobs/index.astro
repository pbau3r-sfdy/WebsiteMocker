---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import JobRow from '../../components/JobRow.astro';
import { SITES } from '../../data/sites';
import { CAREERS_EMAIL, EQUAL_OPPORTUNITY, isPublished, isTechnical } from '../../data/careers';

const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const jobs = (await getCollection('jobs'))
  .filter(isPublished)
  // Priority positions first, then newest first.
  .sort((a, b) => Number(b.data.priority) - Number(a.data.priority) || b.data.date.valueOf() - a.data.date.valueOf());

const priority = jobs.filter(j => j.data.priority);

const byDept = new Map<string, typeof jobs>();
for (const j of jobs) {
  const dept = j.data.department ?? 'General';
  byDept.set(dept, [...(byDept.get(dept) ?? []), j]);
}
// Departments with a priority position first, then technical before business, then alphabetical.
const depts = [...byDept]
  .map(([name, list]) => ({
    name,
    list,
    id: 'dept-' + name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''),
    hasPriority: list.some(j => j.data.priority),
  }))
  .sort((a, b) =>
    Number(b.hasPriority) - Number(a.hasPriority) ||
    Number(isTechnical(b.name)) - Number(isTechnical(a.name)) ||
    a.name.localeCompare(b.name));

const sites = Object.values(SITES).map(s => ({
  ...s,
  count: jobs.filter(j => j.data.sites.includes(s.key)).length,
}));
const elsewhere = jobs.filter(j => j.data.locations.length > 0).length;
const filters = [
  ...sites.filter(s => s.count > 0).map(s => ({ key: s.key as string, label: s.city })),
  ...(elsewhere ? [{ key: 'elsewhere', label: 'Elsewhere' }] : []),
];
const showFilter = filters.length > 1;
const openApplication = `mailto:${CAREERS_EMAIL}?subject=${encodeURIComponent('Open application')}`;
---

<Layout title="Careers" description="Open positions at Starflight Dynamics in Munich and Vilnius.">
  <Nav />

  <main>
    <header class="hero wrap">
      <div class="beam" aria-hidden="true"></div>
      <div class="eyebrow accent">Careers</div>
      <h1>Build technologies for the <span class="green">high frontier</span></h1>
      <p class="lede">
        Space is Europe’s first line of defence. We develop the technologies and systems that keep
        it safe, and we are looking for people who want to build them with us.
      </p>
    </header>

    <section class="wrap" aria-label="Our sites">
      <div class="sites">
      {sites.map(s => (
        <div class="site">
          <div class="site-head">
            <h2>{s.city}</h2>
            <span class="mono">{s.country} · {s.count} open</span>
          </div>
          <p>{s.blurb}</p>
        </div>
      ))}
      </div>
    </section>

    <section class="positions wrap" aria-labelledby="open-positions">
      <div class="positions-head">
        <div class="eyebrow" id="open-positions">Open positions</div>
        {showFilter && (
          <div class="filter" role="group" aria-label="Filter by site">
            <button type="button" data-site="all" aria-pressed="true">All</button>
            {filters.map(f => (
              <button type="button" data-site={f.key} aria-pressed="false">{f.label}</button>
            ))}
          </div>
        )}
      </div>

      {jobs.length === 0 ? (
        <p class="empty">
          No open positions right now. Follow us on
          <a href="https://www.linkedin.com/company/starflight-dynamics/">LinkedIn</a> for updates.
        </p>
      ) : (
        <>
          {depts.length > 1 && (
            <nav class="jump" aria-label="Jump to department">
              {depts.map(d => (
                <a href={`#${d.id}`} data-dept={d.id}>{d.name} <span class="count">{d.list.length}</span></a>
              ))}
            </nav>
          )}

          {priority.length > 0 && (
            <div class="dept priority-block" id="priority">
              <h3>Priority hiring</h3>
              <ul>{priority.map(j => <JobRow job={j} />)}</ul>
            </div>
          )}

          {depts.map(d => (
            <div class="dept" id={d.id}>
              <h3>{d.name}</h3>
              <ul>{d.list.map(j => <JobRow job={j} />)}</ul>
            </div>
          ))}
        </>
      )}
    </section>

    <section class="open wrap">
      <div>
        <div class="eyebrow">Your role is not listed?</div>
        <p>We are always glad to hear from exceptional people. Send us your CV and a short note on what you would like to work on.</p>
      </div>
      <a href={openApplication} class="btn">Send an open application</a>
    </section>

    <p class="eeo wrap">{EQUAL_OPPORTUNITY}</p>
  </main>

  <Footer />
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter button');
  buttons.forEach(btn => btn.addEventListener('click', () => {
    const site = btn.dataset.site!;
    buttons.forEach(b => b.setAttribute('aria-pressed', String(b === btn)));
    document.querySelectorAll<HTMLElement>('.dept').forEach(dept => {
      let visible = 0;
      dept.querySelectorAll<HTMLElement>('li[data-sites]').forEach(li => {
        const show = site === 'all' || li.dataset.sites!.split(' ').includes(site);
        li.hidden = !show;
        if (show) visible++;
      });
      dept.hidden = visible === 0;
      // Keep the matching jump link in sync with what is visible.
      const link = document.querySelector<HTMLElement>(`.jump a[data-dept="${dept.id}"]`);
      if (link) {
        link.hidden = visible === 0;
        link.querySelector('.count')!.textContent = String(visible);
      }
    });
  }));
</script>

<style>
  main { min-height: 100vh; }
  .wrap { max-width: 1200px; margin: 0 auto; padding-left: var(--gutter); padding-right: var(--gutter); }
  .mono { font-family: var(--font-mono); font-size: 12px; letter-spacing: .06em; }
  .eyebrow {
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .eyebrow.accent { color: var(--accent); }
  .green { color: var(--accent); }

  .hero { position: relative; padding-top: 88px; padding-bottom: 64px; }
  .beam { position: absolute; left: 0; top: 0; bottom: 0; width: 7px; background: var(--beam); }
  h1 {
    margin-top: 20px;
    font-family: var(--font-display);
    font-size: clamp(40px, 7vw, 88px);
    font-weight: 700;
    line-height: .98;
    text-transform: uppercase;
    max-width: 16ch;
    text-wrap: balance;
  }
  .lede { margin-top: 28px; max-width: 620px; font-size: 19px; line-height: 1.65; font-weight: 300; color: var(--text-secondary); }

  .sites {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1px;
    background: var(--border-subtle);
    border: 1px solid var(--border-subtle);
  }
  .site { background: var(--bg-base); padding: 28px; }
  .site-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  .site h2 { font-size: 22px; font-weight: 700; text-transform: uppercase; letter-spacing: .06em; }
  .site .mono { color: var(--accent); text-transform: uppercase; }
  .site p { margin-top: 12px; font-size: 15px; line-height: 1.6; color: var(--text-soft); }

  .positions { padding-top: 88px; padding-bottom: 48px; }
  .positions-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; }
  .filter { display: flex; gap: 8px; }
  .filter button {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .14em;
    text-transform: uppercase;
    padding: 6px 12px;
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border-strong);
    cursor: pointer;
  }
  .filter button[aria-pressed="true"] { color: #000; background: var(--accent); border-color: var(--accent); }

  .jump { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 8px; }
  .jump a {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: .1em;
    text-transform: uppercase;
    padding: 6px 10px;
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    transition: border-color .2s, color .2s;
  }
  .jump a:hover { border-color: var(--accent); color: var(--accent); }
  .jump .count { color: var(--accent); margin-left: 4px; }
  .jump a[hidden] { display: none; }

  .dept { margin-top: 36px; scroll-margin-top: 96px; }
  .priority-block { margin-top: 44px; padding: 4px 24px 0; border: 1px solid var(--border-accent); background: var(--surface-1); }
  .priority-block h3 { color: var(--accent); border-bottom-color: var(--border-accent); padding-top: 18px; }
  .priority-block :global(li:last-child .row) { border-bottom: 0; }
  .priority-block :global(.tag.priority) { display: none; }

  @media (max-width: 720px) {
    .jump { flex-wrap: nowrap; overflow-x: auto; margin-right: calc(-1 * var(--gutter)); padding-right: var(--gutter); scrollbar-width: none; }
    .jump a { flex: none; }
    .priority-block { padding: 4px 16px 0; }
  }
  .dept h3 {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border-strong);
  }
  .dept ul { list-style: none; }
  .empty { margin-top: 24px; color: var(--text-muted); font-size: 1.125rem; }
  .empty a { color: var(--accent); }

  .open {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding-top: 40px;
    padding-bottom: 72px;
  }
  .open p { margin-top: 12px; max-width: 560px; font-size: 16px; line-height: 1.65; color: var(--text-secondary); }
  .btn {
    display: inline-block;
    padding: 13px 22px;
    border: 1px solid var(--accent);
    color: var(--accent);
    font-family: var(--font-display);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .2em;
    text-transform: uppercase;
  }
  .btn:hover { background: var(--accent); color: #000; }

  .eeo { padding-top: 32px; padding-bottom: 48px; font-size: 13px; line-height: 1.6; color: var(--text-muted); border-top: 1px solid var(--border-subtle); }

</style>
