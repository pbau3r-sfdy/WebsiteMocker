---
// Hero — extracted from Claude Design artifact 2026-10-14
---

<section class="hero">
  <img src="../../assets/imagery/hero-earth-night.jpg" alt="" class="hero-bg">
  <div class="scrim"></div>
  <div class="beam-v" role="presentation"></div>
  <div class="wrap hero-content">
    <div class="eyebrow">STARFLIGHT DYNAMICS</div>
    <h1><span>Currently under</span><span class="green">construction</span></h1>
    <p class="descriptor">Technologies for the High Frontier</p>
    <div class="meta mono">
      <span>Munich · Germany</span>
      <span>Full site in preparation</span>
      <a href="mailto:mission-control@starflight-dynamics.com">mission-control@starflight-dynamics.com</a>
    </div>
  </div>
</section>

<style>
.hero {
  position:relative;min-height:560px;padding:64px 0;display:flex;align-items:center;overflow:hidden;background:var(--bg-base)
}
.hero-bg {
  position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:right 30%
}
.hero-content {
  position:relative;z-index:1;width:100%;padding:0 var(--gutter);display:flex;flex-direction:column;gap:34px
}
.hero h1 {
  font-size:clamp(2.6rem,7.4vw,6.5rem);font-weight:700;line-height:1.02;letter-spacing:-.01em;text-transform:uppercase
}
.hero h1 span {
  display:block
}
.hero h1 .green {
  color:var(--accent)
}
</style>
