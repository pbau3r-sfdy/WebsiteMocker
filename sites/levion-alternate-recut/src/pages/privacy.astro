---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
---

<Layout title="Privacy Policy">
  <section class="section">
    <div class="measure">
      <SectionHeading eyebrow="Legal" title="Privacy Policy" level={1} />
      <div class="body">
        <h2>Controller</h2>
        <p>
          Levion Materials, c/o Starflight Dynamics UAB, Gyneju str. 4-333, 01110 Vilnius, Lithuania.
          Contact: <a href="mailto:lab@levion-materials.com">lab@levion-materials.com</a>
        </p>
        <h2>What we process</h2>
        <p>
          This site collects personal data only where you provide it: the contact form
          (name, email, message) and the newsletter subscription (email). Data is used to
          answer your enquiry or send the newsletter, and for nothing else.
        </p>
        <h2>Your rights</h2>
        <p>
          Under the GDPR you may request access, correction, deletion, restriction of
          processing and data portability, and you may object to processing or lodge a
          complaint with a supervisory authority.
        </p>
        <h2>Hosting and logs</h2>
        <p class="placeholder">Hosting provider, server log retention, cookie use and any analytics tooling to be confirmed and documented here before the site goes live.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .measure { max-width: 760px; margin: 0 auto; padding: 0 var(--space-7); }
  .body { font-size: var(--text-body-md); line-height: var(--leading-loose); color: var(--text-body); }
  .body :global(h2) { margin: var(--space-7) 0 var(--space-3); font-size: var(--text-h3); font-weight: 600; color: var(--levion-blue); }
  .body :global(p) { margin-bottom: var(--space-5); }
  .body :global(.placeholder) { border-top: 3px solid var(--levion-orange); padding-top: var(--space-4); font-size: var(--text-body-sm); color: var(--text-muted); }
</style>
