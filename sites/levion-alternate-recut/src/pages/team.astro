---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TeamCard from '../components/TeamCard.astro';
import Button from '../components/Button.astro';

const b = import.meta.env.BASE_URL.replace(/\/$/, '');

const team = [
  {
    name: 'Dr. Philipp Bauer',
    role: 'Co-Founder & CEO',
    photo: '/images/team-bauer.png',
    focus: 'center 22%',
    detail: 'Legal representative of Starflight Dynamics UAB and the point of contact for partners and investors.',
  },
  {
    name: 'Name to confirm',
    role: 'Role to confirm',
    photo: '/images/team-sorgenfrei.png',
    focus: 'center 42%',
    detail: 'Placeholder card — replace with the name, title and one-line bio.',
  },
  {
    name: 'Name to confirm',
    role: 'Role to confirm',
    photo: '/images/team-radtke.png',
    focus: 'center 42%',
    detail: 'Placeholder card — replace with the name, title and one-line bio.',
  },
];
---

<Layout title="Team" description="Materials science, space systems engineering and commercial space operations, in one founding team.">

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="The team"
        title="Experts on Earth and in Space"
        subtitle="Materials science, space systems engineering and commercial space operations, in one founding team."
        level={1}
      />
      <div class="members">
        {team.map(m => <TeamCard {...m} />)}
      </div>
    </div>
  </section>

  <section class="section section--subtle">
    <div class="container closing">
      <div>
        <h2 class="closing-title">Levion is not a concept project.</h2>
        <p class="closing-body">The company grew out of the Advanced Materials division of Starflight Dynamics GmbH and is currently under incorporation as an independent entity.</p>
      </div>
      <Button href={`${b}/careers`} variant="outline" size="lg">Join us</Button>
    </div>
  </section>

</Layout>

<style>
  .members { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--space-7); margin-top: var(--space-8); }
  .closing { display: flex; align-items: center; justify-content: space-between; gap: var(--space-8); flex-wrap: wrap; }
  .closing-title { margin-bottom: var(--space-3); font-size: var(--text-h2); font-weight: 600; color: var(--levion-blue); }
  .closing-body { font-size: var(--text-body-md); color: var(--text-body); max-width: 60ch; }
</style>
