---
export interface Props { title: string; excerpt: string; image?: string; meta?: string; href: string; contain?: boolean; }
const { title, excerpt, image, meta, href, contain = false } = Astro.props;
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const src = image ? (image.startsWith('http') ? image : `${b}${image}`) : null;
---
<article class="post">
  {src && (
    <a href={href} class="thumb"><img src={src} alt={title} class:list={[{ contain }]} /></a>
  )}
  <div class="body">
    {meta && <time class="meta">{meta}</time>}
    <h3 class="title"><a href={href}>{title}</a></h3>
    <p class="excerpt">{excerpt}</p>
    <a href={href} class="more">Read ↗</a>
  </div>
</article>

<style>
  .post { display: flex; flex-direction: column; border: 1px solid var(--border-hairline); border-radius: var(--radius-md); background: var(--white); overflow: hidden; height: 100%; transition: box-shadow var(--duration-fast) var(--ease-standard); }
  .post:hover { box-shadow: var(--shadow-md); }
  .thumb { display: block; }
  .thumb img { width: 100%; aspect-ratio: 16/10; object-fit: cover; }
  .thumb img.contain { object-fit: contain; object-position: center top; padding: 16px 20px 28px; background: var(--white); }
  .body { padding: var(--space-5); display: flex; flex-direction: column; gap: var(--space-3); flex: 1; }
  .meta { font-size: var(--text-caption); text-transform: uppercase; letter-spacing: var(--tracking-caps); color: var(--text-muted); }
  .title { font-size: var(--text-h4); font-weight: 600; line-height: var(--leading-snug); color: var(--levion-blue); text-wrap: pretty; }
  .excerpt { font-size: var(--text-body-sm); line-height: var(--leading-normal); color: var(--text-body); }
  .more { margin-top: auto; font-size: var(--text-body-sm); font-weight: 600; text-transform: uppercase; letter-spacing: var(--tracking-caps); }
</style>
