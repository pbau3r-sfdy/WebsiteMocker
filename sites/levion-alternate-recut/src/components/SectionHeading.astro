---
export interface Props { eyebrow?: string; title: string; subtitle?: string; level?: 1 | 2; }
const { eyebrow, title, subtitle, level = 2 } = Astro.props;
const H = level === 1 ? 'h1' : 'h2';
---
<div class="heading">
  {eyebrow && <div class="eyebrow">{eyebrow}</div>}
  <H class="title">{title}</H>
  <div class="rule"></div>
  {subtitle && <p class="subtitle">{subtitle}</p>}
</div>

<style>
  .eyebrow {
    font-size: var(--text-caption); font-weight: 600; text-transform: uppercase;
    letter-spacing: var(--tracking-caps-wide); color: var(--levion-orange);
  }
  .title {
    margin-top: var(--space-4); font-size: var(--text-h1); font-weight: 600;
    line-height: var(--leading-snug); color: var(--levion-blue); text-wrap: pretty;
  }
  .rule { width: 96px; height: 3px; background: var(--gradient-rule); margin: var(--space-5) 0; }
  .subtitle { font-size: var(--text-body-lg); line-height: var(--leading-loose); color: var(--text-body); max-width: 62ch; }
</style>
