---
export interface Props { value: string; label: string; tone?: 'blue' | 'orange' | 'inverse'; }
const { value, label, tone = 'blue' } = Astro.props;
---
<div class:list={['stat', `t-${tone}`]}>
  <div class="value">{value}</div>
  <div class="label">{label}</div>
</div>

<style>
  .value { font-size: var(--text-display); font-weight: 700; line-height: 1; }
  .label { margin-top: var(--space-3); font-size: var(--text-body-sm); line-height: var(--leading-normal); }
  .t-blue .value { color: var(--levion-blue); } .t-blue .label { color: var(--text-body); }
  .t-orange .value { color: var(--levion-orange); } .t-orange .label { color: rgba(255,255,255,0.82); }
  .t-inverse .value { color: var(--white); } .t-inverse .label { color: rgba(255,255,255,0.82); }
</style>
