---
export interface Props { icon?: string; ordinal?: string; title: string; body: string; }
const { icon, ordinal, title, body } = Astro.props;
const iconUrl = icon ? `https://unpkg.com/lucide-static@latest/icons/${icon}.svg` : null;
---
<div class="feature">
  {iconUrl && <span class="icon" style={`--icon:url(${iconUrl})`} aria-hidden="true"></span>}
  {!iconUrl && ordinal && <div class="ordinal">{ordinal}</div>}
  <div class="title">{title}</div>
  <p class="body">{body}</p>
</div>

<style>
  .feature { background: var(--white); border: 1px solid var(--border-hairline); border-radius: var(--radius-md); padding: var(--space-5); height: 100%; }
  .icon {
    display: block; width: 30px; height: 30px; background: var(--levion-blue);
    -webkit-mask: var(--icon) no-repeat center / contain;
            mask: var(--icon) no-repeat center / contain;
    margin-bottom: var(--space-5);
  }
  .ordinal { font-family: var(--font-condensed); font-size: var(--text-h3); font-weight: 600; color: var(--levion-orange); line-height: 1; margin-bottom: var(--space-4); }
  .title { font-size: var(--text-body-lg); font-weight: 600; color: var(--levion-blue); }
  .body { margin-top: var(--space-2); font-size: var(--text-body-sm); line-height: var(--leading-normal); color: var(--text-body); }
</style>
