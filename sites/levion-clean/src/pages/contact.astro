---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
---

<Layout title="Contact" description="Tell us the material, the diameter and the volume you need.">
  <section class="section">
    <div class="container grid-2">
      <div>
        <SectionHeading
          eyebrow="Contact"
          title="Talk to the lab"
          subtitle="Tell us the material, the diameter and the volume you need. We will come back with a feasibility view."
          level={1}
        />
        <address class="details">
          <div class="name">Levion Materials</div>
          <div>c/o Starflight Dynamics UAB</div>
          <div>Gyneju str. 4-333, 01110 Vilnius, Lithuania</div>
          <div class="mail"><a href="mailto:lab@levion-materials.com">lab@levion-materials.com</a></div>
        </address>
      </div>

      <Card accent="gradient" padding="lg">
        <form name="contact" method="post" data-netlify="true" class="form">
          <div class="pair">
            <div class="field">
              <label for="first">First Name</label>
              <input id="first" name="first" type="text" required />
            </div>
            <div class="field">
              <label for="last">Last Name</label>
              <input id="last" name="last" type="text" required />
            </div>
          </div>
          <div class="field">
            <label for="email">Email</label>
            <input id="email" name="email" type="email" required />
          </div>
          <div class="field">
            <label for="msg">Message</label>
            <textarea id="msg" name="message" rows="6" required></textarea>
          </div>
          <Button type="submit" variant="primary" size="lg">Send</Button>
        </form>
      </Card>
    </div>
  </section>
</Layout>

<style>
  .grid-2 { display: grid; grid-template-columns: 1fr 1.1fr; gap: var(--space-9); align-items: start; }
  .details { margin-top: var(--space-7); border-top: 3px solid var(--levion-blue); padding-top: var(--space-5); font-style: normal; font-size: var(--text-body-md); line-height: var(--leading-loose); color: var(--text-body); }
  .name { font-weight: 600; color: var(--levion-blue); }
  .mail { margin-top: var(--space-3); }
  .form { display: flex; flex-direction: column; gap: var(--space-5); align-items: flex-start; }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-5); width: 100%; }
  .field { display: flex; flex-direction: column; gap: var(--space-2); width: 100%; }
  label { font-size: var(--text-caption); font-weight: 600; text-transform: uppercase; letter-spacing: var(--tracking-caps); color: var(--levion-blue); }
  input, textarea { font-family: var(--font-core); font-size: var(--text-body-md); color: var(--text-body); padding: var(--space-3) var(--space-4); border: 1px solid var(--border-strong); border-radius: var(--radius-md); background: var(--white); }
  textarea { resize: vertical; }
  input:focus, textarea:focus { outline: none; border-color: var(--levion-blue); box-shadow: var(--shadow-focus); }
  @media (max-width: 900px) { .grid-2 { grid-template-columns: 1fr; gap: var(--space-7); } .pair { grid-template-columns: 1fr; } }
</style>
