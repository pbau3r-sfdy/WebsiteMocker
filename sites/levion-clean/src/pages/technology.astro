---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Card from '../components/Card.astro';
import Callout from '../components/Callout.astro';
import MilestoneRail from '../components/MilestoneRail.astro';

const steps = [
  { n: '01', title: 'Feedstock',       body: 'The customer ships semiconductor feedstock to Levion.' },
  { n: '02', title: 'Launch',          body: 'Charged into the CGF and flown on a scheduled mission.' },
  { n: '03', title: 'Growth in orbit', body: 'The ingot grows at 1.300°C in true microgravity, monitored from ground.' },
  { n: '04', title: 'Return',          body: "The ingot comes back to Earth and enters the customer's process unchanged." },
];

const family = [
  { n: '01', name: 'CGF-XS', accent: 'blue',   body: 'Technology demonstrator. 1" Ø ingots, growth at 1.300°C, flown as the GROOVE payload.' },
  { n: '02', name: 'CGF-S',  accent: 'blue',   body: 'First commercial pilot runs. Qualification of the process for customer feedstock.' },
  { n: '03', name: 'CGF-M',  accent: 'orange', body: 'Series production. 4-8" in Ø, the size the substrate market buys. CGF-L follows.' },
];

const milestones = [
  { year: '2026', title: 'GROOVE flight',     detail: 'CGF-XS payload\nESA BSGN accelerator' },
  { year: '2027', title: 'CGF-S pilot runs',  detail: 'Customer feedstock\nProcess qualification' },
  { year: '2028', title: 'CGF-M series',      detail: '4-8" in Ø\nCommercial ramp-up' },
  { year: '2030', title: 'CGF-L',             detail: 'Volume production\nMulti-material' },
];
---

<Layout title="Technology" description="Crystal growth as-a-service: send feedstock, Levion grows the ingot in orbit and returns it.">

  <section class="section">
    <div class="container split">
      <div>
        <div class="eyebrow">The technology</div>
        <h1 class="title">Crystal growth as-a-service</h1>
        <p class="lede">Customers send semiconductor feedstock. Levion grows the ingot in orbit inside the Crystal Growth Facility and returns it. No change to the customer's downstream process.</p>
      </div>
      <div class="process">
        {steps.map(s => (
          <div class="step">
            <div class="ordinal">{s.n}</div>
            <div class="step-title">{s.title}</div>
            <p class="step-body">{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--subtle">
    <div class="container">
      <SectionHeading
        eyebrow="The hardware"
        title="The CGF family"
        subtitle="One furnace architecture in four sizes. Where the CGF-XS proves the concept, CGF-M delivers the business."
      />
      <div class="family">
        {family.map(f => (
          <Card accent={f.accent} padding="md">
            <div class="ordinal">{f.n}</div>
            <div class="model">{f.name}</div>
            <p class="step-body">{f.body}</p>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading eyebrow="The roadmap" title="From demonstrator to series" />
      <MilestoneRail items={milestones} />
    </div>
  </section>

  <section class="section note">
    <div class="container">
      <Callout label="Basis of estimate" tone="blue">
        Figures shown are modelled, not measured: scrap ratios and market values are based on Levion's own market model for space-grown substrates. GROOVE exists to replace the model with flight data.
      </Callout>
    </div>
  </section>

</Layout>

<style>
  .eyebrow { font-size: var(--text-caption); font-weight: 600; text-transform: uppercase; letter-spacing: var(--tracking-caps-wide); color: var(--levion-orange); }
  .title { margin: var(--space-4) 0 var(--space-5); font-size: var(--text-h1); line-height: var(--leading-snug); font-weight: 600; color: var(--levion-blue); }
  .lede { font-size: var(--text-body-lg); line-height: var(--leading-loose); max-width: 54ch; }
  .process { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; background: var(--border-hairline); border: 1px solid var(--border-hairline); border-radius: var(--radius-md); overflow: hidden; }
  .step { background: var(--white); padding: var(--space-6); }
  .ordinal { font-family: var(--font-condensed); font-size: var(--text-h3); font-weight: 600; color: var(--levion-orange); line-height: 1; }
  .step-title { margin-top: var(--space-3); font-size: var(--text-body-sm); font-weight: 600; text-transform: uppercase; letter-spacing: var(--tracking-caps); color: var(--levion-blue); }
  .step-body { margin-top: var(--space-2); font-size: var(--text-body-sm); line-height: var(--leading-normal); color: var(--text-body); }
  .family { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: var(--space-6); margin-top: var(--space-7); }
  .family .ordinal { margin-bottom: var(--space-4); }
  .model { font-size: var(--text-h4); font-weight: 600; color: var(--levion-blue); }
  .note { padding-top: 0; }
  @media (max-width: 600px) { .process { grid-template-columns: 1fr; } }
</style>
