---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FeatureCard from '../components/FeatureCard.astro';
import StatFigure from '../components/StatFigure.astro';
import PartnerStrip from '../components/PartnerStrip.astro';
import Button from '../components/Button.astro';

const b = import.meta.env.BASE_URL.replace(/\/$/, '');

const applications = [
  { icon: 'zap',       title: 'High Power Electronics', body: 'Ultra-pure crystals for next-generation power semiconductors.' },
  { icon: 'telescope', title: 'Optics & Lasers',        body: 'Defect-free optical crystals for more powerful laser systems.' },
  { icon: 'radio',     title: 'Sensors',                body: 'High-purity sensor crystals with superior sensitivity.' },
  { icon: 'radiation', title: 'Radiation Detectors',    body: 'Space-grown scintillator crystals for medical imaging and nuclear detection.' },
  { icon: 'atom',      title: 'Energy & Quantum',       body: 'Materials for quantum computing and next-generation energy.' },
];

const problems = [
  'Uneven composition during solidification',
  'Internal mechanical stress',
  'Crystallographic defects from convective forces',
  'Inability to reach macroscopically level atomic alignment',
];

const gains = ['Stable composition', 'Fewer structural defects', 'More uniform growth'];
---

<Layout title="Materials Beyond Gravity">

  <section class="section">
    <div class="container hero">
      <div>
        <div class="eyebrow">Advanced materials made in space</div>
        <h1 class="hero-title">Materials Beyond Gravity</h1>
        <div class="rule"></div>
        <p class="lede">Growing perfect crystals requires an environment Earth cannot provide. Levion Materials (currently under incorporation) is being established as an independent company dedicated to crystal growth in true microgravity — achievable only in space.</p>
        <div class="actions">
          <Button href={`${b}/contact`} variant="primary" size="lg">Get in touch</Button>
          <a href={`${b}/technology`} class="text-link">The technology ↗</a>
        </div>
      </div>
      <figure class="hero-media">
        <img src={`${b}/images/photo-cleanroom.png`} alt="Crystal growth laboratory" />
      </figure>
    </div>
  </section>

  <section class="section section--subtle">
    <div class="container">
      <SectionHeading
        eyebrow="The mission"
        title="Why Crystals Matter"
        subtitle="Many modern technologies rely on crystals — from electronics to lasers to sensors to energy systems. The performance of these technologies depends on how perfect the crystal is."
      />
      <div class="apps">
        {applications.map(a => <FeatureCard icon={a.icon} title={a.title} body={a.body} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="The problem"
        title="The Problem with Gravity"
        subtitle="On Earth, gravity constantly acts on molten materials during crystal growth."
      />
      <div class="problems">
        {problems.map(p => <div class="rule-top problem">{p}</div>)}
      </div>
      <p class="closing">Even in the best laboratories, gravity cannot be switched off.</p>
    </div>
  </section>

  <section class="section section--inverse">
    <img class="watermark" src={`${b}/images/mark-v-grey.png`} alt="" aria-hidden="true" />
    <div class="container split">
      <div>
        <div class="eyebrow">The solution</div>
        <h2 class="inverse-title">The Change with Microgravity</h2>
        <p class="inverse-lede">In microgravity, materials behave differently — no sedimentation, no buoyancy-driven convection, more uniform growth. Crystals can form in a way that is impossible on Earth.</p>
        <div class="gains">
          {gains.map(g => <div class="gain">{g}</div>)}
        </div>
      </div>
      <div class="stats">
        <StatFigure value="≈40%" label="Scrap ratio for CZT grown on Earth" tone="orange" />
        <StatFigure value="≈4%" label="Expected scrap ratio in microgravity" tone="orange" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container traction">
      <img src={`${b}/images/mission-patch-groove.png`} alt="GROOVE mission patch" />
      <div>
        <div class="eyebrow">The traction</div>
        <h2 class="traction-title">GROOVE</h2>
        <p class="traction-sub">Growth Parameter Observation &amp; Validation Experiment</p>
        <p class="lede">Levion's first in-space materials mission, developed in the ESA Business in Space Growth Network (BSGN) Advanced Materials and In-orbit Manufacturing Industry Accelerator. Flight hardware is in preparation.</p>
      </div>
    </div>
  </section>

  <section class="section section--subtle">
    <div class="container">
      <PartnerStrip heading="Thanks to our partners & supporters" />
    </div>
  </section>

  <section class="section cta">
    <div class="container cta-inner">
      <div>
        <h2 class="cta-title">Send us your feedstock. We return the ingot.</h2>
        <p>Crystal growth as-a-service, from a European supply chain.</p>
      </div>
      <Button href={`${b}/contact`} variant="secondary" size="lg">Get in touch</Button>
    </div>
  </section>

</Layout>

<style>
  .hero { display: grid; grid-template-columns: 1.05fr 1fr; gap: var(--space-9); align-items: center; }
  .eyebrow { font-size: var(--text-caption); font-weight: 600; text-transform: uppercase; letter-spacing: var(--tracking-caps-wide); color: var(--levion-orange); }
  .hero-title { margin-top: var(--space-4); font-size: var(--text-display); line-height: var(--leading-tight); font-weight: 600; color: var(--levion-blue); text-wrap: pretty; }
  .rule { width: 96px; height: 3px; background: var(--gradient-rule); margin: var(--space-5) 0; }
  .lede { font-size: var(--text-body-lg); line-height: var(--leading-loose); color: var(--text-body); max-width: 54ch; }
  .actions { display: flex; gap: var(--space-5); align-items: center; margin-top: var(--space-7); flex-wrap: wrap; }
  .text-link { font-size: var(--text-body-sm); font-weight: 600; text-transform: uppercase; letter-spacing: var(--tracking-caps); }
  .hero-media img { width: 100%; aspect-ratio: 4/3; object-fit: cover; border: 1px solid var(--border-hairline); border-radius: var(--radius-md); }

  .apps { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: var(--space-5); margin-top: var(--space-7); }

  .problems { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-6); margin-top: var(--space-7); }
  .problem { font-size: var(--text-body-md); line-height: var(--leading-normal); color: var(--text-body); }
  .closing { margin-top: var(--space-7); font-size: var(--text-body-lg); font-weight: 600; color: var(--levion-blue); }

  .watermark { position: absolute; right: -60px; bottom: -80px; width: 460px; opacity: 0.09; pointer-events: none; }
  .inverse-title { margin: var(--space-4) 0 var(--space-5); font-size: var(--text-h1); line-height: var(--leading-snug); font-weight: 600; color: var(--white); }
  .inverse-lede { font-size: var(--text-body-lg); line-height: var(--leading-loose); color: rgba(255,255,255,0.82); max-width: 52ch; }
  .gains { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-5); margin-top: var(--space-7); }
  .gain { border-top: 3px solid var(--levion-orange); padding-top: var(--space-3); font-size: var(--text-body-sm); font-weight: 600; color: var(--white); text-transform: uppercase; letter-spacing: var(--tracking-caps); }
  .stats { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6); }

  .traction { display: grid; grid-template-columns: 340px 1fr; gap: var(--space-9); align-items: center; }
  .traction-title { margin: var(--space-4) 0 var(--space-2); font-size: var(--text-h1); line-height: var(--leading-snug); font-weight: 600; color: var(--levion-blue); }
  .traction-sub { margin-bottom: var(--space-5); font-size: var(--text-body-md); color: var(--text-muted); }

  .cta { border-top: 1px solid var(--border-hairline); }
  .cta-inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-8); flex-wrap: wrap; }
  .cta-title { margin-bottom: var(--space-3); font-size: var(--text-h2); font-weight: 600; color: var(--levion-blue); }

  @media (max-width: 900px) {
    .hero, .traction { grid-template-columns: 1fr; gap: var(--space-7); }
    .gains, .stats { grid-template-columns: 1fr; }
    .traction img { max-width: 260px; }
  }
</style>
