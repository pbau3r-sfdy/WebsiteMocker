---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
---

<Layout title="Imprint">
  <section class="section">
    <div class="measure">
      <SectionHeading eyebrow="Legal" title="Imprint" level={1} />
      <div class="body">
        <h2>Provider</h2>
        <p>
          Levion Materials<br />
          c/o Starflight Dynamics UAB<br />
          Gyneju str. 4-333, 01110 Vilnius, Lithuania
        </p>
        <h2>Represented by</h2>
        <p>Dr. Philipp Bauer</p>
        <h2>Contact</h2>
        <p><a href="mailto:lab@levion-materials.com">lab@levion-materials.com</a></p>
        <h2>Registration</h2>
        <p class="placeholder">Company register, registration number, VAT ID and responsible supervisory authority to be added once incorporation completes.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .measure { max-width: 760px; margin: 0 auto; padding: 0 var(--space-7); }
  .body { font-size: var(--text-body-md); line-height: var(--leading-loose); color: var(--text-body); }
  .body :global(h2) { margin: var(--space-7) 0 var(--space-3); font-size: var(--text-h3); font-weight: 600; color: var(--levion-blue); }
  .body :global(p) { margin-bottom: var(--space-5); }
  .body :global(.placeholder) { border-top: 3px solid var(--levion-orange); padding-top: var(--space-4); font-size: var(--text-body-sm); color: var(--text-muted); }
</style>
