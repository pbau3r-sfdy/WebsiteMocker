---
import Layout from '../../layouts/Layout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Card from '../../components/Card.astro';
import Button from '../../components/Button.astro';

const b = import.meta.env.BASE_URL.replace(/\/$/, '');

const openings = [
  { title: 'Crystal Growth Process Engineer', meta: 'Vilnius — full time — senior', href: `${b}/careers/crystal-growth-process-engineer`, cta: 'Read ↗' },
  { title: 'Role title',                      meta: 'Vilnius — full time',          href: 'mailto:lab@levion-materials.com', cta: 'Apply ↗' },
];
---

<Layout title="Careers" description="Build the first orbital crystal foundry. Open positions at Levion Materials.">
  <section class="section">
    <div class="container split top">
      <div>
        <SectionHeading
          eyebrow="Careers"
          title="Build the first orbital crystal foundry"
          subtitle="Levion is a small engineering team. Everyone here owns hardware that flies."
          level={1}
        />
        <div class="facts">
          <div class="rule-top">
            <div class="label">Where we sit</div>
            <p>Vilnius, Lithuania, with the Starflight Dynamics engineering base.</p>
          </div>
          <div class="rule-top">
            <div class="label">How we hire</div>
            <p>A technical conversation, a task drawn from real work, and a meeting with the founding team.</p>
          </div>
        </div>
      </div>

      <Card accent="gradient" padding="lg">
        <div class="kicker">Open positions</div>
        <ul class="openings">
          {openings.map(o => (
            <li>
              <div>
                <div class="role">{o.title}</div>
                <div class="meta">{o.meta}</div>
              </div>
              <a href={o.href} class="apply">{o.cta}</a>
            </li>
          ))}
        </ul>
        <p class="note">Placeholder listing in the second row — replace with the real opening, or run the page on speculative applications alone.</p>
        <Button href="mailto:lab@levion-materials.com?subject=Speculative%20application" variant="primary" size="md">Speculative application</Button>
      </Card>
    </div>
  </section>
</Layout>

<style>
  .top { align-items: start; }
  .facts { display: flex; flex-direction: column; gap: var(--space-5); margin-top: var(--space-7); }
  .label { font-size: var(--text-body-sm); font-weight: 600; text-transform: uppercase; letter-spacing: var(--tracking-caps); color: var(--levion-blue); }
  .facts p { margin-top: var(--space-2); font-size: var(--text-body-md); line-height: var(--leading-normal); }
  .kicker { font-size: var(--text-caption); font-weight: 600; text-transform: uppercase; letter-spacing: var(--tracking-caps-wide); color: var(--levion-orange); }
  .openings { list-style: none; display: flex; flex-direction: column; gap: var(--space-4); margin-top: var(--space-5); }
  .openings li { display: flex; justify-content: space-between; gap: var(--space-5); border-bottom: 1px solid var(--border-hairline); padding-bottom: var(--space-4); }
  .role { font-size: var(--text-body-md); font-weight: 600; color: var(--levion-blue); }
  .meta { font-size: var(--text-body-sm); color: var(--text-muted); }
  .apply { font-size: var(--text-body-sm); font-weight: 600; text-transform: uppercase; letter-spacing: var(--tracking-caps); white-space: nowrap; }
  .note { margin: var(--space-6) 0 var(--space-5); font-size: var(--text-body-sm); line-height: var(--leading-normal); color: var(--text-body); }
</style>
