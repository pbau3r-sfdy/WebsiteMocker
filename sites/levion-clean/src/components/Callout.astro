---
export interface Props { label?: string; tone?: 'blue' | 'orange'; }
const { label, tone = 'blue' } = Astro.props;
---
<div class:list={['callout', `t-${tone}`]}>
  {label && <div class="label">{label}</div>}
  <div class="body"><slot /></div>
</div>

<style>
  .callout { border: 1px solid var(--border-hairline); border-radius: var(--radius-md); padding: var(--space-5); background: var(--surface-subtle); position: relative; }
  .callout::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 3px; }
  .t-blue::before { background: var(--levion-blue); }
  .t-orange::before { background: var(--levion-orange); }
  .label { font-size: var(--text-caption); font-weight: 600; text-transform: uppercase; letter-spacing: var(--tracking-caps-wide); color: var(--levion-blue); margin-bottom: var(--space-3); }
  .body { font-size: var(--text-body-sm); line-height: var(--leading-loose); color: var(--text-body); }
</style>
