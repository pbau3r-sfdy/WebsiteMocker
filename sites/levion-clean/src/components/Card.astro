---
export interface Props { accent?: 'none' | 'blue' | 'orange' | 'gradient'; padding?: 'sm' | 'md' | 'lg'; class?: string; }
const { accent = 'none', padding = 'md', class: cls = '' } = Astro.props;
---
<div class:list={['card', `a-${accent}`, `p-${padding}`, cls]}><slot /></div>

<style>
  .card { background: var(--white); border: 1px solid var(--border-hairline); border-radius: var(--radius-md); position: relative; }
  .card::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 3px; }
  .a-none::before { display: none; }
  .a-blue::before { background: var(--levion-blue); }
  .a-orange::before { background: var(--levion-orange); }
  .a-gradient::before { background: var(--gradient-levion); }
  .p-sm { padding: var(--space-4); }
  .p-md { padding: var(--space-5); }
  .p-lg { padding: var(--space-6); }
</style>
