---
export interface Props { items: { year: string; title: string; detail?: string }[]; }
const { items } = Astro.props;
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div class="rail" style={`--wave:url(${b}/images/motif-wave.png)`}>
  {items.map(m => (
    <div class="milestone">
      <div class="year">{m.year}</div>
      <div class="node" aria-hidden="true"></div>
      <div class="title">{m.title}</div>
      {m.detail && <p class="detail">{m.detail}</p>}
    </div>
  ))}
</div>

<style>
  .rail { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: var(--space-6); position: relative; }
  .milestone { padding-top: var(--space-2); }
  .year { font-family: var(--font-condensed); font-size: var(--text-h3); font-weight: 600; color: var(--levion-orange); line-height: 1; }
  .node { height: 3px; background: var(--gradient-rule); margin: var(--space-4) 0; }
  .title { font-size: var(--text-body-lg); font-weight: 600; color: var(--levion-blue); }
  .detail { margin-top: var(--space-2); font-size: var(--text-body-sm); line-height: var(--leading-normal); color: var(--text-body); white-space: pre-line; }
</style>
