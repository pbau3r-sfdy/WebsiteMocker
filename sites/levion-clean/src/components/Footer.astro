---
import { footerLinks } from '../lib/nav';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<footer class="footer">
  <div class="container footer-inner">
    <div class="col">
      <img src={`${b}/images/logo-levion-wordmark.png`} alt="Levion Materials" height="32" />
      <p class="legal">© Levion Materials 2026 — currently under incorporation</p>
    </div>

    <nav class="col" aria-label="Footer">
      <div class="heading">Site</div>
      <ul>
        {footerLinks.map(l => <li><a href={`${b}${l.href}`}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="col">
      <div class="heading">Newsletter</div>
      <p class="blurb">Subscribe for the Levion newsletter.</p>
      <form class="subscribe" name="newsletter" method="post" data-netlify="true">
        <label class="sr-only" for="nl-email">E-Mail address</label>
        <input id="nl-email" name="email" type="email" required placeholder="you@company.com" />
        <button type="submit">Subscribe</button>
      </form>
    </div>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--border-hairline); background: var(--surface-subtle); padding: var(--space-8) 0; }
  .footer-inner { display: grid; grid-template-columns: 1.2fr 1fr 1.4fr; gap: var(--space-8); align-items: start; }
  .col img { height: 32px; width: auto; }
  .legal { margin-top: var(--space-4); font-size: var(--text-caption); color: var(--text-muted); }
  .heading {
    font-size: var(--text-caption); font-weight: 600; text-transform: uppercase;
    letter-spacing: var(--tracking-caps-wide); color: var(--levion-blue); margin-bottom: var(--space-4);
  }
  ul { list-style: none; display: flex; flex-direction: column; gap: var(--space-2); font-size: var(--text-body-sm); }
  .blurb { font-size: var(--text-body-sm); color: var(--text-body); margin-bottom: var(--space-4); max-width: 40ch; }
  .subscribe { display: flex; gap: var(--space-2); align-items: stretch; max-width: 420px; }
  .subscribe input {
    flex: 1; height: 44px; box-sizing: border-box;
    font-family: var(--font-core); font-size: var(--text-body-md); color: var(--text-body);
    padding: 0 var(--space-4); border: 1px solid var(--border-strong); border-radius: var(--radius-md); background: var(--white);
  }
  .subscribe button {
    height: 44px; box-sizing: border-box; padding: 0 var(--space-5); cursor: pointer;
    font-family: var(--font-core); font-size: var(--text-body-sm); font-weight: 600;
    text-transform: uppercase; letter-spacing: var(--tracking-caps); white-space: nowrap;
    color: var(--white); background: var(--levion-blue); border: 1px solid transparent; border-radius: var(--radius-md);
    transition: background var(--duration-fast) var(--ease-standard);
  }
  .subscribe button:hover { background: var(--levion-blue-deep); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (max-width: 900px) { .footer-inner { grid-template-columns: 1fr; gap: var(--space-7); } }
</style>
