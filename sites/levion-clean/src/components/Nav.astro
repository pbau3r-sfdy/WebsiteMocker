---
import { navItems } from '../lib/nav';
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(b, '').replace(/\/$/, '') || '/';
---
<header class="nav">
  <div class="container nav-inner">
    <a href={`${b}/`} class="brand" aria-label="Levion Materials — home">
      <img src={`${b}/images/logo-levion-wordmark.png`} alt="Levion" height="30" />
    </a>
    <nav aria-label="Main">
      <ul>
        {navItems.map(item => (
          <li>
            <a
              href={`${b}${item.href}`}
              class:list={['link', { active: path === item.href.replace(/\/$/, '') || (item.href !== '/' && path.startsWith(item.href)) }]}
              aria-current={path === item.href ? 'page' : undefined}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: rgba(255,255,255,0.88);
    backdrop-filter: var(--blur-glass);
    -webkit-backdrop-filter: var(--blur-glass);
    border-bottom: 1px solid var(--border-hairline);
  }
  .nav-inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-6); height: 72px; }
  .brand img { height: 30px; width: auto; }
  ul { list-style: none; display: flex; gap: var(--space-6); align-items: center; }
  .link {
    font-size: var(--text-body-sm); font-weight: 600;
    text-transform: uppercase; letter-spacing: var(--tracking-caps);
    color: var(--levion-blue); padding-bottom: 2px; border-bottom: 2px solid transparent;
  }
  .link:hover, .link.active { color: var(--levion-orange); border-bottom-color: var(--levion-orange); }
  @media (max-width: 900px) {
    .nav-inner { height: auto; padding-top: var(--space-4); padding-bottom: var(--space-4); flex-wrap: wrap; }
    ul { gap: var(--space-4); flex-wrap: wrap; }
  }
</style>
