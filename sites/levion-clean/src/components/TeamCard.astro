---
export interface Props { name: string; role: string; photo: string; detail?: string; focus?: string; }
const { name, role, photo, detail, focus = 'center 22%' } = Astro.props;
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<article class="member">
  <img src={`${b}${photo}`} alt={name} style={`object-position:${focus}`} />
  <div class="name">{name}</div>
  <div class="role">{role}</div>
  {detail && <p class="detail">{detail}</p>}
</article>

<style>
  img { width: 100%; aspect-ratio: 1/1; object-fit: cover; filter: saturate(0.9); transition: filter var(--duration-base) var(--ease-standard); }
  .member:hover img { filter: saturate(1); }
  .name { margin-top: var(--space-5); font-size: var(--text-h4); font-weight: 600; color: var(--levion-blue); }
  .role { margin-top: var(--space-1); font-size: var(--text-body-sm); font-weight: 600; text-transform: uppercase; letter-spacing: var(--tracking-caps); color: var(--levion-orange); }
  .detail { margin-top: var(--space-3); font-size: var(--text-body-sm); line-height: var(--leading-normal); color: var(--text-body); }
</style>
