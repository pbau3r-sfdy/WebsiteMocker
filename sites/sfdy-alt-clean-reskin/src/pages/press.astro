---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';

const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const BOILER = 'Starflight Dynamics builds the tools for in-space power projection: propulsion, payloads and high-endurance platforms, with systems for concept development and mission preparation. Founded in 2023 and anchored in Germany, the company works from Munich (Starflight Dynamics GmbH) and Vilnius (Starflight Dynamics UAB).';
const facts = [
  ['Founded', '2023, Munich'],
  ['Sites', 'Munich, Germany / Vilnius, Lithuania'],
  ['Entities', 'Starflight Dynamics GmbH / Starflight Dynamics UAB'],
  ['CEO', 'Dr. Philipp Bauer'],
  ['Programmes under contract', 'REAGAN, since July 2025'],
  ['Demonstration mission', 'OVERWATCH, in preparation'],
];
const logos = [
  { group: 'White on black', light: false, items: [['Horizontal', 'sfdy-logo-horizontal-white.png', 'wide'], ['Square', 'sfdy-logo-square-white.png', 'sq']] },
  { group: 'Black on white', light: true, items: [['Horizontal', 'sfdy-logo-horizontal-black.png', 'wide'], ['Square', 'sfdy-logo-square-black.png', 'sq']] },
];
---

<Layout title="Press" description="Press resources: boilerplate, facts and logo downloads for Starflight Dynamics.">
  <Nav />

  <PageHero eyebrow="Press" narrow={false} bg="50% 70%">Press <span class="green">resources.</span></PageHero>

  <div class="body">
    <div class="wrap cols">
      <div class="main">
        <section>
          <h2 class="label">Boilerplate</h2>
          <p class="boiler">{BOILER}</p>
          <button type="button" class="copy mono" data-copy={BOILER} data-print-hide>Copy text</button>
        </section>
        <section>
          <h2 class="label tight">Facts</h2>
          <dl class="facts">
            {facts.map(([k, v]) => <><dt class="mono">{k}</dt><dd>{v}</dd></>)}
          </dl>
        </section>
        <section>
          <h2 class="label">Downloads</h2>
          <div class="dl-groups">
            {logos.map(g => (
              <div class="dl-group">
                <div class="mono sub">{g.group}</div>
                <div class="dl-grid">
                  {g.items.map(([label, file, shape]) => (
                    <a href={`${b}/images/press/${file}`} download class="dl">
                      <span class:list={['pv', { light: g.light }]}><img src={`${b}/images/press/${file}`} alt="" class={shape} /></span>
                      <span class="meta"><span>{label}</span><span class="mono fmt">PNG ↓</span></span>
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </section>
      </div>
      <aside class="contact">
        <div class="k">Press contact</div>
        <a href="mailto:press@starflight-dynamics.com">press@starflight-dynamics.com</a>
      </aside>
    </div>
  </div>

  <Footer />
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach(btn => {
    btn.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(btn.dataset.copy ?? ''); } catch {}
      btn.textContent = 'Copied';
      btn.classList.add('done');
      setTimeout(() => { btn.textContent = 'Copy text'; btn.classList.remove('done'); }, 1600);
    });
  });
</script>

<style>
  .body { padding: 0 var(--gutter) 96px; }
  .cols { display: flex; flex-wrap: wrap; gap: 56px 64px; align-items: flex-start; border-top: 1px solid var(--border-strong); padding-top: 48px; }
  .main { flex: 999 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 56px; }
  .label { margin-bottom: 16px; font-size: 12px; font-weight: 700; letter-spacing: .34em; text-transform: uppercase; color: var(--text-secondary); }
  .label.tight { margin-bottom: 4px; }
  .boiler { max-width: 720px; font-size: 19px; line-height: 1.7; font-weight: 300; color: rgba(255,255,255,.85); text-wrap: pretty; }
  .copy { margin-top: 20px; background: none; border: 1px solid var(--border-strong); padding: 9px 14px; cursor: pointer; letter-spacing: .14em; color: var(--text-secondary); }
  .copy:hover, .copy.done { border-color: var(--accent); color: var(--accent); }
  .facts { display: grid; grid-template-columns: minmax(140px, 220px) minmax(0, 1fr); }
  .facts dt { padding: 16px 16px 16px 0; border-bottom: 1px solid var(--border-subtle); color: var(--text-soft); }
  .facts dd { padding: 14px 0; border-bottom: 1px solid var(--border-subtle); font-size: 16px; font-weight: 300; }
  .dl-groups { display: flex; flex-direction: column; gap: 28px; }
  .dl-group { display: flex; flex-direction: column; gap: 10px; }
  .sub { color: var(--text-soft); }
  .dl-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }
  .dl { display: flex; flex-direction: column; background: var(--surface-1); border: 1px solid var(--border-subtle); color: #fff; }
  .dl:hover { border-color: var(--accent); color: #fff; }
  .pv { display: flex; align-items: center; justify-content: center; height: 150px; padding: 24px; background: #000; }
  .pv.light { background: #fff; }
  .pv .wide { max-width: 80%; max-height: 44px; width: auto; }
  .pv .sq { max-width: 50%; max-height: 96px; width: auto; }
  .meta { display: flex; justify-content: space-between; gap: 12px; padding: 14px 16px; border-top: 1px solid var(--border-subtle); font-size: 14px; font-weight: 300; }
  .fmt { color: var(--accent); white-space: nowrap; }
  .contact { flex: 1 0 240px; max-width: 320px; padding: 24px; background: var(--surface-1); border: 1px solid var(--border-subtle); border-top: 3px solid var(--accent); }
  .k { font-size: 10px; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; color: var(--text-soft); }
  .contact a { display: block; margin-top: 8px; font-size: 16px; color: var(--accent); word-break: break-word; }
  @media (max-width: 520px) { .facts { grid-template-columns: 1fr; } .facts dt { padding-bottom: 0; border-bottom: 0; } }
</style>
