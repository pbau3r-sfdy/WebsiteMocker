---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import PageHero from '../components/PageHero.astro';
import Footer from '../components/Footer.astro';
import { CAREERS_EMAIL } from '../data/careers';

const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const mails = [
  ['General', 'mission-control@starflight-dynamics.com'],
  ['Press', 'press@starflight-dynamics.com'],
  ['Careers', CAREERS_EMAIL],
];
---

<Layout title="Contact" description="Contact Starflight Dynamics in Munich and Vilnius.">
  <Nav active="contact" />

  <PageHero eyebrow="Contact" narrow={false} bg="50% 60%">Get in <span class="green">touch.</span></PageHero>

  <section class="body">
    <div class="wrap cols">
      <dl class="details">
        {mails.map(([k, v]) => (
          <div class="row">
            <dt>{k}</dt>
            <dd>
              <a href={`mailto:${v}`}>{v}</a>
            </dd>
          </div>
        ))}
        <div class="addr">
          <div class="row"><dt>Munich</dt><dd><span class="adr">Starflight Dynamics GmbH<br />Tal 44<br />80331 Munich<br />Germany</span></dd></div>
          <div class="row"><dt>Vilnius</dt><dd><span class="adr">Starflight Dynamics UAB<br />Gynėjų g. 4-333<br />LT-01110 Vilnius<br />Lithuania</span></dd></div>
        </div>
      </dl>

      <form action="https://api.web3forms.com/submit" method="POST" class="form">
        <input type="hidden" name="access_key" value="9989c0a0-65ba-45e5-aebf-c070acaaf430" />
        <input type="hidden" name="subject" value="New contact message — Starflight Dynamics" />
        <div class="pair">
          <label><span>Name</span><input type="text" name="name" required /></label>
          <label><span>Email</span><input type="email" name="email" required /></label>
        </div>
        <label><span>Message</span><textarea name="message" rows="7" required></textarea></label>
        <div class="send">
          <button type="submit">Send message</button>
          <p>We use your details only to answer your message. See <a href={`${b}/privacy-policy`}>Privacy</a>.</p>
        </div>
      </form>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .body { padding: 0 var(--gutter) 112px; }
  .cols { display: flex; flex-wrap: wrap; gap: 48px 64px; align-items: flex-start; }
  .details { flex: 1 1 340px; border-top: 1px solid var(--border-strong); }
  .row { padding: 20px 0; border-bottom: 1px solid var(--border-subtle); }
  dt { font-size: 10px; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; color: var(--text-muted); }
  dd { margin-top: 8px; }
  dd a { font-size: 18px; font-weight: 300; color: var(--accent); word-break: break-word; }
  .note { margin-top: 8px; font-size: 13px; }
  .addr { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0 32px; }
  .adr { display: block; font-size: 16px; line-height: 1.6; font-weight: 300; color: rgba(255,255,255,.80); }

  .form {
    flex: 1 1 460px; display: flex; flex-direction: column; gap: 20px; padding: 32px;
    background: var(--surface-1); border: 1px solid var(--border-subtle); border-top: 3px solid var(--accent);
  }
  .pair { display: flex; flex-wrap: wrap; gap: 20px; }
  .pair label { flex: 1 1 200px; }
  label { display: flex; flex-direction: column; gap: 8px; }
  label span { font-size: 10px; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; color: var(--text-soft); }
  input, textarea {
    padding: 13px 14px; background: #000; color: #fff; border: 1px solid var(--border-strong); border-radius: 0;
    font-family: var(--font-body); font-size: 15px; font-weight: 300; line-height: 1.6; outline: none;
  }
  textarea { resize: vertical; }
  input:focus, textarea:focus { border-color: var(--accent); }
  .send { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 24px; }
  button {
    padding: 13px 22px; background: var(--accent); color: #000; border: 1px solid var(--accent); border-radius: 0; cursor: pointer;
    font-family: var(--font-display); font-size: 12px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase;
  }
  button:hover { background: #fff; border-color: #fff; }
  .send p { flex: 1 1 240px; font-size: 13px; line-height: 1.5; color: var(--text-soft); }
  .send p a { color: rgba(255,255,255,.80); text-decoration: underline; }
  @media (max-width: 560px) { .form { padding: 24px 20px; } }
</style>
