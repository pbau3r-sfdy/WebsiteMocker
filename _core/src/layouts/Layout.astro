---
export interface Props {
  title:       string;
  description?: string;
  image?:      string;
}

const { title, description = '{{SITE_TAGLINE}}', image } = Astro.props;
const canonicalURL = Astro.url;
const siteName = '{{SITE_NAME}}';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:title"       content={`${title} — ${siteName}`} />
  <meta property="og:description" content={description} />
  <meta property="og:url"         content={canonicalURL} />
  <meta property="og:type"        content="website" />
  {image && <meta property="og:image" content={image} />}

  <!-- Fonts: self-hosted, place .woff2 files in public/fonts/ -->
  <!-- Replace these @font-face declarations with your actual font files -->
  <style>
    /* @font-face { font-family: 'YourFont'; src: url('/fonts/your-font.woff2') format('woff2'); } */
  </style>

  <title>{title} — {siteName}</title>

  <style is:global>
    /* ── Design tokens ──────────────────────────────────────── */
    :root {
      --bg:          {{BG_COLOR}};
      --bg-card:     {{CARD_COLOR}};
      --bg-nav:      {{NAV_COLOR}};
      --border:      {{BORDER_COLOR}};
      --text:        {{TEXT_COLOR}};
      --text-muted:  {{TEXT_MUTED_COLOR}};
      --accent:      {{ACCENT_COLOR}};
      --accent-dark: {{ACCENT_DARK_COLOR}};
      --accent-dim:  {{ACCENT_DIM_COLOR}};
      --radius:      8px;
      --font-head:   {{FONT_HEAD}}, system-ui, sans-serif;
      --font-body:   {{FONT_BODY}}, system-ui, sans-serif;
    }

    /* ── Reset ──────────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-body);
      font-size: 16px;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; height: auto; display: block; }

    /* ── Utility ─────────────────────────────────────────────── */
    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    @media (max-width: 640px) {
      .container { padding: 0 1rem; }
    }
  </style>
</head>
<body>
  <slot />
</body>
</html>
