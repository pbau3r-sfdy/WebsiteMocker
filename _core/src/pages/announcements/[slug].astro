---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import TagPill from '../../components/TagPill.astro';

export async function getStaticPaths() {
  const entries = await getCollection('announcements');
  return entries.map(entry => ({
    params: { slug: entry.id },
    props:  { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const formatted = entry.data.date.toLocaleDateString('en-GB', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<Layout
  title={entry.data.title}
  description={entry.data.summary}
>
  <Nav />
  <main class="main">
    <article class="article">
      <a href="/announcements" class="back mono">← All announcements</a>
      <header class="article-header">
        <time class="mono date" datetime={entry.data.date.toISOString().split('T')[0]}>
          {formatted}
        </time>
        <h1 class="article-title">{entry.data.title}</h1>
        <p class="article-summary">{entry.data.summary}</p>
        {entry.data.tags?.length && (
          <div class="tags">
            {entry.data.tags.map(t => <TagPill tag={t} />)}
          </div>
        )}
      </header>
      <div class="body">
        <Content />
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .main {
    padding: 72px var(--gutter) 120px;
  }
  .article {
    max-width: 760px;
    margin: 0 auto;
  }
  .back {
    display: inline-block;
    margin-bottom: 44px;
    font-size: .875rem;
    color: var(--text-muted);
    transition: color .2s;
    text-decoration: none;
  }
  .back:hover { color: var(--accent); }

  .article-header { margin-bottom: 36px; }
  .mono {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: var(--ls-eyebrow, .34em);
  }
  .date {
    display: block;
    color: var(--text-muted);
    margin-bottom: 16px;
  }
  .article-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 700;
    line-height: 1.14;
    margin-bottom: 1rem;
    text-wrap: balance;
    color: var(--text-primary);
  }
  .article-summary {
    font-size: 1.125rem;
    color: var(--text-muted);
    line-height: 1.7;
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
    margin-bottom: 1.5rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 1rem;
  }
  .body {
    font-family: var(--font-body);
    font-size: clamp(1.0625rem, 2vw, 1.5rem);
    font-weight: 300;
    color: var(--text-secondary);
    line-height: 1.55;
  }
  .body h2 {
    font-family: var(--font-display); font-size: 1.5rem; font-weight: 700;
    color: var(--text-primary); margin: 2.5rem 0 1rem;
  }
  .body h3 {
    font-family: var(--font-display); font-size: 1.25rem; font-weight: 600;
    color: var(--text-primary); margin: 2rem 0 .75rem;
  }
  .body p { margin-bottom: 1.25rem; }
  .body a { color: var(--accent); text-decoration: underline; }
  .body ul, .body ol { margin: 0 0 1.25rem 1.5rem; }
  .body li { margin-bottom: .4rem; }
  .body strong { color: var(--text-primary); font-weight: 600; }
  .body blockquote {
    border-left: 3px solid var(--accent);
    padding: .75rem 1.25rem; margin: 1.5rem 0;
    background: var(--surface-1); border-radius: 0 4px 4px 0;
  }
</style>
