---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import BlogCard from '../../components/BlogCard.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Blog" description="Articles, insights, and updates from our team.">
  <Nav />

  <main>
    <header>
      <div class="wrap head">
        <div class="eyebrow">BLOG</div>
        <h1>Blog</h1>
      </div>
    </header>

    {posts.length === 0 ? (
      <div class="empty-wrap">
        <p class="empty">No posts yet.</p>
      </div>
    ) : (
      <div class="grid">
        {posts.map(post => (
          <BlogCard
            id={post.id}
            title={post.data.title}
            date={post.data.date}
            author={post.data.author}
            image={post.data.image}
          />
        ))}
      </div>
    )}
  </main>

  <Footer />
</Layout>

<style>
  main { min-height: 100vh; }

  header {
    padding: 72px var(--gutter) 48px;
    border-bottom: 1px solid var(--border-subtle);
  }
  .head { display: flex; flex-direction: column; gap: 26px; }

  h1 {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6vw, 5rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--text-primary);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: var(--ls-eyebrow, .34em);
    color: var(--text-muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
    padding: 24px var(--gutter) 120px;
  }

  .empty-wrap { padding: 24px var(--gutter) 120px; }
  .empty { color: var(--text-muted); font-size: 1.125rem; }
</style>
