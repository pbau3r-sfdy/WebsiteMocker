---
export interface Props {
  id:      string;
  title:   string;
  date:    Date;
  author?: string;
  image?:  string;
}

const { id, title, date, author, image } = Astro.props;
const stamp = date.toLocaleDateString('en-GB', {
  day: '2-digit', month: 'short', year: 'numeric',
}).toUpperCase();
---

<a href={`/blog/${id}`} class="card">
  <div class="thumb">
    {image
      ? <img src={image} alt="" loading="lazy" />
      : <div class="placeholder"></div>
    }
  </div>
  <div class="body">
    <time class="mono date" datetime={date.toISOString().split('T')[0]}>{stamp}</time>
    <h3>{title}</h3>
    {author && <p class="author">{author}</p>}
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface-1);
    border: 1px solid var(--border-subtle);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition:
      border-color 200ms cubic-bezier(.2,.6,.2,1),
      transform 200ms cubic-bezier(.2,.6,.2,1);
  }
  .card:hover {
    border-color: var(--border-accent);
    transform: translateY(-2px);
  }

  .thumb {
    aspect-ratio: 16/10;
    overflow: hidden;
    background: var(--surface-2);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .3s;
  }
  .card:hover .thumb img { transform: scale(1.03); }
  .placeholder { width: 100%; height: 100%; }

  .body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px 16px;
  }

  .mono {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: var(--ls-eyebrow, .34em);
  }
  .date { color: var(--accent); }

  h3 {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text-primary);
  }

  .author {
    font-size: 11px;
    font-weight: 300;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }
</style>
