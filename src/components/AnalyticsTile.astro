---
/**
 * AnalyticsTile (ANLY-07): local-only, approximate Plausible aggregates.
 * Renders nothing in CI builds (the public sandbox dashboard) or without
 * _data/<slug>/analytics.json (written by _scripts/fetch-analytics-data.mjs).
 */
import { existsSync, readFileSync } from 'fs';
import { join, dirname, resolve } from 'path';

const { slug } = Astro.props;

// CI is detected by value: the string "false" or "0" must not count as CI.
const truthy = (v) => ['1', 'true', 'yes'].includes(String(v ?? '').trim().toLowerCase());
const inCI = truthy(process.env.GITHUB_ACTIONS) || truthy(process.env.CI);

// Repo root, independent of the cwd the build was started from: WM_ROOT, else the
// nearest ancestor of cwd that holds both _scripts/ and sites/, else cwd.
function repoRoot() {
  if (process.env.WM_ROOT) return resolve(process.env.WM_ROOT);
  for (let d = process.cwd(); ; d = dirname(d)) {
    if (existsSync(join(d, '_scripts')) && existsSync(join(d, 'sites'))) return d;
    if (dirname(d) === d) return process.cwd();
  }
}

let data = null;
if (!inCI && typeof slug === 'string' && /^[a-z0-9-]+$/.test(slug)) {
  const file = join(repoRoot(), '_data', slug, 'analytics.json');
  if (existsSync(file)) {
    try {
      data = JSON.parse(readFileSync(file, 'utf8'));
    } catch (e) {
      console.warn(`AnalyticsTile: cannot parse ${file}: ${e.message}`);
    }
  }
}
const fmt = (n) => (typeof n === 'number' ? n.toLocaleString('en-GB') : '–');
---
{data?.totals && (
  <div class="perf analytics">
    <span class="perf-item"><span class="k">Visitors</span><span class="v">{fmt(data.totals.visitors)}</span></span>
    <span class="perf-item"><span class="k">Pageviews</span><span class="v">{fmt(data.totals.pageviews)}</span></span>
    <span class="perf-item when">Plausible · approx. · 30 days · as of {data.fetched}</span>
  </div>
)}

<style>
  .perf { display: flex; flex-wrap: wrap; gap: 6px 18px; }
  .perf-item { display: inline-flex; gap: 6px; }
  .perf-item .k { color: var(--text-muted); text-transform: uppercase; letter-spacing: .08em; }
  .perf-item .v { color: var(--text-secondary); font-weight: 500; }
  .perf-item.when { color: var(--text-muted); }
</style>
