---
// Shared shell for the WebsiteMocker operator console (Websites + Documentation).
// Tokens follow the Starflight Dynamics Design System: white on black, green as
// the working accent, magenta only for attention, the Beam on the left edge.
interface Props {
  title: string;
  active: 'websites' | 'documentation';
}
const { title, active } = Astro.props;
const b = import.meta.env.BASE_URL.replace(/\/$/, '');
const tabs = [
  { key: 'websites',      label: 'Websites',      href: `${b}/` },
  { key: 'documentation', label: 'Documentation', href: `${b}/documentation/` },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title>{title} · WebsiteMocker</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&display=swap" />
  <style is:inline set:html={`
    @font-face{font-family:'Avenir Next';src:url('${b}/fonts/avenir-lt-light.woff2') format('woff2');font-weight:300;font-style:normal;font-display:swap;}
    @font-face{font-family:'Avenir Next';src:url('${b}/fonts/avenir-lt-heavy.woff2') format('woff2');font-weight:700;font-style:normal;font-display:swap;}
  `} />
  <slot name="head" />
</head>
<body>
  <div class="page-beam" aria-hidden="true"></div>

  <header class="top">
    <div class="top-inner">
      <a href={`${b}/`} class="brand" aria-label="WebsiteMocker home">
        <img src={`${b}/brand/sfdy-logo.png`} alt="Starflight Dynamics" width="122" height="28" />
        <span class="brand-sep" aria-hidden="true"></span>
        <span class="brand-name">WebsiteMocker</span>
      </a>
      <nav class="tabs" aria-label="Sections">
        {tabs.map(t => (
          <a href={t.href} aria-current={t.key === active ? 'page' : undefined}>{t.label}</a>
        ))}
      </nav>
      <div class="top-tools"><slot name="tools" /></div>
    </div>
  </header>

  <main class="wrap">
    <slot />
  </main>

  <footer class="wrap">
    <div class="foot">
      <span>Sandbox · never indexed</span>
      <span>github.com/pbau3r-sfdy/WebsiteMocker</span>
    </div>
  </footer>
</body>
</html>

<style is:global>
  :root {
    /* Brand primaries */
    --sfdy-blue: #0432FF;
    --sfdy-cyan: #00FDFF;
    --sfdy-green: #00FB92;
    --sfdy-magenta: #FF008A;

    /* Ink ramp */
    --ink-900: #06070A;
    --ink-850: #0B0D12;
    --ink-800: #101319;
    --ink-700: #171B22;

    /* Semantic */
    --bg-base: #000;
    --surface-1: var(--ink-900);
    --surface-2: var(--ink-800);
    --text-primary: #fff;
    --text-secondary: rgba(255,255,255,.70);
    --text-soft: rgba(255,255,255,.56);
    --text-muted: rgba(255,255,255,.40);
    --border-subtle: rgba(255,255,255,.14);
    --border-faint: rgba(255,255,255,.08);
    --border-strong: rgba(255,255,255,.24);
    --accent: var(--sfdy-green);
    --accent-soft: rgba(0,251,146,.16);
    --border-accent: rgba(0,251,146,.40);
    --info: var(--sfdy-cyan);
    --info-soft: rgba(0,253,255,.12);
    --attention: var(--sfdy-magenta);
    --attention-soft: rgba(255,0,138,.14);
    --attention-line: rgba(255,0,138,.45);
    --beam: linear-gradient(180deg, var(--sfdy-blue) 0%, var(--sfdy-cyan) 33%, var(--sfdy-green) 65%, var(--sfdy-green) 100%);

    /* Type */
    --font-display: "Avenir Next", "Mulish", "Segoe UI", system-ui, sans-serif;
    --font-body: "Avenir Next", "Mulish", "Segoe UI", system-ui, sans-serif;
    --font-mono: "IBM Plex Mono", ui-monospace, "SF Mono", Menlo, monospace;
    --ls-eyebrow: .34em;

    /* Layout */
    --gutter: clamp(20px, 5vw, 72px);
    --measure: 1180px;
    --nav-h: 76px;
    --ease: cubic-bezier(.2,.6,.2,1);
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { color-scheme: dark; }
  body {
    background: var(--bg-base);
    color: var(--text-primary);
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 15px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }
  a { color: inherit; text-decoration: none; }
  ::selection { background: var(--sfdy-green); color: #000; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  code { font-family: var(--font-mono); font-size: .92em; }

  .wrap { width: 100%; max-width: calc(var(--measure) + 2 * var(--gutter)); margin: 0 auto; padding-left: var(--gutter); padding-right: var(--gutter); }

  /* The Beam — vertical, touching the left edge */
  .page-beam { position: fixed; left: 0; top: 0; bottom: 0; width: 7px; background: var(--beam); z-index: 20; }

  /* Header */
  .top {
    position: sticky; top: 0; z-index: 10;
    background: rgba(0,0,0,.88);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border-subtle);
  }
  .top-inner {
    max-width: calc(var(--measure) + 2 * var(--gutter));
    margin: 0 auto;
    padding: 0 var(--gutter);
    height: var(--nav-h);
    display: flex; align-items: center; gap: 40px;
  }
  .brand { display: flex; align-items: center; gap: 16px; flex: none; }
  .brand img { height: 28px; width: auto; display: block; }
  .brand-sep { width: 1px; height: 22px; background: var(--border-strong); }
  .brand-name {
    font-family: var(--font-display); font-weight: 700; font-size: 12px;
    letter-spacing: .22em; text-transform: uppercase; color: var(--text-secondary);
  }
  .tabs { display: flex; gap: 28px; align-self: stretch; }
  .tabs a {
    display: flex; align-items: center;
    font-family: var(--font-display); font-weight: 700; font-size: 12px;
    letter-spacing: .2em; text-transform: uppercase;
    color: var(--text-muted);
    border-bottom: 2px solid transparent; margin-bottom: -1px;
    transition: color .2s var(--ease), border-color .2s var(--ease);
  }
  .tabs a:hover { color: var(--text-primary); }
  .tabs a[aria-current="page"] { color: var(--text-primary); border-bottom-color: var(--accent); }
  .top-tools { margin-left: auto; display: flex; align-items: center; gap: 16px; }

  main.wrap { flex: 1; padding-top: 72px; padding-bottom: 96px; }

  /* Shared type */
  .eyebrow {
    font-family: var(--font-display); font-weight: 700; font-size: 11px;
    letter-spacing: var(--ls-eyebrow); text-transform: uppercase; color: var(--text-soft);
  }
  .eyebrow.accent { color: var(--accent); }
  .mono { font-family: var(--font-mono); font-size: 11px; letter-spacing: .12em; text-transform: uppercase; }
  .page-head { margin-bottom: 56px; }
  .page-head h1 {
    margin-top: 16px;
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(36px, 5.5vw, 64px); line-height: 1.02;
    letter-spacing: .02em; text-transform: uppercase;
  }
  .page-head h1 .g { color: var(--accent); }
  .page-head p { margin-top: 18px; max-width: 640px; font-size: 17px; line-height: 1.65; color: var(--text-secondary); }

  /* Badge (Design System: Badge) */
  .badge {
    display: inline-flex; align-items: center; gap: 7px;
    font-family: var(--font-display); font-weight: 700; font-size: 10px;
    letter-spacing: .14em; text-transform: uppercase; line-height: 1;
    padding: 6px 10px; border-radius: 999px; white-space: nowrap;
    color: var(--text-secondary); border: 1px solid var(--border-strong); background: rgba(255,255,255,.04);
  }
  .badge .dot { width: 6px; height: 6px; border-radius: 50%; background: currentColor; flex: none; }
  .badge.neutral { color: var(--text-muted); border-color: var(--border-subtle); background: transparent; }
  .badge.info { color: var(--info); border-color: rgba(0,253,255,.4); background: var(--info-soft); }
  .badge.active { color: var(--accent); border-color: var(--border-accent); background: var(--accent-soft); }
  .badge.solid { color: #000; border-color: var(--accent); background: var(--accent); }
  .badge.attention { color: var(--attention); border-color: var(--attention-line); background: var(--attention-soft); }

  /* Buttons (square, as on the published sites) */
  .btn {
    display: inline-flex; align-items: center; gap: 6px;
    font-family: var(--font-display); font-weight: 700; font-size: 10px;
    letter-spacing: .16em; text-transform: uppercase; line-height: 1;
    padding: 10px 14px; white-space: nowrap; cursor: pointer;
    color: var(--text-secondary); background: transparent;
    border: 1px solid var(--border-strong);
    transition: color .2s var(--ease), border-color .2s var(--ease), background .2s var(--ease);
  }
  .btn:hover { color: var(--text-primary); border-color: rgba(255,255,255,.5); }
  .btn.primary { color: var(--accent); border-color: var(--border-accent); }
  .btn.primary:hover { color: #000; background: var(--accent); border-color: var(--accent); }
  .btn.solid { color: #000; background: var(--accent); border-color: var(--accent); }
  .btn.solid:hover { background: transparent; color: var(--accent); }
  .btn.quiet { border-color: transparent; color: var(--text-muted); padding-left: 8px; padding-right: 8px; }
  .btn.quiet:hover { color: var(--text-primary); border-color: transparent; }
  .btn.danger:hover { color: var(--attention); }

  /* Footer */
  .foot {
    display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
    padding-top: 24px; padding-bottom: 32px;
    border-top: 1px solid var(--border-faint);
    font-family: var(--font-mono); font-size: 10px; letter-spacing: .12em; text-transform: uppercase;
    color: var(--text-muted);
  }

  @media (max-width: 720px) {
    .top-inner { gap: 20px; }
    .brand-sep, .brand-name { display: none; }
    .brand img { height: 22px; }
    .tabs { gap: 18px; }
    .tabs a { font-size: 10px; letter-spacing: .14em; }
    .top-tools { display: none; }
    main.wrap { padding-top: 48px; }
    .page-head { margin-bottom: 40px; }
  }
</style>
