---
import { readFileSync, readdirSync, existsSync } from 'fs';
import { join, resolve } from 'path';

// ── Read all sites from sites/*/wiring.json ──────────────────────────
const sitesDir = resolve('sites');
let sites = [];

if (existsSync(sitesDir)) {
  const dirs = readdirSync(sitesDir, { withFileTypes: true })
    .filter(d => d.isDirectory())
    .map(d => d.name);

  for (const name of dirs) {
    const wiringPath = join(sitesDir, name, 'wiring.json');
    if (existsSync(wiringPath)) {
      try {
        const data = JSON.parse(readFileSync(wiringPath, 'utf-8'));
        sites.push({ ...data, _slug: name });
      } catch {
        sites.push({ _slug: name, site: name, stage: 0, domain: null, sandbox_url: null, last_deploy: null });
      }
    } else {
      sites.push({ _slug: name, site: name, stage: 0, domain: null, sandbox_url: null, last_deploy: null });
    }
  }
}

// Sort: highest stage first, then alphabetical
sites.sort((a, b) => (b.stage ?? 0) - (a.stage ?? 0) || a._slug.localeCompare(b._slug));

// ── Stage metadata ───────────────────────────────────────────────────
const STAGES = [
  { n: 0, label: 'Captured',      color: '#4a4843', bg: 'rgba(74,72,67,.18)' },
  { n: 1, label: 'Instantiated',  color: '#e8a030', bg: 'rgba(232,160,48,.12)' },
  { n: 2, label: 'Content Ready', color: '#5b8eed', bg: 'rgba(91,142,237,.12)' },
  { n: 3, label: 'Wired',         color: '#9b72cf', bg: 'rgba(155,114,207,.12)' },
  { n: 4, label: 'Legal OK',      color: '#e06a30', bg: 'rgba(224,106,48,.12)' },
  { n: 5, label: 'Prod Ready',    color: '#4db37e', bg: 'rgba(77,179,126,.12)' },
  { n: 6, label: 'Live',          color: '#22c55e', bg: 'rgba(34,197,94,.12)' },
];

function stageMeta(n) {
  return STAGES[Math.min(Math.max(n ?? 0, 0), 6)];
}

// ── Wiring summary ───────────────────────────────────────────────────
function wiringSummary(site) {
  const items = [];
  const s = site.newsletter?.status;
  items.push(s === 'configured' ? '✉ Newsletter ✓' : '✉ Newsletter —');
  const f = site.forms?.contact?.status;
  items.push(f === 'configured' ? '⊟ Forms ✓' : '⊟ Forms —');
  const so = site.socials?.status;
  items.push(so === 'configured' ? '⊕ Socials ✓' : '⊕ Socials —');
  return items;
}

const buildDate = new Date().toISOString().slice(0, 10);
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>WebsiteMocker — Dashboard</title>
  <style>
    :root {
      --bg:      #111110;
      --surface: #1c1b19;
      --s2:      #252320;
      --border:  #2e2c28;
      --text:    #e5e2da;
      --muted:   #7e7b73;
      --dim:     #4a4843;
      --accent:  #e8a030;
      --adim:    rgba(232,160,48,.12);
      --radius:  6px;
      --mono:    "SF Mono","Fira Code","Consolas",monospace;
      --sans:    system-ui,-apple-system,"Segoe UI",sans-serif;
    }
    @media (prefers-color-scheme: light) { :root {
      --bg:#f7f5f1; --surface:#fff; --s2:#eeece8; --border:#dedad2;
      --text:#1a1917; --muted:#6b6860; --dim:#b0ada6; --accent:#c47d10;
      --adim:rgba(196,125,16,.10);
    }}
    :root[data-theme="light"] {
      --bg:#f7f5f1; --surface:#fff; --s2:#eeece8; --border:#dedad2;
      --text:#1a1917; --muted:#6b6860; --dim:#b0ada6; --accent:#c47d10;
      --adim:rgba(196,125,16,.10);
    }
    :root[data-theme="dark"] {
      --bg:#111110; --surface:#1c1b19; --s2:#252320; --border:#2e2c28;
      --text:#e5e2da; --muted:#7e7b73; --dim:#4a4843;
      --accent:#e8a030; --adim:rgba(232,160,48,.12);
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--bg); color: var(--text); font-family: var(--sans);
           font-size: 14px; line-height: 1.6; -webkit-font-smoothing: antialiased; }
    a { color: inherit; text-decoration: none; }

    /* header */
    .header {
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      padding: 0 2rem;
      height: 56px;
      display: flex;
      align-items: center;
      gap: 1.5rem;
      position: sticky;
      top: 0;
      z-index: 10;
    }
    .logo { font-family: var(--mono); font-size: 13px; font-weight: 700; color: var(--accent); }
    .header-meta { font-size: 12px; color: var(--dim); margin-left: auto; }
    .header-meta span { color: var(--muted); }

    /* main */
    .main { max-width: 1100px; margin: 0 auto; padding: 2.5rem 2rem 6rem; }

    /* pipeline */
    .pipeline-strip {
      display: flex;
      gap: 0;
      margin-bottom: 3rem;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
    }
    .ps-stage {
      flex: 1;
      padding: .75rem .5rem;
      text-align: center;
      border-right: 1px solid var(--border);
      cursor: default;
    }
    .ps-stage:last-child { border-right: none; }
    .ps-num {
      font-family: var(--mono);
      font-size: 16px;
      font-weight: 700;
      margin-bottom: .2rem;
    }
    .ps-label { font-size: 10px; color: var(--muted); }
    .ps-count { font-family: var(--mono); font-size: 11px; font-weight: 600; margin-top: .15rem; }

    /* section header */
    .section-head {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      margin-bottom: 1rem;
    }
    .section-head h2 { font-size: 14px; font-weight: 600; color: var(--text); }
    .section-head .count {
      font-family: var(--mono);
      font-size: 11px;
      color: var(--dim);
    }

    /* site card */
    .site-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      margin-bottom: .75rem;
      transition: border-color .15s;
    }
    .site-card:hover { border-color: var(--dim); }
    .card-main {
      display: grid;
      grid-template-columns: 180px 140px 1fr auto;
      gap: 1rem;
      padding: 1rem 1.25rem;
      align-items: center;
    }
    .site-name { font-family: var(--mono); font-size: 13px; font-weight: 700; color: var(--text); }
    .site-url  { font-family: var(--mono); font-size: 10px; color: var(--dim); margin-top: .2rem; word-break: break-all; }
    .stage-badge {
      display: inline-flex;
      align-items: center;
      gap: .35rem;
      font-family: var(--mono);
      font-size: 11px;
      font-weight: 600;
      padding: .25rem .65rem;
      border-radius: 20px;
      white-space: nowrap;
    }
    .badge-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
    .wiring-chips { display: flex; flex-wrap: wrap; gap: .4rem; }
    .chip {
      font-size: 10px;
      color: var(--dim);
      padding: .15rem .45rem;
      border: 1px solid var(--border);
      border-radius: 3px;
    }
    .chip.ok { color: var(--muted); border-color: var(--dim); }
    .card-actions { display: flex; gap: .5rem; }
    .btn {
      font-family: var(--mono);
      font-size: 11px;
      padding: .3rem .7rem;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      color: var(--muted);
      background: transparent;
      cursor: pointer;
      white-space: nowrap;
      transition: color .15s, border-color .15s;
    }
    .btn:hover { color: var(--text); border-color: var(--dim); }
    .btn.primary { color: var(--accent); border-color: var(--accent); }
    .btn.primary:hover { background: var(--adim); }

    /* empty state */
    .empty {
      text-align: center;
      padding: 4rem 2rem;
      color: var(--dim);
    }
    .empty h3 { font-size: 14px; color: var(--muted); margin-bottom: .5rem; }
    .empty p { font-size: 12px; }
    .empty code {
      font-family: var(--mono);
      color: var(--accent);
      background: var(--adim);
      padding: .1em .4em;
      border-radius: 3px;
    }

    @media (max-width: 700px) {
      .card-main { grid-template-columns: 1fr auto; }
      .wiring-chips, .card-actions { display: none; }
      .pipeline-strip { overflow-x: auto; }
      .ps-stage { min-width: 80px; }
    }
  </style>
</head>
<body>

<header class="header">
  <span class="logo">WebsiteMocker</span>
  <span class="header-meta">
    <span>{sites.length} site{sites.length !== 1 ? 's' : ''}</span>
    &nbsp;·&nbsp; built {buildDate}
  </span>
</header>

<main class="main">

  <!-- Stage pipeline summary -->
  <div class="pipeline-strip">
    {STAGES.map(st => {
      const count = sites.filter(s => (s.stage ?? 0) === st.n).length;
      return (
        <div class="ps-stage">
          <div class="ps-num" style={`color:${st.color}`}>{st.n}</div>
          <div class="ps-label">{st.label}</div>
          {count > 0 && <div class="ps-count" style={`color:${st.color}`}>{count}</div>}
        </div>
      );
    })}
  </div>

  <!-- Site cards -->
  {sites.length === 0 ? (
    <div class="empty">
      <h3>No sites yet</h3>
      <p>Run <code>/wm-new-site</code> or <code>/wm-capture</code> to add your first site.</p>
    </div>
  ) : (
    <div>
      <div class="section-head">
        <h2>Sites</h2>
        <span class="count">{sites.length} total</span>
      </div>
      {sites.map(site => {
        const st = stageMeta(site.stage);
        const chips = wiringSummary(site);
        const sandboxUrl = site.sandbox_url
          ? `https://pbau3r-sfdy.github.io/WebsiteMocker/${site._slug}`
          : `https://pbau3r-sfdy.github.io/WebsiteMocker/${site._slug}`;
        return (
          <div class="site-card">
            <div class="card-main">
              <div>
                <div class="site-name">{site.name || site.site || site._slug}</div>
                <div class="site-url">{sandboxUrl}</div>
                {site.domain && <div class="site-url" style="color:var(--muted)">{site.domain}</div>}
              </div>
              <span class="stage-badge" style={`color:${st.color};background:${st.bg}`}>
                <span class="badge-dot" style={`background:${st.color}`}></span>
                {st.label}
              </span>
              <div class="wiring-chips">
                {chips.map(c => (
                  <span class={`chip ${c.endsWith('✓') ? 'ok' : ''}`}>{c}</span>
                ))}
              </div>
              <div class="card-actions">
                <a href={sandboxUrl} target="_blank" rel="noopener" class="btn">Preview ↗</a>
                {(site.stage ?? 0) < 6 && <span class="btn primary">Wire</span>}
                {(site.stage ?? 0) >= 5 && <span class="btn primary">Deploy</span>}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  )}
</main>

</body>
</html>
