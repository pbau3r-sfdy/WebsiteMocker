---
import { readFileSync, readdirSync, existsSync } from 'fs';
import { join, resolve } from 'path';

// ── Perf data helpers ─────────────────────────────────────────────
function loadPerf(slug) {
  const perfPath = join(resolve('_data'), slug, 'perf.json');
  if (!existsSync(perfPath)) return null;
  try {
    const { history } = JSON.parse(readFileSync(perfPath, 'utf-8'));
    if (!history?.length) return null;
    return {
      latest: history[history.length - 1],
      prev:   history.length > 1 ? history[history.length - 2] : null,
    };
  } catch { return null; }
}

function scoreColor(n) {
  if (n >= 90) return '#00FB92';
  if (n >= 50) return '#00FDFF';
  return '#ef4444';
}

function cwvColor(status) {
  if (status === 'good')              return '#00FB92';
  if (status === 'needs-improvement') return '#00FDFF';
  if (status === 'poor')              return '#ef4444';
  return 'var(--dim)';
}

function trendLabel(curr, prev) {
  if (prev === null || prev === undefined) return null;
  const d = curr - prev;
  if (d > 0) return { text: `↑${d}`, color: '#22c55e' };
  if (d < 0) return { text: `↓${Math.abs(d)}`, color: '#ef4444' };
  return { text: '→', color: 'var(--dim)' };
}

// ── Read all sites from sites/*/wiring.json ───────────────────────
const sitesDir = resolve('sites');
let sites = [];

if (existsSync(sitesDir)) {
  const dirs = readdirSync(sitesDir, { withFileTypes: true })
    .filter(d => d.isDirectory())
    .map(d => d.name);

  for (const name of dirs) {
    const wiringPath = join(sitesDir, name, 'wiring.json');
    if (existsSync(wiringPath)) {
      try {
        const data = JSON.parse(readFileSync(wiringPath, 'utf-8'));
        sites.push({ ...data, _slug: name });
      } catch {
        sites.push({ _slug: name, site: name, stage: 0 });
      }
    } else {
      sites.push({ _slug: name, site: name, stage: 0 });
    }
  }
}

// Sort: highest stage first, then alphabetical
sites.sort((a, b) => (b.stage ?? 0) - (a.stage ?? 0) || a._slug.localeCompare(b._slug));

// Attach perf data
sites = sites.map(s => ({ ...s, _perf: loadPerf(s._slug) }));

// ── Split into three sections ─────────────────────────────────────
// active   — normal working sites (no flags)
// template — design captures / remix bases (template: true in wiring.json)
// archived — retired (archived: true in wiring.json)
const activeSites   = sites.filter(s => !s.template && !s.archived);
const templateSites = sites.filter(s =>  s.template === true && !s.archived);
const archivedSites = sites.filter(s =>  s.archived === true);

// All sites in one flat array with their section tag — rendered into
// a hidden staging div and distributed to the right containers by JS.
const allSitesStaged = [
  ...activeSites.map(s  => ({ ...s, _section: 'active'   })),
  ...templateSites.map(s => ({ ...s, _section: 'template' })),
  ...archivedSites.map(s => ({ ...s, _section: 'archived' })),
];

// ── Stage metadata ────────────────────────────────────────────────
const STAGES = [
  { n: 0, label: 'Captured',      color: 'rgba(255,255,255,.25)', bg: 'rgba(255,255,255,.03)' },
  { n: 1, label: 'Instantiated',  color: '#5b6dff',               bg: 'rgba(91,109,255,.10)' },
  { n: 2, label: 'Content Ready', color: '#5b8eed',               bg: 'rgba(91,142,237,.10)' },
  { n: 3, label: 'Wired',         color: '#9b72cf',               bg: 'rgba(155,114,207,.10)' },
  { n: 4, label: 'Legal OK',      color: '#00FDFF',               bg: 'rgba(0,253,255,.07)' },
  { n: 5, label: 'Prod Ready',    color: '#00FB92',               bg: 'rgba(0,251,146,.07)' },
  { n: 6, label: 'Live',          color: '#00FB92',               bg: 'rgba(0,251,146,.12)' },
];

function stageMeta(n) {
  return STAGES[Math.min(Math.max(n ?? 0, 0), 6)];
}

function wiringSummary(site) {
  const items = [];
  const s = site.newsletter?.status;
  items.push(s === 'configured' ? '✉ Newsletter ✓' : '✉ Newsletter —');
  const f = site.forms?.contact?.status;
  items.push(f === 'configured' ? '⊟ Forms ✓' : '⊟ Forms —');
  const so = site.socials?.status;
  items.push(so === 'configured' ? '⊕ Socials ✓' : '⊕ Socials —');
  return items;
}

const buildDate = new Date().toISOString().slice(0, 10);
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>WebsiteMocker — Dashboard</title>
  <style>
    /* ── SFDY Design System ──────────────────────────────────────── */
    :root {
      --bg:      #000000;
      --surface: #06070A;
      --s2:      #0D1017;
      --border:  rgba(255,255,255,.10);
      --text:    #FFFFFF;
      --muted:   rgba(255,255,255,.65);
      --dim:     rgba(255,255,255,.30);
      --accent:  #00FB92;
      --adim:    rgba(0,251,146,.08);
      --blue:    #0432FF;
      --cyan:    #00FDFF;
      --radius:  3px;
      --mono:    "IBM Plex Mono","SF Mono","Fira Code","Consolas",monospace;
      --sans:    "Avenir Next","Mulish",system-ui,-apple-system,sans-serif;
      --beam:    linear-gradient(180deg,#0432FF 0%,#00FDFF 33%,#00FB92 65%,#00FB92 100%);
    }
    /* Single-theme commitment — SFDY is always dark */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--bg); color: var(--text); font-family: var(--sans);
           font-size: 14px; line-height: 1.6; -webkit-font-smoothing: antialiased; }
    a { color: inherit; text-decoration: none; }

    /* header */
    .header {
      background: #000;
      border-bottom: 1px solid rgba(255,255,255,.10);
      padding: 0 2rem 0 0;
      height: 72px;
      display: flex;
      align-items: center;
      gap: 1.5rem;
      position: sticky;
      top: 0;
      z-index: 10;
    }
    /* 7px vertical beam strip on the left edge */
    .header-beam {
      width: 7px;
      flex-shrink: 0;
      align-self: stretch;
      background: var(--beam);
    }
    .header-sep {
      width: 1px;
      height: 24px;
      background: rgba(255,255,255,.14);
      flex-shrink: 0;
    }
    .logo {
      font-family: var(--sans);
      font-size: 14px;
      font-weight: 800;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--text);
    }
    .logo-accent { color: var(--accent); }
    .header-meta { font-family: var(--mono); font-size: 11px; color: var(--dim); margin-left: auto; }
    .header-meta span { color: var(--muted); }

    /* main */
    .main { max-width: 1200px; margin: 0 auto; padding: 2.5rem 2.5rem 6rem; }

    /* pipeline */
    .pipeline-strip {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 0;
      margin-bottom: 3rem;
      background: var(--surface);
      border: 1px solid rgba(255,255,255,.10);
      overflow: hidden;
    }
    .ps-stage {
      padding: .9rem .5rem;
      text-align: center;
      border-right: 1px solid rgba(255,255,255,.08);
      cursor: default;
    }
    .ps-stage:last-child {
      border-right: none;
      border: 1px solid rgba(0,251,146,.25);
      background: rgba(0,251,146,.04);
    }
    .ps-num  { font-family: var(--mono); font-size: 18px; font-weight: 700; margin-bottom: .25rem; }
    .ps-label { font-size: 9px; letter-spacing: .08em; text-transform: uppercase; color: var(--dim); }
    .ps-count { font-family: var(--mono); font-size: 12px; font-weight: 700; margin-top: .2rem; }

    /* section header */
    .section-head {
      display: flex;
      align-items: baseline;
      gap: 1rem;
      margin-bottom: 1.25rem;
    }
    .section-head h2 {
      font-family: var(--sans);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .2em;
      text-transform: uppercase;
      color: var(--text);
    }
    .section-head .count { font-family: var(--mono); font-size: 11px; color: var(--dim); }

    /* site card */
    .site-card {
      background: #080B0F;
      border: 1px solid rgba(255,255,255,.10);
      border-radius: 0;
      margin-bottom: .5rem;
      transition: border-color .15s;
    }
    .site-card:hover { border-color: rgba(255,255,255,.25); }
    .card-main {
      display: grid;
      grid-template-columns: 180px 140px 1fr auto;
      gap: 1rem;
      padding: 1rem 1.25rem;
      align-items: center;
    }
    .site-name { font-family: var(--mono); font-size: 13px; font-weight: 700; color: var(--text); }
    .site-url  { font-family: var(--mono); font-size: 10px; color: var(--dim); margin-top: .2rem; word-break: break-all; }
    .stage-badge {
      display: inline-flex; align-items: center; gap: .35rem;
      font-family: var(--mono); font-size: 11px; font-weight: 600;
      padding: .25rem .65rem; border-radius: 20px; white-space: nowrap;
    }
    .badge-dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
    .wiring-chips { display: flex; flex-wrap: wrap; gap: .4rem; }
    .chip {
      font-size: 10px; color: var(--dim);
      padding: .15rem .45rem; border: 1px solid var(--border); border-radius: 3px;
    }
    .chip.ok { color: var(--muted); border-color: var(--dim); }
    .chip.template-chip { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 40%, transparent); }
    .card-actions { display: flex; gap: .5rem; align-items: center; }
    .btn {
      font-family: var(--mono); font-size: 11px;
      padding: .3rem .7rem; border: 1px solid var(--border);
      border-radius: var(--radius); color: var(--muted);
      background: transparent; cursor: pointer;
      white-space: nowrap; transition: color .15s, border-color .15s;
    }
    .btn:hover   { color: var(--text); border-color: var(--dim); }
    .btn.primary { color: var(--accent); border-color: var(--accent); }
    .btn.primary:hover { background: var(--adim); }
    .btn.live    { color: var(--accent); border-color: var(--accent); }
    .btn.live:hover { background: var(--adim); }
    .btn.restore:hover { color: #22c55e; border-color: #22c55e; }
    .btn.rename-btn:hover  { color: #a78bfa; border-color: #a78bfa; }
    .btn.delete-btn:hover  { color: #ef4444; border-color: #ef4444; }

    /* perf row */
    .card-perf {
      display: flex; align-items: center; gap: 1.5rem;
      padding: .55rem 1.25rem; border-top: 1px solid var(--border);
      background: var(--s2); border-radius: 0 0 var(--radius) var(--radius);
      flex-wrap: wrap;
    }
    .perf-scores { display: flex; gap: 1rem; align-items: center; }
    .perf-score  { font-family: var(--mono); font-size: 11px; }
    .perf-score-label { color: var(--dim); font-size: 10px; margin-right: .25rem; }
    .perf-score-value { font-weight: 700; }
    .perf-sep { width: 1px; height: 14px; background: var(--border); flex-shrink: 0; }
    .perf-cwv  { display: flex; gap: .75rem; font-family: var(--mono); font-size: 11px; }
    .perf-cwv-item { display: flex; align-items: center; gap: .25rem; }
    .perf-cwv-label { color: var(--dim); font-size: 10px; }
    .perf-meta  { margin-left: auto; font-size: 10px; color: var(--dim); white-space: nowrap; }
    .perf-trend { font-family: var(--mono); font-size: 11px; font-weight: 700; }
    .perf-empty {
      padding: .45rem 1.25rem; border-top: 1px solid var(--border);
      background: var(--s2); border-radius: 0 0 var(--radius) var(--radius);
      font-size: 10px; color: var(--dim); font-family: var(--mono);
    }

    /* ── Section drawers (templates + archive) ── */
    .section-drawer { margin-top: 2.5rem; border-top: 1px solid var(--border); }
    #archive-section { border-top: 1px solid rgba(239,68,68,.35); }
    #archive-section {
      border: 1px solid rgba(239,68,68,.35);
      border-radius: 0;
      padding: 0 1rem;
      background: rgba(239,68,68,.03);
      margin-top: 2.5rem;
    }
    #archive-section .section-toggle { color: rgba(239,68,68,.6); }
    #archive-section .section-toggle:hover { color: rgba(239,68,68,.85); }
    #archive-section .section-badge { border-color: rgba(239,68,68,.3); color: rgba(239,68,68,.6); background: rgba(239,68,68,.06); }
    .section-toggle {
      display: flex; align-items: center; gap: .6rem;
      width: 100%; background: none; border: none;
      padding: .9rem 0; cursor: pointer; text-align: left;
      color: var(--dim); font-family: var(--sans);
      font-size: 10px; font-weight: 800; letter-spacing: .18em; text-transform: uppercase;
    }
    .section-toggle:hover { color: var(--muted); }
    .section-chevron { font-size: 9px; transition: transform .18s; display: inline-block; }
    .section-drawer.open .section-chevron { transform: rotate(90deg); }
    .section-badge {
      font-family: var(--mono); font-size: 10px;
      padding: .1rem .45rem; background: var(--s2);
      border: 1px solid var(--border); border-radius: 20px; color: var(--dim);
    }
    .section-body { display: none; padding-bottom: 3rem; }
    .section-drawer.open .section-body { display: block; }
    .section-hint {
      font-size: 11px; color: var(--dim);
      margin-bottom: 1.25rem; line-height: 1.8;
    }
    .section-hint code {
      font-family: var(--mono); font-size: 10px;
      background: var(--s2); border: 1px solid var(--border);
      padding: .1em .4em; border-radius: 3px;
    }
    /* archived cards look slightly dimmed */
    #archive-list .site-card { opacity: .65; transition: opacity .15s; }
    #archive-list .site-card:hover { opacity: 1; }

    /* toast */
    .wm-toast {
      position: fixed; bottom: 2rem; left: 50%;
      transform: translateX(-50%) translateY(.5rem);
      background: var(--surface); border: 1px solid var(--border);
      border-radius: var(--radius); padding: .55rem 1.1rem;
      font-family: var(--mono); font-size: 11px; color: var(--muted);
      opacity: 0; transition: opacity .18s, transform .18s;
      pointer-events: none; z-index: 200; white-space: nowrap;
    }
    .wm-toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

    /* apply-changes overlay */
    .apply-overlay {
      position: fixed; inset: 0; background: rgba(0,0,0,.5);
      z-index: 300; display: none; align-items: center; justify-content: center;
      pointer-events: none;
    }
    .apply-overlay.open { display: flex; pointer-events: auto; }
    .apply-panel {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: var(--radius); padding: 1.75rem 2rem;
      max-width: 640px; width: 92%; max-height: 90vh; overflow-y: auto;
    }
    .apply-panel h3 { font-family: var(--mono); font-size: 13px; font-weight: 700; margin-bottom: 1rem; }
    .apply-changes-list { font-size: 11px; color: var(--muted); margin-bottom: 1.25rem; line-height: 2; }
    .apply-changes-list strong { color: var(--text); }
    .apply-cmd-block {
      font-family: var(--mono); font-size: 11px;
      background: var(--s2); border: 1px solid var(--border);
      border-radius: var(--radius); padding: .85rem 1rem;
      white-space: pre; overflow-x: auto; display: block;
      color: var(--text); margin-bottom: .75rem;
    }
    .apply-hint { font-size: 10px; color: var(--dim); margin-bottom: 1.5rem; line-height: 1.7; }
    .apply-hint code { font-family: var(--mono); }
    .apply-actions { display: flex; gap: .75rem; justify-content: flex-end; }
    .btn.apply-trigger { gap: .4rem; }
    #apply-count-badge {
      display: inline-flex; align-items: center; justify-content: center;
      font-family: var(--mono); font-size: 10px; font-weight: 700;
      min-width: 16px; height: 16px; padding: 0 4px;
      background: var(--accent); color: #000; border-radius: 20px;
      margin-left: .3rem;
    }

    @media (max-width: 700px) {
      .card-main { grid-template-columns: 1fr auto; }
      .wiring-chips, .card-actions { display: none; }
      .pipeline-strip { overflow-x: auto; }
      .ps-stage { min-width: 80px; }
      .perf-meta { display: none; }
    }
  </style>
</head>
<body>

<header class="header">
  <div class="header-beam" aria-hidden="true"></div>
  <span class="logo">SFDY &nbsp;<span style="color:rgba(255,255,255,.25);font-weight:400">·</span>&nbsp; WebsiteMocker</span>
  <div class="header-sep" aria-hidden="true"></div>
  <button id="apply-btn" class="btn apply-trigger" style="display:none" title="Pending triage — click to get the apply command">
    Apply<span id="apply-count-badge">0</span>
  </button>
  <span class="header-meta">
    <span id="active-count">{activeSites.length}</span>&nbsp;active &nbsp;·&nbsp; built {buildDate}
  </span>
</header>

<main class="main">

  <!-- Pipeline strip (counts all sites) -->
  <div class="pipeline-strip">
    {STAGES.map(st => {
      const count = sites.filter(s => (s.stage ?? 0) === st.n).length;
      return (
        <div class="ps-stage">
          <div class="ps-num" style={`color:${st.color}`}>{st.n}</div>
          <div class="ps-label">{st.label}</div>
          {count > 0 && <div class="ps-count" style={`color:${st.color}`}>{count}</div>}
        </div>
      );
    })}
  </div>

  <!-- ── Staging: all cards rendered here, JS distributes them ─── -->
  <!-- This is display:none — JS moves each card to its section    -->
  <div id="card-staging" style="display:none">
    {allSitesStaged.map(site => {
      const st         = stageMeta(site.stage);
      const chips      = wiringSummary(site);
      const sandboxUrl = `https://pbau3r-sfdy.github.io/WebsiteMocker/${site._slug}`;
      const perf       = site._perf;
      const pm         = perf?.latest?.mobile;
      const pp         = perf?.prev?.mobile;
      const trend      = pm && pp ? trendLabel(pm.performance, pp.performance) : null;
      const isArchived = site._section === 'archived';
      const isTemplate = site._section === 'template';

      return (
        <div class="site-card" data-slug={site._slug} data-section={site._section}>
          <div class="card-main">
            <div>
              <div class="site-name">{site.name || site.site || site._slug}</div>
              <div class="site-url">{sandboxUrl}</div>
              {site.domain && <div class="site-url" style="color:var(--muted)">{site.domain}</div>}
            </div>
            <span class="stage-badge" style={`color:${st.color};background:${st.bg}`}>
              <span class="badge-dot" style={`background:${st.color}`}></span>
              {st.label}
            </span>
            <div class="wiring-chips">
              {isTemplate && <span class="chip template-chip">template</span>}
              {chips.map(c => (
                <span class={`chip ${c.endsWith('✓') ? 'ok' : ''}`}>{c}</span>
              ))}
            </div>
            <div class="card-actions">
              <a href={sandboxUrl} target="_blank" rel="noopener" class="btn">Preview ↗</a>
              {(site.stage ?? 0) === 6 && site.domain && (
                <a href={`https://${site.domain}`} target="_blank" rel="noopener" class="btn live">Live ↗</a>
              )}
              {!isArchived && (site.stage ?? 0) < 6  && <span class="btn primary">Wire</span>}
              {!isArchived && (site.stage ?? 0) >= 5 && (site.stage ?? 0) < 6 && <span class="btn primary">Deploy</span>}
              <button class="btn rename-btn"  data-rename-slug={site._slug}>Rename</button>
              <button class="btn"           data-archive-slug={site._slug} style={isArchived ? 'display:none' : ''}>Archive</button>
              <button class="btn restore"   data-restore-slug={site._slug} style={isArchived ? '' : 'display:none'}>Restore</button>
              <button class="btn delete-btn" data-delete-slug={site._slug} style={isArchived ? '' : 'display:none'}>Delete</button>
            </div>
          </div>

          {/* Perf row — shown for active sites; templates skip the "run perf" nudge */}
          {pm ? (
            <div class="card-perf">
              <div class="perf-scores">
                {[
                  { label: 'PERF', val: pm.performance },
                  { label: 'A11Y', val: pm.accessibility },
                  { label: 'SEO',  val: pm.seo },
                  { label: 'BEST', val: pm.best_practices },
                ].map(({ label, val }) => (
                  <div class="perf-score">
                    <span class="perf-score-label">{label}</span>
                    <span class="perf-score-value" style={`color:${scoreColor(val)}`}>{val}</span>
                  </div>
                ))}
              </div>
              <div class="perf-sep"></div>
              <div class="perf-cwv">
                {pm.lcp && (
                  <div class="perf-cwv-item">
                    <span class="perf-cwv-label">LCP</span>
                    <span style={`color:${cwvColor(pm.lcp_status)}`}>{pm.lcp}</span>
                  </div>
                )}
                {pm.cls && (
                  <div class="perf-cwv-item">
                    <span class="perf-cwv-label">CLS</span>
                    <span style={`color:${cwvColor(pm.cls_status)}`}>{pm.cls}</span>
                  </div>
                )}
                {pm.fcp && (
                  <div class="perf-cwv-item">
                    <span class="perf-cwv-label">FCP</span>
                    <span style="color:var(--muted)">{pm.fcp}</span>
                  </div>
                )}
              </div>
              {trend && (
                <>
                  <div class="perf-sep"></div>
                  <span class="perf-trend" style={`color:${trend.color}`}>{trend.text}</span>
                </>
              )}
              <div class="perf-meta">mobile · {perf.latest.date}</div>
            </div>
          ) : !isTemplate && (
            <div class="perf-empty">
              no perf data — run <strong>npm run perf</strong>
            </div>
          )}
        </div>
      );
    })}
  </div>

  <!-- ── Active sites ─────────────────────────────────────────────── -->
  <div>
    <div class="section-head">
      <h2>Sites</h2>
      <span class="count" id="active-count-sub">{activeSites.length} active</span>
    </div>
    <div id="main-list">
      {/* populated by JS from #card-staging */}
    </div>
  </div>

  <!-- ── Templates ───────────────────────────────────────────────── -->
  <div id="template-section" class="section-drawer" style="display:none">
    <button class="section-toggle" id="template-toggle">
      <span class="section-chevron">▶</span>
      Templates
      <span class="section-badge" id="template-count">{templateSites.length}</span>
    </button>
    <div class="section-body" id="template-body">
      <p class="section-hint">
        Design captures kept as remix references — not tracked for performance.<br/>
        Use <code>Archive</code> to retire one, or <code>node _scripts/delete-site.mjs &lt;slug&gt;</code> to remove it entirely.
      </p>
      <div id="template-list">
        {/* populated by JS */}
      </div>
    </div>
  </div>

  <!-- ── Archive ──────────────────────────────────────────────────── -->
  <div id="archive-section" class="section-drawer" style="display:none">
    <button class="section-toggle" id="archive-toggle">
      <span class="section-chevron">▶</span>
      Archive
      <span class="section-badge" id="archive-count">0</span>
    </button>
    <div class="section-body" id="archive-body">
      <p class="section-hint">
        Retired sites. Browser triage only until committed:<br/>
        <code>node _scripts/archive-site.mjs &lt;slug&gt; "reason"</code><br/>
        To permanently delete source files:
        <code>node _scripts/delete-site.mjs &lt;slug&gt;</code>
      </p>
      <div id="archive-list">
        {/* populated by JS */}
      </div>
    </div>
  </div>

</main>

<div class="wm-toast" id="wm-toast"></div>

<!-- Rename overlay -->
<div class="apply-overlay" id="rename-overlay">
  <div class="apply-panel">
    <h3>✏️ Rename site</h3>
    <p style="margin:.25rem 0 .75rem;color:var(--dim);font-size:.85rem">
      Enter a new slug for <strong id="rename-old-label"></strong>.<br/>
      This renames the directory, updates wiring.json and astro.config.mjs, and commits.
    </p>
    <div style="display:flex;gap:.5rem;align-items:center;margin-bottom:.75rem">
      <code style="white-space:nowrap">node _scripts/rename-site.mjs</code>
      <code id="rename-old-slug" style="white-space:nowrap"></code>
      <input id="rename-new-input" type="text" placeholder="new-slug"
        style="flex:1;background:var(--surface);border:1px solid var(--dim);color:var(--text);
               padding:.35rem .6rem;border-radius:4px;font-family:monospace;font-size:.9rem"/>
    </div>
    <code class="apply-cmd-block" id="rename-cmd" style="word-break:break-all"></code>
    <p class="apply-hint" style="margin-top:.5rem">
      Copy the command above and run it in your terminal, then push.
    </p>
    <div class="apply-actions">
      <button class="btn" id="rename-close">Close</button>
      <button class="btn primary" id="rename-copy">Copy command</button>
    </div>
  </div>
</div>

<!-- Apply-changes overlay -->
<div class="apply-overlay" id="apply-overlay">
  <div class="apply-panel">
    <h3>↯ Pending triage changes</h3>
    <div class="apply-changes-list" id="apply-changes-list"></div>
    <code class="apply-cmd-block" id="apply-cmd"></code>
    <p class="apply-hint">
      Copy the command above, paste it into your terminal, then:<br/>
      <code>git add -A &amp;&amp; git commit -m "chore: apply dashboard triage"</code><br/>
      <code>git push</code> &nbsp;→&nbsp; sandbox rebuilds automatically.
    </p>
    <div class="apply-actions">
      <button class="btn" id="apply-close">Close</button>
      <button class="btn primary" id="apply-copy">Copy command</button>
    </div>
  </div>
</div>

<script>
(function () {
  const ARCHIVED_KEY = 'wm-archived-v1';
  const ORIGINS_KEY  = 'wm-origins-v1';
  const DELETED_KEY  = 'wm-deleted-v1';
  const REASONS_KEY  = 'wm-reasons-v1';

  // ── Storage: localStorage → sessionStorage fallback ───────────────────────
  const _ls = (function () {
    for (const s of [localStorage, sessionStorage]) {
      try { s.setItem('_wm_chk', '1'); s.removeItem('_wm_chk'); return s; } catch {}
    }
    console.warn('[WM] No persistent storage — triage state resets on reload.');
    return null;
  })();
  function getSet(k)     { try { return new Set(JSON.parse(_ls?.getItem(k) ?? '[]')); } catch { return new Set(); } }
  function saveSet(k, s) { try { _ls?.setItem(k, JSON.stringify([...s])); } catch (e) { console.warn('[WM] saveSet:', e); } }
  function getObj(k)     { try { return JSON.parse(_ls?.getItem(k) ?? '{}'); } catch { return {}; } }
  function saveObj(k, o) { try { _ls?.setItem(k, JSON.stringify(o)); } catch (e) { console.warn('[WM] saveObj:', e); } }

  const archived = getSet(ARCHIVED_KEY);
  const deleted  = getSet(DELETED_KEY);
  const origins  = getObj(ORIGINS_KEY);

  // ── 1. Distribute staged cards ─────────────────────────────────
  try {
    document.querySelectorAll('#card-staging .site-card').forEach(card => {
      const slug    = card.dataset.slug;
      const section = card.dataset.section; // 'active' | 'template' | 'archived'

      if (deleted.has(slug)) { card.remove(); return; }

      let targetId;
      if (archived.has(slug) || section === 'archived') {
        targetId = 'archive-list';
        if (!archived.has(slug)) archived.add(slug);
        // Only track origin for browser-archived cards (not already committed)
        if (!origins[slug] && section !== 'archived') {
          origins[slug] = section === 'template' ? 'template-list' : 'main-list';
        }
        setCardButtons(card, 'archived');
      } else if (section === 'template') {
        targetId = 'template-list';
      } else {
        targetId = 'main-list';
      }

      document.getElementById(targetId)?.appendChild(card);
    });
  } catch (err) {
    console.error('[WM] Card distribution error — falling back to main list:', err);
    document.querySelectorAll('#card-staging .site-card').forEach(card => {
      document.getElementById('main-list')?.appendChild(card);
    });
  }

  saveSet(ARCHIVED_KEY, archived);
  saveObj(ORIGINS_KEY, origins);

  // ── 2. Initial UI state ────────────────────────────────────────
  updateSections();
  updateApplyBtn();

  if (document.querySelectorAll('#archive-list .site-card').length > 0) {
    document.getElementById('archive-section')?.classList.add('open');
  }

  // ── 3. Section toggles ─────────────────────────────────────────
  ['template-toggle', 'archive-toggle'].forEach(id => {
    document.getElementById(id)?.addEventListener('click', () => {
      document.getElementById(id.replace('-toggle', '-section'))?.classList.toggle('open');
    });
  });

  // ── 4. Card action buttons ─────────────────────────────────────
  document.addEventListener('click', e => {
    const a = e.target.closest('[data-archive-slug]');
    const r = e.target.closest('[data-restore-slug]');
    const d = e.target.closest('[data-delete-slug]');
    if (a) archiveSite(a.dataset.archiveSlug);
    if (r) restoreSite(r.dataset.restoreSlug);
    if (d) deleteSite(d.dataset.deleteSlug);
  });

  // ── 5. Apply-changes panel ─────────────────────────────────────
  document.getElementById('apply-btn')?.addEventListener('click', () => {
    updateApplyBtn(); // refresh before showing
    document.getElementById('apply-overlay')?.classList.add('open');
  });
  document.getElementById('apply-close')?.addEventListener('click', () => {
    document.getElementById('apply-overlay')?.classList.remove('open');
  });
  document.getElementById('apply-overlay')?.addEventListener('click', e => {
    if (e.target === e.currentTarget) e.currentTarget.classList.remove('open');
  });
  document.getElementById('apply-copy')?.addEventListener('click', () => {
    const cmd = document.getElementById('apply-cmd')?.textContent ?? '';
    navigator.clipboard?.writeText(cmd)
      .then(() => toast('Command copied to clipboard!'))
      .catch(() => toast('Select and copy the command manually'));
  });

  // ── Helpers ───────────────────────────────────────────────────
  function archiveSite(slug) {
    const card = document.querySelector(`.site-card[data-slug="${slug}"]`);
    if (!card) return;
    // Record original section for restore
    const o = getObj(ORIGINS_KEY);
    o[slug] = card.closest('#template-list') ? 'template-list' : 'main-list';
    saveObj(ORIGINS_KEY, o);
    // Ask for reason (feeds the apply command)
    const reason = (prompt(`Archive "${slug}"\nReason (optional — press Enter to skip):`) ?? '').trim();
    const rs = getObj(REASONS_KEY); rs[slug] = reason; saveObj(REASONS_KEY, rs);
    // Move card
    document.getElementById('archive-list')?.appendChild(card);
    setCardButtons(card, 'archived');
    const a = getSet(ARCHIVED_KEY); a.add(slug); saveSet(ARCHIVED_KEY, a);
    document.getElementById('archive-section')?.classList.add('open');
    updateSections();
    updateApplyBtn();
    toast(`${slug} archived — click Apply to commit`);
  }

  function restoreSite(slug) {
    const card = document.querySelector(`.site-card[data-slug="${slug}"]`);
    if (!card) return;
    const o = getObj(ORIGINS_KEY);
    const targetId = o[slug] || 'main-list';
    document.getElementById(targetId)?.appendChild(card);
    setCardButtons(card, 'active');
    const a = getSet(ARCHIVED_KEY); a.delete(slug); saveSet(ARCHIVED_KEY, a);
    delete o[slug]; saveObj(ORIGINS_KEY, o);
    const rs = getObj(REASONS_KEY); delete rs[slug]; saveObj(REASONS_KEY, rs);
    updateSections();
    updateApplyBtn();
    toast(`${slug} restored`);
  }

  function deleteSite(slug) {
    if (!confirm(
      `Mark "${slug}" for deletion?\n\n` +
      `Click "Apply changes" in the header to get the terminal command\n` +
      `that permanently removes the source files.`
    )) return;
    const card = document.querySelector(`.site-card[data-slug="${slug}"]`);
    if (card) card.remove();
    const a = getSet(ARCHIVED_KEY); a.delete(slug); saveSet(ARCHIVED_KEY, a);
    const d = getSet(DELETED_KEY);  d.add(slug);    saveSet(DELETED_KEY, d);
    const o = getObj(ORIGINS_KEY);  delete o[slug]; saveObj(ORIGINS_KEY, o);
    const rs = getObj(REASONS_KEY); delete rs[slug]; saveObj(REASONS_KEY, rs);
    updateSections();
    updateApplyBtn();
    toast(`${slug} queued for deletion — click Apply`);
  }

  function setCardButtons(card, state) {
    const isArchived = state === 'archived';
    card.querySelector('[data-archive-slug]')?.style.setProperty('display', isArchived ? 'none' : '');
    card.querySelector('[data-restore-slug]')?.style.setProperty('display', isArchived ? '' : 'none');
    card.querySelector('[data-delete-slug]')?.style.setProperty('display',  isArchived ? '' : 'none');
  }

  function updateSections() {
    const counts = {
      'main-list':     ['active-count', 'active-count-sub'],
      'template-list': ['template-count'],
      'archive-list':  ['archive-count'],
    };
    const sections = {
      'template-list': 'template-section',
      'archive-list':  'archive-section',
    };
    Object.entries(counts).forEach(([listId, countIds]) => {
      const n = document.querySelectorAll(`#${listId} .site-card`).length;
      countIds.forEach(id => {
        const el = document.getElementById(id);
        if (el) el.textContent = id.includes('sub') ? `${n} active` : n;
      });
    });
    Object.entries(sections).forEach(([listId, sectionId]) => {
      const n = document.querySelectorAll(`#${listId} .site-card`).length;
      const sec = document.getElementById(sectionId);
      if (sec) sec.style.display = n > 0 ? '' : 'none';
    });
  }

  function updateApplyBtn() {
    // Pending archives: slugs in origins map (browser-archived, not yet committed)
    const reasons = getObj(REASONS_KEY);
    const pendingArchive = Object.keys(getObj(ORIGINS_KEY))
      .map(slug => ({ slug, reason: reasons[slug] || '' }));
    const pendingDelete = [...getSet(DELETED_KEY)];
    const total = pendingArchive.length + pendingDelete.length;

    // Header button
    const btn = document.getElementById('apply-btn');
    if (btn) btn.style.display = total > 0 ? '' : 'none';
    const badge = document.getElementById('apply-count-badge');
    if (badge) badge.textContent = total;

    // Command
    const parts = ['node _scripts/apply-triage.mjs'];
    pendingArchive.forEach(({ slug, reason }) => {
      parts.push(reason ? `--archive ${slug} "${reason}"` : `--archive ${slug}`);
    });
    pendingDelete.forEach(slug => parts.push(`--delete ${slug}`));
    const cmd = parts.join(' \\\n  ');

    const cmdEl = document.getElementById('apply-cmd');
    if (cmdEl) cmdEl.textContent = cmd;

    // Change list
    const listEl = document.getElementById('apply-changes-list');
    if (listEl) {
      const lines = [
        ...pendingArchive.map(({ slug, reason }) =>
          `⊘ Archive <strong>${slug}</strong>${reason ? ` <span style="color:var(--dim)">— ${reason}</span>` : ''}`),
        ...pendingDelete.map(slug =>
          `✗ Delete&nbsp;&nbsp;<strong>${slug}</strong>`),
      ];
      listEl.innerHTML = lines.length
        ? lines.map(l => `<div>${l}</div>`).join('')
        : '<div style="color:var(--dim)">No pending changes.</div>';
    }
  }

  function toast(msg) {
    const el = document.getElementById('wm-toast');
    if (!el) return;
    el.textContent = msg;
    el.classList.add('show');
    clearTimeout(el._t);
    el._t = setTimeout(() => el.classList.remove('show'), 2800);
  }
  // ── Rename ──────────────────────────────────────────────────────────────────
  document.querySelectorAll('[data-rename-slug]').forEach(btn => {
    btn.addEventListener('click', () => {
      const slug = btn.dataset.renameSlug;
      document.getElementById('rename-old-label').textContent = slug;
      document.getElementById('rename-old-slug').textContent  = slug;
      document.getElementById('rename-new-input').value       = slug;
      updateRenameCmd();
      document.getElementById('rename-overlay').classList.add('open');
      setTimeout(() => document.getElementById('rename-new-input').select(), 50);
    });
  });

  function updateRenameCmd() {
    const oldSlug = document.getElementById('rename-old-slug').textContent.trim();
    const newSlug = document.getElementById('rename-new-input').value.trim();
    const cmd = newSlug
      ? `node _scripts/rename-site.mjs ${oldSlug} ${newSlug}`
      : '';
    document.getElementById('rename-cmd').textContent = cmd;
  }

  document.getElementById('rename-new-input')?.addEventListener('input', updateRenameCmd);

  document.getElementById('rename-close')?.addEventListener('click', () => {
    document.getElementById('rename-overlay')?.classList.remove('open');
  });
  document.getElementById('rename-overlay')?.addEventListener('click', e => {
    if (e.target === e.currentTarget)
      document.getElementById('rename-overlay').classList.remove('open');
  });
  document.getElementById('rename-copy')?.addEventListener('click', () => {
    const cmd = document.getElementById('rename-cmd')?.textContent?.trim();
    if (!cmd) return;
    navigator.clipboard?.writeText(cmd).then(() => toast('Command copied'));
  });

})();
</script>

</body>
</html>
