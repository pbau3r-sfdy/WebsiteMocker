{
  "name": "websitemocker",
  "private": true,
  "type": "module",
  "workspaces": [
    "sites/*"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "node _scripts/build-all.js",
    "build:dashboard": "astro build",
    "preview": "astro preview",
    "new-site": "bash _scripts/new-site.sh",
    "perf": "node _scripts/fetch-perf-data.mjs",
    "perf:build": "node _scripts/fetch-perf-data.mjs && npm run build"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "astro": "^5.0.0",
    "hast-util-from-html": "^2.0.0",
    "hast-util-to-html": "^9.0.0",
    "turndown": "^7.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true,
    "sharp@0.34.5": true,
    "fsevents@2.3.3": true
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
